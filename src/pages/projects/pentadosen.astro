---
import Layout from '../../layouts/Layout.astro';
import { portfolioData } from '../../data/portfolioData';
import Reveal from '../../components/ui/CaseStudyReveal.astro';

const project = portfolioData.projects.find((p) => p.id === 'pentadosen')!;

const coreModules = [
  {
    num: '01',
    title: 'Research Grant Tracker',
    tag: 'Research & Funding',
    description:
      'Centralized monitoring for active university research grants. Lecturers can track funding stages, milestone deliverables, reviewer feedback, and progress report submissions in real time.',
  },
  {
    num: '02',
    title: 'Publication Index & Repository',
    tag: 'Journals & Proceedings',
    description:
      'Structured catalog for indexed journal articles (Scopus, SINTA 1–6), international conference proceedings, and book chapters with fast search, citation indicators, and direct DOI links.',
  },
  {
    num: '03',
    title: 'Intellectual Property (HKI) Stepper',
    tag: 'Copyrights & Patents',
    description:
      'End-to-end legal status tracking for copyright (Hak Cipta), patents, and industrial designs. Features a multi-stage stepper guiding applicants from document upload to official certification.',
  },
  {
    num: '04',
    title: 'Academic Activity Timeline',
    tag: 'Faculty Schedule',
    description:
      'A synchronized calendar uniting thesis proposal defense schedules, university accreditation deadlines, reviewer assignments, and semester faculty milestones in one chronological overview.',
  },
];

const technicalChallenges = [
  {
    title: 'Dense Data Presentation on Compact Viewports',
    challenge:
      'Academic records contain extensive metadata (grant numbers, reviewer feedback, indexing tags, co-author lists). Standard desktop tables became cramped and unreadable on tablets and laptops.',
    solution:
      'Built an adaptive layout system that renders sticky-header data tables on wide screens and seamlessly converts into structured, collapsible metadata cards on smaller viewports without losing data fidelity.',
  },
  {
    title: 'Multi-Step Form State & Document Verification',
    challenge:
      'HKI intellectual property applications require multi-stage documentation uploads, legal declarations, and author approvals that often caused data loss if interrupted.',
    solution:
      'Engineered a persistent stepper wizard with resilient state management and client-side draft caching, ensuring lecturers can upload large PDF attachments and navigate back and forth without losing input.',
  },
  {
    title: 'Sub-50ms Client Search & Multi-Facet Filtering',
    challenge:
      'Querying hundreds of lecturer publications, journal classifications, and grant statuses created unnecessary API overhead and sluggish UI feedback.',
    solution:
      'Implemented debounced client-side filtering combined with indexed search tokens, providing instant sub-50ms search results across titles, years, index tiers, and co-authors without redundant network hits.',
  },
];

const takeaways = [
  {
    title: 'Enterprise Information Architecture',
    text: 'Designing for dense academic data demands disciplined hierarchy, calm color palettes, and clear typographic boundaries to avoid cognitive fatigue.',
  },
  {
    title: 'Component Reusability & Contracts',
    text: 'Standardizing shared table rows, status pills, and modal dialogs with strict TypeScript interfaces cut redundant code and streamlined API hookups.',
  },
  {
    title: 'User-Centric Academic Empathy',
    text: 'Testing workflows with lecturers revealed friction points in document submission, prompting self-explanatory stepper statuses and contextual help badges.',
  },
];
---

<Layout
  title="PentaDosen Case Study — Muhammad Syafi'ul Umam"
  description="Case study on PentaDosen: A research and academic performance management platform for university lecturers built with React, Vite, Tailwind CSS, and TypeScript."
  showPreloader={false}
>
  <article class="mx-auto max-w-5xl px-4 pb-24 pt-24 sm:px-6 md:pb-32 md:pt-32 lg:px-8">
    
    <!-- Top Breadcrumb Navigation -->
    <Reveal delay={0}>
      <nav aria-label="Breadcrumb" class="mb-8">
        <a
          href="/#projects"
          data-astro-preload
          class="inline-flex items-center gap-2 rounded-lg py-1.5 font-mono text-xs text-[#2F4166] transition-colors hover:text-[#123A86] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6]"
        >
          <span aria-hidden="true" class="text-sm">←</span>
          <span>Back to selected work</span>
        </a>
      </nav>
    </Reveal>

    <!-- Header Section -->
    <Reveal delay={0.05}>
      <header class="border-b border-[#B9D4F5] pb-10">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#B9D4F5] bg-white/80 px-3.5 py-1 text-xs font-mono text-[#123A86] shadow-xs">
          <span class="h-1.5 w-1.5 rounded-full bg-[#1F5FD6]"></span>
          <span>Case Study · {project.category}</span>
        </div>

        <h1 class="mt-4 font-display text-3xl font-semibold leading-[1.08] tracking-[-0.035em] text-[#0E1B3D] sm:text-4xl lg:text-5xl">
          PentaDosen: Lecturer Research & Performance Platform
        </h1>

        <p class="mt-4 max-w-3xl text-base leading-relaxed text-[#24365C] sm:text-lg">
          A centralized web platform empowering university lecturers to monitor research grants, publication milestones, intellectual property (HKI), and academic activity calendars in one seamless workflow.
        </p>

        <!-- Quick Info Metadata Grid -->
        <dl class="mt-8 grid grid-cols-2 gap-4 rounded-2xl border border-[#B9D4F5] bg-white p-5 sm:grid-cols-4 sm:p-6 shadow-[0_4px_20px_rgba(31,95,214,0.06)]">
          <div>
            <dt class="font-mono text-xs uppercase tracking-[0.14em] text-[#2F4166]">Role</dt>
            <dd class="mt-1 font-sans text-sm font-semibold text-[#0E1B3D]">Frontend Developer</dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-[0.14em] text-[#2F4166]">Timeline</dt>
            <dd class="mt-1 font-sans text-sm font-semibold text-[#0E1B3D]">{project.year}</dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-[0.14em] text-[#2F4166]">Stack</dt>
            <dd class="mt-1 font-sans text-sm font-semibold text-[#0E1B3D]">React · TypeScript · Vite · Tailwind</dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-[0.14em] text-[#2F4166]">Ecosystem</dt>
            <dd class="mt-1 font-sans text-sm font-semibold text-[#0E1B3D]">Universitas YARSI</dd>
          </div>
        </dl>

        <!-- External CTAs -->
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href={project.links.live}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-[#1F5FD6] px-5 text-sm font-semibold text-white shadow-xs transition-all hover:bg-[#123A86] hover:shadow-[0_8px_20px_rgba(31,95,214,0.25)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6]"
          >
            <span>Visit live website</span>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <a
            href={project.links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-[#B9D4F5] bg-white px-5 text-sm font-medium text-[#0E1B3D] transition-colors hover:border-[#1F5FD6] hover:bg-[#F2F7FF] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6]"
          >
            <span>GitHub Profile</span>
            <svg class="h-4 w-4 text-[#123A86]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </a>
        </div>
      </header>
    </Reveal>

    <!-- Hero Media Preview -->
    <Reveal delay={0.1} className="mt-10">
      <figure class="overflow-hidden rounded-3xl border border-[#B9D4F5] bg-white p-2 shadow-[0_12px_40px_rgba(31,95,214,0.12)] sm:p-3">
        <div class="overflow-hidden rounded-2xl bg-[#F2F7FF]">
          <img
            src={project.image}
            srcset={`${project.image.replace(/\.webp$/, '-480.webp')} 480w, ${project.image} 1280w`}
            sizes="(min-width: 1024px) 1000px, 100vw"
            alt="PentaDosen lecturer research and academic dashboard interface"
            transition:name="project-image-pentadosen"
            class="h-auto w-full object-cover object-top"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="flex items-center justify-between px-3 py-3 text-xs text-[#2F4166] sm:px-4">
          <span>PentaDosen Dashboard — Research Grants, Publication Pipeline & HKI Workflow</span>
          <span class="hidden font-mono uppercase tracking-wider sm:inline-block">Production UI</span>
        </figcaption>
      </figure>
    </Reveal>

    <!-- Main Content Body -->
    <div class="mt-16 space-y-16 sm:space-y-20">

      <!-- 01 Context & Background -->
      <Reveal delay={0.05}>
        <section class="border-t border-[#B9D4F5] pt-10">
          <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.16em] text-[#123A86]">
            <span>01</span>
            <span class="h-px w-8 bg-[#1F5FD6]/30"></span>
            <span>Context & Overview</span>
          </div>
          <h2 class="mt-4 font-display text-2xl font-semibold tracking-[-0.025em] text-[#0E1B3D] sm:text-3xl">
            Streamlining the Academic Lifecycle for University Lecturers
          </h2>
          <div class="mt-5 space-y-4 text-base leading-relaxed text-[#24365C]">
            <p>
              University lecturers operate across multiple high-stakes academic responsibilities: conducting grant-funded research, submitting peer-reviewed journal papers, filing intellectual property rights (HKI), and coordinating student thesis examinations.
            </p>
            <p>
              Before PentaDosen was developed, these workflows were scattered across disconnected spreadsheets, paper-based forms, and isolated department portals. Lecturers frequently experienced submission delays, unclear approval statuses, and cumbersome manual reporting cycles.
            </p>
            <p>
              PentaDosen was initiated to provide a single, dependable portal where lecturers can manage every phase of their academic output with transparency and speed.
            </p>
          </div>
        </section>
      </Reveal>

      <!-- 02 The Core Challenge -->
      <Reveal delay={0.05}>
        <section class="border-t border-[#B9D4F5] pt-10">
          <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.16em] text-[#123A86]">
            <span>02</span>
            <span class="h-px w-8 bg-[#1F5FD6]/30"></span>
            <span>The Challenge</span>
          </div>
          <h2 class="mt-4 font-display text-2xl font-semibold tracking-[-0.025em] text-[#0E1B3D] sm:text-3xl">
            Taming Complexity in Information-Dense Workflows
          </h2>
          <div class="mt-6 grid gap-5 sm:grid-cols-3">
            <div class="rounded-2xl border border-[#B9D4F5] bg-white p-5 shadow-xs">
              <span class="font-mono text-xs font-semibold text-[#1F5FD6]">CHALLENGE 01</span>
              <h3 class="mt-2 font-display text-base font-semibold text-[#0E1B3D]">Data Fragmentation</h3>
              <p class="mt-2 text-sm leading-relaxed text-[#24365C]">
                Research milestones and publication citations were tracked in separate silos without central cross-referencing.
              </p>
            </div>
            <div class="rounded-2xl border border-[#B9D4F5] bg-white p-5 shadow-xs">
              <span class="font-mono text-xs font-semibold text-[#1F5FD6]">CHALLENGE 02</span>
              <h3 class="mt-2 font-display text-base font-semibold text-[#0E1B3D]">Multi-Step HKI Bureaucracy</h3>
              <p class="mt-2 text-sm leading-relaxed text-[#24365C]">
                Copyright and patent submissions required multiple approval stages from faculty deans to legal reviewers without clear status indicators.
              </p>
            </div>
            <div class="rounded-2xl border border-[#B9D4F5] bg-white p-5 shadow-xs">
              <span class="font-mono text-xs font-semibold text-[#1F5FD6]">CHALLENGE 03</span>
              <h3 class="mt-2 font-display text-base font-semibold text-[#0E1B3D]">Screen Density Fatigue</h3>
              <p class="mt-2 text-sm leading-relaxed text-[#24365C]">
                Large academic data tables caused horizontal scroll fatigue and poor usability on compact laptops and tablet displays.
              </p>
            </div>
          </div>
        </section>
      </Reveal>

      <!-- 03 My Role & Scope -->
      <Reveal delay={0.05}>
        <section class="border-t border-[#B9D4F5] pt-10">
          <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.16em] text-[#123A86]">
            <span>03</span>
            <span class="h-px w-8 bg-[#1F5FD6]/30"></span>
            <span>My Role & Scope</span>
          </div>
          <h2 class="mt-4 font-display text-2xl font-semibold tracking-[-0.025em] text-[#0E1B3D] sm:text-3xl">
            From Figma Blueprints to Production React Engineering
          </h2>
          <p class="mt-4 max-w-3xl text-base leading-relaxed text-[#24365C]">
            As Frontend Developer, I collaborated closely with academic coordinators and UI designers to transform interface wireframes into modular, high-performing web applications.
          </p>

          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div class="flex items-start gap-3.5 rounded-2xl border border-[#B9D4F5] bg-[#F2F7FF] p-4 sm:p-5">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[#1F5FD6] text-xs font-bold text-white">1</span>
              <div>
                <h3 class="text-sm font-semibold text-[#0E1B3D]">Component-Driven UI Craft</h3>
                <p class="mt-1 text-sm text-[#24365C]">
                  Constructed reusable design components with Tailwind CSS: modal dialogs, status badges, multi-step wizards, and responsive tables.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3.5 rounded-2xl border border-[#B9D4F5] bg-[#F2F7FF] p-4 sm:p-5">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[#1F5FD6] text-xs font-bold text-white">2</span>
              <div>
                <h3 class="text-sm font-semibold text-[#0E1B3D]">TypeScript Domain Models</h3>
                <p class="mt-1 text-sm text-[#24365C]">
                  Formulated strict type contracts for grants, publications, and user credentials to eliminate runtime type mismatches.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3.5 rounded-2xl border border-[#B9D4F5] bg-[#F2F7FF] p-4 sm:p-5">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[#1F5FD6] text-xs font-bold text-white">3</span>
              <div>
                <h3 class="text-sm font-semibold text-[#0E1B3D]">REST API Integration & Validation</h3>
                <p class="mt-1 text-sm text-[#24365C]">
                  Hooked asynchronous REST endpoints, handled authentication tokens, file upload streams, and comprehensive error states.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3.5 rounded-2xl border border-[#B9D4F5] bg-[#F2F7FF] p-4 sm:p-5">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[#1F5FD6] text-xs font-bold text-white">4</span>
              <div>
                <h3 class="text-sm font-semibold text-[#0E1B3D]">Accessibility & Cross-Device UX</h3>
                <p class="mt-1 text-sm text-[#24365C]">
                  Enforced WCAG 2.1 AA compliant color contrasts, semantic landmark tags, and full keyboard navigation for all interactive controls.
                </p>
              </div>
            </div>
          </div>
        </section>
      </Reveal>

      <!-- 04 Core Platform Modules -->
      <Reveal delay={0.05}>
        <section class="border-t border-[#B9D4F5] pt-10">
          <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.16em] text-[#123A86]">
            <span>04</span>
            <span class="h-px w-8 bg-[#1F5FD6]/30"></span>
            <span>Core Capabilities</span>
          </div>
          <h2 class="mt-4 font-display text-2xl font-semibold tracking-[-0.025em] text-[#0E1B3D] sm:text-3xl">
            Four Central Modules Powering the Platform
          </h2>

          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            {coreModules.map((module) => (
              <div class="rounded-2xl border border-[#B9D4F5] bg-white p-6 shadow-xs transition-shadow hover:shadow-[0_8px_30px_rgba(31,95,214,0.08)]">
                <div class="flex items-center justify-between">
                  <span class="font-mono text-xs font-medium text-[#1F5FD6]">{module.num}</span>
                  <span class="rounded-md border border-[#B9D4F5] bg-[#F2F7FF] px-2.5 py-0.5 font-mono text-xs text-[#123A86]">
                    {module.tag}
                  </span>
                </div>
                <h3 class="mt-4 font-display text-lg font-semibold text-[#0E1B3D]">{module.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-[#24365C]">{module.description}</p>
              </div>
            ))}
          </div>
        </section>
      </Reveal>

      <!-- 05 Problem Solving & Implementation -->
      <Reveal delay={0.05}>
        <section class="border-t border-[#B9D4F5] pt-10">
          <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.16em] text-[#123A86]">
            <span>05</span>
            <span class="h-px w-8 bg-[#1F5FD6]/30"></span>
            <span>Problem Solving</span>
          </div>
          <h2 class="mt-4 font-display text-2xl font-semibold tracking-[-0.025em] text-[#0E1B3D] sm:text-3xl">
            Technical Challenges & Concrete Solutions
          </h2>

          <div class="mt-8 space-y-6">
            {technicalChallenges.map((item) => (
              <div class="rounded-2xl border border-[#B9D4F5] bg-white p-6 shadow-xs sm:p-7">
                <h3 class="font-display text-lg font-semibold text-[#0E1B3D]">{item.title}</h3>
                <div class="mt-4 grid gap-4 text-sm sm:grid-cols-2">
                  <div class="rounded-xl border border-[#B9D4F5]/60 bg-[#F2F7FF] p-4">
                    <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#2F4166]">The Challenge</span>
                    <p class="mt-1.5 leading-relaxed text-[#24365C]">{item.challenge}</p>
                  </div>
                  <div class="rounded-xl border border-[#1F5FD6]/20 bg-[#DCEBFF]/40 p-4">
                    <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#123A86]">Engineering Solution</span>
                    <p class="mt-1.5 leading-relaxed text-[#0E1B3D]">{item.solution}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      </Reveal>

      <!-- 06 Key Takeaways & Outcome -->
      <Reveal delay={0.05}>
        <section class="border-t border-[#B9D4F5] pt-10">
          <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.16em] text-[#123A86]">
            <span>06</span>
            <span class="h-px w-8 bg-[#1F5FD6]/30"></span>
            <span>Outcome & Key Learnings</span>
          </div>
          <h2 class="mt-4 font-display text-2xl font-semibold tracking-[-0.025em] text-[#0E1B3D] sm:text-3xl">
            Delivering Reliable Impact in Academic Operations
          </h2>

          <div class="mt-6 rounded-2xl border border-[#B9D4F5] bg-[#F2F7FF] p-6 sm:p-8">
            <p class="font-display text-lg font-semibold text-[#0E1B3D]">Measurable Platform Outcome</p>
            <p class="mt-2 text-sm leading-relaxed text-[#24365C] sm:text-base">
              PentaDosen successfully brought academic grant records, journal publication tracking, and HKI verification into one unified web platform. During UAT trials, faculty members reported significantly faster submission turnarounds, zero lost draft uploads, and clearer tracking of their academic performance.
            </p>
          </div>

          <div class="mt-8 grid gap-5 sm:grid-cols-3">
            {takeaways.map((item, idx) => (
              <div class="rounded-2xl border border-[#B9D4F5] bg-white p-5 shadow-xs">
                <span class="font-mono text-xs font-semibold text-[#1F5FD6]">0{idx + 1}</span>
                <h3 class="mt-2 text-sm font-semibold text-[#0E1B3D]">{item.title}</h3>
                <p class="mt-2 text-xs leading-relaxed text-[#24365C]">{item.text}</p>
              </div>
            ))}
          </div>
        </section>
      </Reveal>

    </div>

    <!-- Case Study Footer Action -->
    <Reveal delay={0.05}>
      <footer class="mt-16 flex flex-col gap-4 border-t border-[#B9D4F5] pt-8 sm:flex-row sm:items-center sm:justify-between">
        <a
          href="/#projects"
          data-astro-preload
          class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-[#24365C] transition-colors hover:text-[#123A86] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6]"
        >
          <span aria-hidden="true">←</span>
          <span>Back to all projects</span>
        </a>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href={project.links.live}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-[#B9D4F5] bg-white px-4 text-xs font-semibold text-[#0E1B3D] transition-colors hover:border-[#1F5FD6] hover:bg-[#F2F7FF] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6]"
          >
            <span>Visit live website</span>
            <svg class="h-3.5 w-3.5 text-[#123A86]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

          <a
            href="/#contact"
            class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-[#1F5FD6] px-4 text-xs font-semibold text-white shadow-xs transition-colors hover:bg-[#123A86] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6]"
          >
            <span>Discuss a project with Umam</span>
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </footer>
    </Reveal>

  </article>
</Layout>
