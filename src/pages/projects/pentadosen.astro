---
import Layout from '../../layouts/Layout.astro';
import { portfolioData } from '../../data/portfolioData';

const project = portfolioData.projects.find((p) => p.id === 'pentadosen')!;
---

<Layout
  title="PentaDosen Case Study — Muhammad Syafi'ul Umam"
  description="Case study on PentaDosen: A research and academic performance management platform for university lecturers built with React, Vite, Tailwind CSS, and TypeScript."
>
  <article class="pt-24 pb-20 md:pt-32 md:pb-28 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    
    <!-- Back to Works Navigation -->
    <div class="mb-6 sm:mb-8">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-mono text-[#8e8b82] dark:text-[#a09d96] hover:text-[#cc785c] dark:hover:text-[#cc785c] transition-colors group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#cc785c] rounded p-1"
      >
        <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span>Back to Selected Works</span>
      </a>
    </div>

    <!-- 1. Compact Case Study Header -->
    <header class="pb-8 border-b border-[#e6dfd8] dark:border-[#2e2b26]">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#efe9de] dark:bg-[#1c1b18] text-[#141413] dark:text-[#faf9f5] text-xs font-mono font-medium border border-[#e6dfd8] dark:border-[#2e2b26] mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-[#cc785c]"></span>
        <span>Case Study · {project.category}</span>
      </div>

      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl text-[#141413] dark:text-[#faf9f5] tracking-tight leading-[1.12]">
        PentaDosen: Lecturer Research & Performance Management Platform
      </h1>

      <p class="mt-3 text-base sm:text-lg text-[#3d3d3a] dark:text-[#a09d96] leading-relaxed max-w-[60ch]">
        A centralized web platform for university lecturers to manage research grants, peer-reviewed publications, intellectual property (HKI), and academic schedules.
      </p>

      <!-- Metadata Strip -->
      <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 rounded-xl bg-[#efe9de] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2e2b26] text-xs font-mono">
        <div>
          <span class="text-[#8e8b82] dark:text-[#7a7770] block">ROLE</span>
          <span class="text-[#141413] dark:text-[#faf9f5] font-semibold mt-0.5 block">Frontend Developer</span>
        </div>
        <div>
          <span class="text-[#8e8b82] dark:text-[#7a7770] block">TIMELINE</span>
          <span class="text-[#141413] dark:text-[#faf9f5] font-semibold mt-0.5 block">{project.year}</span>
        </div>
        <div>
          <span class="text-[#8e8b82] dark:text-[#7a7770] block">PRIMARY STACK</span>
          <span class="text-[#141413] dark:text-[#faf9f5] font-semibold mt-0.5 block">React · Vite · Tailwind</span>
        </div>
        <div>
          <span class="text-[#8e8b82] dark:text-[#7a7770] block">CORE MODULES</span>
          <span class="text-[#141413] dark:text-[#faf9f5] font-semibold mt-0.5 block">Research · HKI · Calendar</span>
        </div>
      </div>
    </header>

    <!-- 2. Hero Screenshot with Editorial Frame -->
    <div class="my-8 rounded-2xl overflow-hidden border border-[#e6dfd8] dark:border-[#2e2b26] shadow-lg bg-[#181715] relative group">
      <img
        src={project.image}
        alt="PentaDosen UI Dashboard Screenshot showing Lecturer Research Management"
        class="w-full h-auto object-cover"
        loading="eager"
      />
      <!-- Subtle Floating Feature Callouts -->
      <div class="absolute bottom-3 left-3 hidden sm:flex items-center gap-2">
        <span class="px-2.5 py-1 rounded bg-[#181715]/85 backdrop-blur-md text-white text-[11px] font-mono border border-white/10">
          ✦ Research Performance
        </span>
        <span class="px-2.5 py-1 rounded bg-[#181715]/85 backdrop-blur-md text-white text-[11px] font-mono border border-white/10">
          ✦ HKI & Publications
        </span>
        <span class="px-2.5 py-1 rounded bg-[#181715]/85 backdrop-blur-md text-white text-[11px] font-mono border border-white/10">
          ✦ Academic Calendar
        </span>
      </div>
    </div>

    <!-- Case Study Dynamic Visual Rhythm Body -->
    <div class="space-y-10 text-[#3d3d3a] dark:text-[#d4cfc7] text-sm sm:text-base leading-relaxed">
      
      <!-- 01 — Overview (Plain Editorial Layout) -->
      <section>
        <div class="flex items-center gap-2 text-xs font-mono text-[#cc785c] mb-1 uppercase tracking-wider">
          <span>01</span>
          <span>//</span>
          <span>Overview</span>
        </div>
        <h2 class="font-display text-2xl sm:text-3xl text-[#141413] dark:text-[#faf9f5] tracking-tight mb-3">
          Executive Summary
        </h2>
        <p>
          PentaDosen is a research and academic performance management platform designed for university lecturers. It consolidates research grant tracking, publication archives, intellectual property (HKI) registrations, and academic milestone calendars into a unified workspace.
        </p>
        <p class="mt-2.5 text-[#141413] dark:text-[#faf9f5] font-medium">
          My primary focus was translating complex academic requirements into a clear, responsive, and reusable frontend experience with React, TypeScript, and Tailwind CSS.
        </p>
      </section>

      <!-- 02 — The Problem (Highlighted Beige Box) -->
      <section class="p-6 sm:p-7 rounded-xl bg-[#efe9de] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2e2b26]">
        <div class="flex items-center gap-2 text-xs font-mono text-[#cc785c] mb-1 uppercase tracking-wider">
          <span>02</span>
          <span>//</span>
          <span>The Problem</span>
        </div>
        <h2 class="font-display text-2xl text-[#141413] dark:text-[#faf9f5] tracking-tight mb-4">
          Core Friction Points
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs sm:text-sm">
          <div class="p-3.5 rounded-lg bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <span class="text-[#cc785c] font-mono text-xs font-bold block mb-1">01</span>
            <strong class="text-[#141413] dark:text-[#faf9f5] block mb-1">Scattered Documentation</strong>
            <p class="text-[#6c6a64] dark:text-[#a09d96]">Research outputs, publication proofs, and HKI records were distributed across separate spreadsheets and folders.</p>
          </div>

          <div class="p-3.5 rounded-lg bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <span class="text-[#cc785c] font-mono text-xs font-bold block mb-1">02</span>
            <strong class="text-[#141413] dark:text-[#faf9f5] block mb-1">Limited Status Visibility</strong>
            <p class="text-[#6c6a64] dark:text-[#a09d96]">Lecturers lacked immediate visibility into review stages, approval statuses, and grant disbursements.</p>
          </div>

          <div class="p-3.5 rounded-lg bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <span class="text-[#cc785c] font-mono text-xs font-bold block mb-1">03</span>
            <strong class="text-[#141413] dark:text-[#faf9f5] block mb-1">Disconnected Schedules</strong>
            <p class="text-[#6c6a64] dark:text-[#a09d96]">Grant submission deadlines and defense dates were difficult to track without a shared academic calendar.</p>
          </div>
        </div>
      </section>

      <!-- 03 — My Role & Scope (4 Compact Cards) -->
      <section>
        <div class="flex items-center gap-2 text-xs font-mono text-[#cc785c] mb-1 uppercase tracking-wider">
          <span>03</span>
          <span>//</span>
          <span>My Role & Scope</span>
        </div>
        <h2 class="font-display text-2xl sm:text-3xl text-[#141413] dark:text-[#faf9f5] tracking-tight mb-4">
          Frontend Engineering & UI Craft
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 text-xs sm:text-sm">
          <div class="p-4 rounded-xl bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <span class="text-xs font-mono font-medium text-[#cc785c] block mb-1">UI / UX IMPLEMENTATION</span>
            <p class="text-[#3d3d3a] dark:text-[#d4cfc7]">Translated Figma wireframes into responsive web layouts with consistent typography scales and spacing.</p>
          </div>

          <div class="p-4 rounded-xl bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <span class="text-xs font-mono font-medium text-[#5db8a6] block mb-1">FRONTEND ARCHITECTURE</span>
            <p class="text-[#3d3d3a] dark:text-[#d4cfc7]">Built modular, reusable React components with TypeScript and Vite for fast bundling and clean boundaries.</p>
          </div>

          <div class="p-4 rounded-xl bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <span class="text-xs font-mono font-medium text-[#e8a55a] block mb-1">REST API INTEGRATION</span>
            <p class="text-[#3d3d3a] dark:text-[#d4cfc7]">Connected user interfaces with backend REST endpoints for research records, publications, and HKI data.</p>
          </div>

          <div class="p-4 rounded-xl bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <span class="text-xs font-mono font-medium text-[#5db872] block mb-1">FORM VALIDATION & UX</span>
            <p class="text-[#3d3d3a] dark:text-[#d4cfc7]">Implemented accessible form validation, modal drawers, feedback states, and responsive table views.</p>
          </div>
        </div>
      </section>

      <!-- 04 — Design & UX Process (Plain Section + 3 Numbered Principles) -->
      <section>
        <div class="flex items-center gap-2 text-xs font-mono text-[#cc785c] mb-1 uppercase tracking-wider">
          <span>04</span>
          <span>//</span>
          <span>Design Approach</span>
        </div>
        <h2 class="font-display text-2xl sm:text-3xl text-[#141413] dark:text-[#faf9f5] tracking-tight mb-4">
          Three Interaction Principles
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs sm:text-sm">
          <div class="p-4 rounded-xl bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <span class="text-xs font-mono text-[#cc785c] font-bold block mb-1.5">01 · DISCLOSURE</span>
            <strong class="text-[#141413] dark:text-[#faf9f5] block mb-1">Progressive Disclosure</strong>
            <p class="text-[#6c6a64] dark:text-[#a09d96]">Show essential academic metrics first, keeping detailed grant data and reviewer notes accessible in drawers.</p>
          </div>

          <div class="p-4 rounded-xl bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <span class="text-xs font-mono text-[#cc785c] font-bold block mb-1.5">02 · SCANNABILITY</span>
            <strong class="text-[#141413] dark:text-[#faf9f5] block mb-1">Scannable Status</strong>
            <p class="text-[#6c6a64] dark:text-[#a09d96]">Use color-coded status indicators so lecturers can immediately understand submission progress at a glance.</p>
          </div>

          <div class="p-4 rounded-xl bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <span class="text-xs font-mono text-[#cc785c] font-bold block mb-1.5">03 · ADAPTABILITY</span>
            <strong class="text-[#141413] dark:text-[#faf9f5] block mb-1">Responsive Data</strong>
            <p class="text-[#6c6a64] dark:text-[#a09d96]">Adapt dense multi-column tabular data into readable card stacks across mobile and tablet viewports.</p>
          </div>
        </div>
      </section>

      <!-- 05 — Technical Implementation (Minimal Technical List) -->
      <section>
        <div class="flex items-center gap-2 text-xs font-mono text-[#cc785c] mb-1 uppercase tracking-wider">
          <span>05</span>
          <span>//</span>
          <span>Architecture</span>
        </div>
        <h2 class="font-display text-2xl sm:text-3xl text-[#141413] dark:text-[#faf9f5] tracking-tight mb-4">
          How It Was Built
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 text-xs sm:text-sm">
          <div class="p-3.5 rounded-lg border-l-2 border-[#cc785c] bg-[#efe9de]/50 dark:bg-[#1c1b18] pl-4">
            <strong class="text-[#141413] dark:text-[#faf9f5] block font-mono text-xs uppercase mb-0.5">Component System</strong>
            <span class="text-[#6c6a64] dark:text-[#a09d96]">Reusable React components kept dashboard cards, modals, and data interfaces consistent.</span>
          </div>

          <div class="p-3.5 rounded-lg border-l-2 border-[#5db8a6] bg-[#efe9de]/50 dark:bg-[#1c1b18] pl-4">
            <strong class="text-[#141413] dark:text-[#faf9f5] block font-mono text-xs uppercase mb-0.5">Styling System</strong>
            <span class="text-[#6c6a64] dark:text-[#a09d96]">Tailwind CSS provided a structured design token system with zero runtime CSS overhead.</span>
          </div>

          <div class="p-3.5 rounded-lg border-l-2 border-[#e8a55a] bg-[#efe9de]/50 dark:bg-[#1c1b18] pl-4">
            <strong class="text-[#141413] dark:text-[#faf9f5] block font-mono text-xs uppercase mb-0.5">Type Safety</strong>
            <span class="text-[#6c6a64] dark:text-[#a09d96]">TypeScript interfaces modeled research, publication, and user states, reducing runtime errors.</span>
          </div>

          <div class="p-3.5 rounded-lg border-l-2 border-[#5db872] bg-[#efe9de]/50 dark:bg-[#1c1b18] pl-4">
            <strong class="text-[#141413] dark:text-[#faf9f5] block font-mono text-xs uppercase mb-0.5">API Layer</strong>
            <span class="text-[#6c6a64] dark:text-[#a09d96]">REST endpoints were integrated through centralized service handlers with loading and error states.</span>
          </div>
        </div>
      </section>

      <!-- 06 — Key Features (4 Concise Feature Cards) -->
      <section>
        <div class="flex items-center gap-2 text-xs font-mono text-[#cc785c] mb-1 uppercase tracking-wider">
          <span>06</span>
          <span>//</span>
          <span>Core Capabilities</span>
        </div>
        <h2 class="font-display text-2xl sm:text-3xl text-[#141413] dark:text-[#faf9f5] tracking-tight mb-4">
          Key Features
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 text-xs sm:text-sm">
          <div class="p-4 rounded-xl bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <h3 class="font-semibold text-[#141413] dark:text-[#faf9f5] mb-1">📊 Executive Research Overview</h3>
            <p class="text-[#6c6a64] dark:text-[#a09d96]">Interactive summaries of active grants, publication totals, and research achievements.</p>
          </div>

          <div class="p-4 rounded-xl bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <h3 class="font-semibold text-[#141413] dark:text-[#faf9f5] mb-1">📑 Publication Tracker</h3>
            <p class="text-[#6c6a64] dark:text-[#a09d96]">Categorized listings for indexed journals, conference proceedings, and book chapters.</p>
          </div>

          <div class="p-4 rounded-xl bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <h3 class="font-semibold text-[#141413] dark:text-[#faf9f5] mb-1">🛡️ HKI & Patent Management</h3>
            <p class="text-[#6c6a64] dark:text-[#a09d96]">End-to-end status tracking for Copyrights, Patents, and Industrial Designs.</p>
          </div>

          <div class="p-4 rounded-xl bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <h3 class="font-semibold text-[#141413] dark:text-[#faf9f5] mb-1">📅 Faculty Academic Calendar</h3>
            <p class="text-[#6c6a64] dark:text-[#a09d96]">Integrated timeline for grant submission deadlines, defenses, and faculty workshops.</p>
          </div>
        </div>
      </section>

      <!-- 07 — Challenges & Solutions (Highlighted Beige Container) -->
      <section class="p-6 sm:p-7 rounded-xl bg-[#efe9de] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2e2b26]">
        <div class="flex items-center gap-2 text-xs font-mono text-[#cc785c] mb-1 uppercase tracking-wider">
          <span>07</span>
          <span>//</span>
          <span>Problem Solving</span>
        </div>
        <h2 class="font-display text-2xl text-[#141413] dark:text-[#faf9f5] tracking-tight mb-4">
          Challenges & Solutions
        </h2>
        <div class="space-y-3.5 text-xs sm:text-sm">
          <div class="p-4 rounded-lg bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <span class="text-xs font-mono text-[#cc785c] font-bold block mb-1">CHALLENGE 01 · DENSE ACADEMIC DATA</span>
            <p class="text-[#6c6a64] dark:text-[#a09d96] mb-1.5">Multi-column tables created layout overflow on small screens.</p>
            <p class="text-[#141413] dark:text-[#faf9f5] font-medium"><strong class="text-[#5db872]">Solution:</strong> Designed adaptive card and table layouts that preserve important metadata while remaining readable on mobile viewports.</p>
          </div>

          <div class="p-4 rounded-lg bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <span class="text-xs font-mono text-[#cc785c] font-bold block mb-1">CHALLENGE 02 · COMPLEX MULTI-STEP WORKFLOWS</span>
            <p class="text-[#6c6a64] dark:text-[#a09d96] mb-1.5">HKI applications require multiple stages between lecturers and faculty reviewers.</p>
            <p class="text-[#141413] dark:text-[#faf9f5] font-medium"><strong class="text-[#5db872]">Solution:</strong> Used reusable stepper and clear badge patterns to make submission progress intuitive to understand.</p>
          </div>
        </div>
      </section>

      <!-- 08 — Outcome & Key Learnings (Plain Editorial Closing) -->
      <section class="pb-2">
        <div class="flex items-center gap-2 text-xs font-mono text-[#cc785c] mb-1 uppercase tracking-wider">
          <span>08</span>
          <span>//</span>
          <span>Outcome & Key Learnings</span>
        </div>
        <h2 class="font-display text-2xl sm:text-3xl text-[#141413] dark:text-[#faf9f5] tracking-tight mb-3">
          Results & Takeaways
        </h2>
        
        <p class="text-base text-[#141413] dark:text-[#faf9f5] font-medium leading-relaxed mb-4">
          PentaDosen brings research, publication, HKI, and academic activity workflows into a unified interface designed for lecturers.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs sm:text-sm font-mono">
          <div class="flex items-start gap-2 p-3 rounded-lg bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <span class="text-[#cc785c] mt-0.5">✦</span>
            <span class="font-sans text-[#3d3d3a] dark:text-[#d4cfc7]">Designing interfaces for information-dense workflows.</span>
          </div>
          <div class="flex items-start gap-2 p-3 rounded-lg bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <span class="text-[#cc785c] mt-0.5">✦</span>
            <span class="font-sans text-[#3d3d3a] dark:text-[#d4cfc7]">Building reusable React component patterns.</span>
          </div>
          <div class="flex items-start gap-2 p-3 rounded-lg bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <span class="text-[#cc785c] mt-0.5">✦</span>
            <span class="font-sans text-[#3d3d3a] dark:text-[#d4cfc7]">Integrating asynchronous REST API workflows.</span>
          </div>
          <div class="flex items-start gap-2 p-3 rounded-lg bg-[#faf9f5] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]">
            <span class="text-[#cc785c] mt-0.5">✦</span>
            <span class="font-sans text-[#3d3d3a] dark:text-[#d4cfc7]">Translating complex academic requirements into simpler interactions.</span>
          </div>
        </div>
      </section>

    </div>

    <!-- Case Study Footer Action -->
    <div class="mt-12 pt-8 border-t border-[#e6dfd8] dark:border-[#2e2b26] flex flex-col sm:flex-row items-center justify-between gap-4">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-md bg-[#faf9f5] dark:bg-[#1c1b18] hover:bg-[#efe9de] dark:hover:bg-[#252320] text-[#141413] dark:text-[#faf9f5] border border-[#e6dfd8] dark:border-[#2e2b26] text-xs font-medium transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#cc785c]"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span>Back to All Projects</span>
      </a>

      <a
        href="/#contact"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-md bg-[#cc785c] hover:bg-[#a9583e] text-white text-xs font-medium transition-all shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-[#cc785c]"
      >
        <span>Discuss a Project with Umam</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>

  </article>
</Layout>
