---
import SEO from '../components/SEO.astro';
import Preloader from '../components/Preloader.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { AmbientGradient } from '../components/ui/AmbientGradient';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  showPreloader?: boolean;
}

const { title, description, showPreloader = true } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-[#EAF3FF]">
  <head>
    <SEO title={title} description={description} />
    <ClientRouter />
    <noscript>
      <style>
        #preloader { display: none !important; }
        astro-island [style*="opacity:0"] { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
    
    <!-- Preconnect & Google Fonts (Plus Jakarta Sans + Inter + JetBrains Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#EAF3FF] text-[#24365C] antialiased selection:bg-[#B3D9FF] selection:text-[#0E1B3D] min-h-[100dvh] flex flex-col justify-between">
    <!-- Site-wide animated gradient (Three.js, Zephyr light sky) -->
    <!-- Persist across View Transitions so the background never flashes -->
    <div aria-hidden="true" transition:persist="site-bg" class="pointer-events-none fixed inset-0 z-0 overflow-hidden bg-[#EAF3FF]">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(255,255,255,0.65),transparent_60%),radial-gradient(ellipse_at_85%_20%,rgba(179,217,255,0.35),transparent_60%),radial-gradient(ellipse_at_10%_85%,rgba(128,179,255,0.25),transparent_60%)]"></div>
      <AmbientGradient client:idle />
    </div>
    <!-- Smooth Editorial Preloader (Shown only once per session) -->
    <Preloader forceHide={!showPreloader} />

    <!-- Accessibility Skip to Main Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-[#1F5FD6] focus:text-white focus:rounded-md focus:font-mono focus:text-xs focus:shadow-lg"
    >
      Skip to main content
    </a>

    <!-- Top Navigation -->
    <Navbar />

    <!-- Main Content Area -->
    <main id="main-content" class="relative z-10 flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <div class="relative z-10">
      <Footer />
    </div>

    <!-- Client-side Script: Lenis Smooth Scroll + GSAP ScrollTrigger -->
    <!-- Re-initialised on every View Transition via astro:page-load -->
    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Single RAF driver for the whole session — initSmooth only swaps
      // which Lenis instance it pumps, so page swaps never stack tickers.
      if (!(window as unknown as { __lenisTickerRegistered?: boolean }).__lenisTickerRegistered) {
        (window as unknown as { __lenisTickerRegistered?: boolean }).__lenisTickerRegistered = true;
        gsap.ticker.add((time: number) => {
          (window as unknown as { __lenis?: Lenis }).__lenis?.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(500, 33);
      }

      // The preloader is persisted across View Transitions and must stay
      // hidden once seen — back-nav from a case study must never replay it.
      function forceHidePreloader() {
        try {
          if (sessionStorage.getItem('visited_preloader') === 'true') {
            document.getElementById('preloader')?.style.setProperty('display', 'none');
          }
        } catch {}
      }

      function teardownSmooth() {
        // Kill triggers AND their tweens first — a tween killed mid-flight
        // otherwise leaves `opacity: 0` inline and the section looks "hilang".
        ScrollTrigger.getAll().forEach((t) => t.kill());
        gsap.killTweensOf('.hero-reveal, .project-card, .bento-card, .experience-card');
        gsap.set('.hero-reveal, .project-card, .bento-card, .experience-card', { clearProps: 'all' });
        const prevLenis = (window as unknown as { __lenis?: Lenis }).__lenis;
        try {
          prevLenis?.destroy();
        } catch {}
        (window as unknown as { __lenis?: Lenis }).__lenis = undefined;
      }

      function initSmooth() {
        forceHidePreloader();

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        teardownSmooth();
        if (prefersReducedMotion) return;

        const lenis = new Lenis({
          duration: 1.1,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
        });
        (window as unknown as { __lenis?: Lenis }).__lenis = lenis;

        lenis.on('scroll', ScrollTrigger.update);

        // If we landed on a case-study page, start at the very top.
        if (window.location.pathname.startsWith('/projects/')) {
          window.scrollTo(0, 0);
          lenis.scrollTo(0, { immediate: true });
        }

        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
          if ((anchor as HTMLAnchorElement & { __smoothBound?: boolean }).__smoothBound) return;
          (anchor as HTMLAnchorElement & { __smoothBound?: boolean }).__smoothBound = true;
          anchor.addEventListener('click', (e) => {
            const href = anchor.getAttribute('href');
            if (href && href !== '#') {
              const target = document.querySelector(href);
              if (target instanceof HTMLElement) {
                e.preventDefault();
                (window as unknown as { __lenis?: Lenis }).__lenis?.scrollTo(target, { offset: -70 });
              }
            }
          });
        });

        // Deep-link restore (incl. back-nav to `/#projects`): re-assert the
        // hash target once layout is settled and the preloader is gone,
        // then refresh triggers so nothing stays stuck at opacity 0.
        const restoreHashTarget = () => {
          const hash = window.location.hash;
          if (!hash || hash === '#') {
            ScrollTrigger.refresh();
            return;
          }
          const target = document.getElementById(hash.slice(1));
          if (!(target instanceof HTMLElement)) {
            ScrollTrigger.refresh();
            return;
          }
          history.scrollRestoration = 'manual';
          const jump = () => {
            const el = document.getElementById(hash.slice(1));
            if (el instanceof HTMLElement) {
              lenis.scrollTo(el, { offset: -70, immediate: true });
            }
            requestAnimationFrame(() => ScrollTrigger.refresh());
          };
          const preloader = document.getElementById('preloader');
          const preloaderHidden = () =>
            !preloader || getComputedStyle(preloader).display === 'none';
          const settle = () => requestAnimationFrame(() => requestAnimationFrame(jump));
          if (preloaderHidden()) {
            settle();
          } else {
            const started = Date.now();
            const timer = window.setInterval(() => {
              if (preloaderHidden() || Date.now() - started > 5000) {
                window.clearInterval(timer);
                settle();
              }
            }, 120);
          }
        };

        // GSAP Scroll Animations (home page only — detail pages animate via Motion).
        // Guarded per selector so a missing section never breaks the rest.
        if (document.querySelector('.hero-reveal')) {
          gsap.from('.hero-reveal', {
            opacity: 0,
            y: 24,
            duration: 0.8,
            stagger: 0.1,
            ease: 'power2.out',
            delay: 0.1,
            overwrite: 'auto',
            clearProps: 'opacity,transform',
          });
        }

        gsap.utils.toArray<HTMLElement>('.project-card').forEach((card) => {
          gsap.from(card, {
            scrollTrigger: {
              trigger: card,
              start: 'top 88%',
              toggleActions: 'play none none none',
            },
            opacity: 0,
            y: 28,
            duration: 0.7,
            ease: 'power2.out',
            overwrite: 'auto',
            clearProps: 'opacity,transform',
          });
        });

        gsap.utils.toArray<HTMLElement>('.bento-card').forEach((card, i) => {
          gsap.from(card, {
            scrollTrigger: {
              trigger: card,
              start: 'top 88%',
              toggleActions: 'play none none none',
            },
            opacity: 0,
            y: 24,
            duration: 0.6,
            delay: (i % 2) * 0.08,
            ease: 'power2.out',
            overwrite: 'auto',
            clearProps: 'opacity,transform',
          });
        });

        gsap.utils.toArray<HTMLElement>('.experience-card').forEach((card) => {
          gsap.from(card, {
            scrollTrigger: {
              trigger: card,
              start: 'top 88%',
              toggleActions: 'play none none none',
            },
            opacity: 0,
            y: 20,
            duration: 0.6,
            ease: 'power2.out',
            overwrite: 'auto',
            clearProps: 'opacity,transform',
          });
        });

        restoreHashTarget();
      }

      initSmooth();
      // Astro View Transitions: re-run after every client-side page swap.
      document.addEventListener('astro:page-load', initSmooth);
      document.addEventListener('astro:after-swap', () => {
        if (window.location.pathname.startsWith('/projects/')) {
          window.scrollTo(0, 0);
        }
        forceHidePreloader();
      });
    </script>
  </body>
</html>
