---
interface Props {
  className?: string;
  delay?: number;
}

const { className = '', delay = 0 } = Astro.props;
---

<div class:list={['case-reveal', className]} style={`--reveal-delay: ${delay}s`}>
  <slot />
</div>

<style>
  .case-reveal {
    opacity: 1;
    animation: case-reveal-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: var(--reveal-delay, 0s);
  }

  @keyframes case-reveal-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-reveal {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
