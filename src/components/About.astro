---
import { portfolioData } from '../data/portfolioData';

const { about, personal } = portfolioData;
---

<section id="about" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <!-- Section Header -->
  <div class="pb-8 border-b border-zinc-200 dark:border-white/10">
    <div class="flex items-center gap-2 mb-2">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-500 animate-pulse"></span>
      <span class="text-xs font-mono font-medium text-sky-600 dark:text-sky-400 uppercase tracking-wider">
        About Me
      </span>
    </div>
    <h2 class="font-display text-3xl sm:text-4xl text-zinc-950 dark:text-white font-bold tracking-tight">
      Discover the person behind the code.
    </h2>
    <p class="mt-2 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-[58ch]">
      Turning ideas into useful, intuitive, and secure digital solutions with a blend of engineering discipline and visual craft.
    </p>
  </div>

  <div class="mt-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    
    <!-- Left Column: Authentic Personal Narrative (col-span-12 lg:col-span-6) -->
    <div class="lg:col-span-6 space-y-4 text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
      <p>
        Hi! I'm <strong class="text-zinc-950 dark:text-white">{personal.name}</strong>, a fresh graduate who genuinely enjoys turning ideas into useful, purposeful digital solutions.
      </p>

      <p>
        My core interests center on <strong class="text-zinc-950 dark:text-white font-semibold">Software Development</strong>, <strong class="text-zinc-950 dark:text-white font-semibold">UI/UX Design</strong>, and <strong class="text-zinc-950 dark:text-white font-semibold">Cyber Security</strong>. I also enjoy graphic design and digital content creation, which equips me to build products that are functionally dependable, secure, and visually engaging.
      </p>

      <p>
        I am always eager to learn new paradigms, explore emerging technologies, take on new challenges, and continue growing while creating digital products that are simple, accessible, enjoyable to use, and make a real impact.
      </p>

      <!-- Key Focus Highlight Strip -->
      <div class="pt-4 grid grid-cols-2 gap-3 font-mono text-xs">
        <div class="p-3.5 rounded-xl bg-zinc-50 dark:bg-[#121316] border border-zinc-200 dark:border-white/10">
          <span class="text-xs text-zinc-500 dark:text-zinc-400 uppercase tracking-wider block font-semibold">Primary Focus</span>
          <span class="text-zinc-950 dark:text-white font-semibold mt-1 block">Software Dev & UI/UX</span>
          <span class="text-xs text-zinc-600 dark:text-zinc-400 block mt-0.5">React · TypeScript · Figma</span>
        </div>
        <div class="p-3.5 rounded-xl bg-zinc-50 dark:bg-[#121316] border border-zinc-200 dark:border-white/10">
          <span class="text-xs text-zinc-500 dark:text-zinc-400 uppercase tracking-wider block font-semibold">Security Mindset</span>
          <span class="text-zinc-950 dark:text-white font-semibold mt-1 block">Cyber Security</span>
          <span class="text-xs text-zinc-600 dark:text-zinc-400 block mt-0.5">Defensive & Secure Coding</span>
        </div>
      </div>
    </div>

    <!-- Right Column: 3 Core Pillars (col-span-12 lg:col-span-6) -->
    <div class="lg:col-span-6 flex flex-col gap-4">
      {about.values.map((val, idx) => (
        <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-[#121316] border border-zinc-200 dark:border-white/10 hover:border-[#0284c7] dark:hover:border-[#38bdf8] shadow-xs dark:shadow-md transition-all group">
          <div class="flex items-center justify-between pb-2 mb-2 border-b border-zinc-100 dark:border-white/5">
            <h3 class="font-display text-lg text-zinc-950 dark:text-white font-semibold tracking-tight">
              {val.title}
            </h3>
            <span class="text-xs font-mono font-bold text-[#0284c7] dark:text-[#38bdf8]">0{idx + 1}</span>
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            {val.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
