---
import { portfolioData } from '../data/portfolioData';
import { AboutVisualShowcase } from './ui/AboutVisualShowcase';

const { personal } = portfolioData;
---

<section id="about" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
    
    <!-- Left Column: Storytelling & Headline (lg:col-span-6) -->
    <div class="lg:col-span-6 flex flex-col items-start">
      
      <!-- Pill Badge -->
      <div class="inline-flex items-center px-3.5 py-1 rounded-full border border-zinc-300 dark:border-white/15 bg-zinc-100 dark:bg-white/5 text-zinc-700 dark:text-zinc-300 text-xs font-mono font-medium tracking-wide uppercase mb-6 shadow-2xs">
        About Me
      </div>

      <!-- Editorial Headline matching screenshot -->
      <h2 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-zinc-950 dark:text-white leading-[1.08]">
        Discover the person <br />
        <span class="italic font-light text-zinc-400 dark:text-zinc-500">behind the code.</span>
      </h2>

      <!-- Personal Narrative matching reference cadence & style -->
      <div class="mt-6 sm:mt-8 space-y-4 text-sm sm:text-base md:text-[17px] text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-xl">
        <p>
          Hi! I'm <strong class="text-zinc-950 dark:text-white font-semibold">{personal.name}</strong>, a fresh graduate in <strong class="text-zinc-950 dark:text-white font-semibold">Information Technology</strong> who genuinely enjoys turning ideas into useful digital solutions.
        </p>

        <p>
          My interests include <strong class="text-zinc-950 dark:text-white font-semibold">Software Development</strong>, <strong class="text-zinc-950 dark:text-white font-semibold">UI/UX Design</strong>, and <strong class="text-zinc-950 dark:text-white font-semibold">Cyber Security</strong>. I also enjoy graphic design and digital content creation, which help me build products that are both functional and visually engaging.
        </p>

        <p>
          I'm always eager to learn new things, explore new technologies, take on new challenges, and continue growing while creating digital products that are simple, functional, enjoyable to use, and make a real impact.
        </p>
      </div>

      <!-- Quick Contact / Location Indicator -->
      <div class="mt-6 flex flex-wrap items-center gap-4 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Based in Jakarta, Indonesia (UTC+7)</span>
        </div>
        <span>·</span>
        <a
          href={`mailto:${personal.email}`}
          class="text-[#0284c7] dark:text-[#38bdf8] hover:underline"
        >
          {personal.email}
        </a>
      </div>

    </div>

    <!-- Right Column: GitHub Contributions Heatmap & Fanned Social Deck (lg:col-span-6) -->
    <div class="lg:col-span-6 w-full flex justify-center">
      <AboutVisualShowcase client:visible />
    </div>

  </div>
</section>
