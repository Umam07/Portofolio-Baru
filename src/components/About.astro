---
import { portfolioData } from '../data/portfolioData';
import { AboutVisualShowcase } from './ui/AboutVisualShowcase';

const { personal } = portfolioData;
---

<section id="about" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
    
    <!-- Left Column: Storytelling & Headline (lg:col-span-6) -->
    <div class="lg:col-span-6 flex flex-col items-start">
      
      <!-- Pill Badge -->
      <div class="inline-flex items-center px-3.5 py-1 rounded-full border border-zinc-300 dark:border-white/15 bg-zinc-100 dark:bg-white/5 text-zinc-700 dark:text-zinc-300 text-xs font-mono font-medium tracking-wide uppercase mb-6 shadow-2xs">
        About Me
      </div>

      <!-- Editorial Headline -->
      <h2 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-zinc-950 dark:text-white leading-[1.08]">
        Bridging clean logic <br />
        <span class="italic font-light text-zinc-400 dark:text-zinc-500">with intuitive craft.</span>
      </h2>

      <!-- Personal Narrative grounded in actual background -->
      <div class="mt-6 sm:mt-8 space-y-4 text-sm sm:text-base md:text-[17px] text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-xl">
        <p>
          I'm <strong class="text-zinc-950 dark:text-white font-semibold">{personal.name}</strong>, an <strong class="text-zinc-950 dark:text-white font-semibold">Information Technology graduate</strong> from Universitas YARSI. I operate at the intersection of frontend engineering, enterprise workflows, and user interface craft.
        </p>

        <p>
          Rather than treating frontend as mere presentation, I view it as the vital layer where systems become accessible. My experience spans building modular web applications like <a href="/projects/pentadosen" class="text-sky-600 dark:text-sky-400 font-medium underline underline-offset-4 decoration-sky-500/30 hover:decoration-sky-500">PentaDosen</a> with React & TypeScript, to analyzing enterprise business blueprints and conducting UAT for <strong class="text-zinc-950 dark:text-white font-medium">Odoo ERP</strong> at C-Tech.
        </p>

        <p>
          I strive for digital solutions that are structurally sound, secure by design, and delightfully effortless to navigate.
        </p>
      </div>


    </div>

    <!-- Right Column: GitHub Contributions Heatmap & Fanned Social Deck (lg:col-span-6) -->
    <div class="lg:col-span-6 w-full flex justify-center">
      <AboutVisualShowcase client:visible />
    </div>

  </div>
</section>
