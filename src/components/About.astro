---
import { portfolioData } from '../data/portfolioData';

const { about, personal } = portfolioData;
---

<section id="about" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <!-- Section Header -->
  <div class="pb-8 border-b border-zinc-200 dark:border-white/10">
    <h2 class="font-display text-3xl sm:text-4xl text-zinc-950 dark:text-white font-bold tracking-tight">
      Background & Engineering Philosophy
    </h2>
    <p class="mt-2 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-[58ch]">
      Bridging Figma prototypes and production web applications with structured frontend architecture and business workflow understanding.
    </p>
  </div>

  <div class="mt-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    
    <!-- Left Column: Authentic Personal Narrative (col-span-6) -->
    <div class="lg:col-span-6 space-y-4 text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
      <p>
        I am <strong class="text-zinc-950 dark:text-white">{personal.name}</strong> (known as <strong class="text-[#0284c7] dark:text-[#38bdf8]">{personal.preferredName}</strong>), an Information Technology student at <strong class="text-zinc-950 dark:text-white">Universitas YARSI</strong> in Jakarta specializing in frontend development and UI/UX design.
      </p>

      <p>
        I focus on translating design systems, token architectures, and component libraries into fast, accessible, and responsive user interfaces using <strong class="text-zinc-950 dark:text-white">React, TypeScript, and Tailwind CSS</strong>.
      </p>

      <p>
        During my internship as a <strong class="text-zinc-950 dark:text-white">Functional ERP Intern at C-Tech ERP Indonesia</strong>, I gained hands-on experience in business process mapping, user acceptance testing (UAT), and enterprise software documentation — enabling me to approach frontend engineering with deep user empathy and domain clarity.
      </p>

      <!-- Authentic Metadata Block -->
      <div class="pt-4 grid grid-cols-2 gap-3 font-mono text-xs">
        <div class="p-3.5 rounded-lg bg-zinc-50 dark:bg-[#121316] border border-zinc-200 dark:border-white/10">
          <span class="text-xs text-zinc-500 uppercase tracking-wider block font-semibold">Education</span>
          <span class="text-zinc-950 dark:text-white font-semibold mt-1 block">Universitas YARSI</span>
          <span class="text-xs text-zinc-600 dark:text-zinc-400 block mt-0.5">Information Technology</span>
        </div>
        <div class="p-3.5 rounded-lg bg-zinc-50 dark:bg-[#121316] border border-zinc-200 dark:border-white/10">
          <span class="text-xs text-zinc-500 uppercase tracking-wider block font-semibold">Work Experience</span>
          <span class="text-zinc-950 dark:text-white font-semibold mt-1 block">C-Tech ERP</span>
          <span class="text-xs text-zinc-600 dark:text-zinc-400 block mt-0.5">Functional ERP Intern</span>
        </div>
      </div>
    </div>

    <!-- Right Column: 3 Core Engineering Principles (col-span-6) -->
    <div class="lg:col-span-6 flex flex-col gap-4">
      {about.values.map((val, idx) => (
        <div class="p-5 sm:p-6 rounded-xl bg-white dark:bg-[#121316] border border-zinc-200 dark:border-white/10 hover:border-[#0284c7] dark:hover:border-[#38bdf8] shadow-xs dark:shadow-md transition-all">
          <div class="flex items-center justify-between pb-2 mb-2 border-b border-zinc-100 dark:border-white/5">
            <h3 class="font-display text-lg text-zinc-950 dark:text-white font-semibold tracking-tight">
              {val.title}
            </h3>
            <span class="text-xs font-mono font-bold text-[#0284c7] dark:text-[#38bdf8]">0{idx + 1}</span>
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            {val.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
