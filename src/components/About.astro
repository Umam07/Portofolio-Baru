---
import { portfolioData } from '../data/portfolioData';
import { AboutVisualShowcase } from './ui/AboutVisualShowcase';

const { personal } = portfolioData;

// Build-time scrape of the public contribution graph. Network failures or
// rate limits must never break the build — the card renders a fallback.
let githubCalendarSource = '';
try {
  const githubCalendarResponse = await fetch('https://github.com/users/Umam07/contributions', {
    signal: AbortSignal.timeout(8000),
  });
  if (githubCalendarResponse.ok) {
    githubCalendarSource = (await githubCalendarResponse.text()).match(/<table[\s\S]*?<\/table>/)?.[0] ?? '';
  }
} catch {
  githubCalendarSource = '';
}
let calendarColumnIndex = 0;
const githubCalendarHtml = githubCalendarSource
  .replace(/<td[^>]*data-ix="(\d+)"[\s\S]*?<\/td>/g, (cell, index) => {
    calendarColumnIndex = Number(index);
    return calendarColumnIndex >= 27 ? cell : '';
  })
  .replace(/<td class="ContributionCalendar-label"[\s\S]*?<\/td>/g, (() => {
    let labelIndex = 0;
    return (label: string) => (labelIndex++ >= 7 ? label : '');
  })());
---

<section id="about" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28 lg:px-8">
  <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-5">
      <p class="mb-5 font-mono text-xs font-medium uppercase tracking-[0.18em] text-[#123A86]">
        About me
      </p>
      <h2 class="font-display text-4xl font-semibold leading-[1.06] tracking-[-0.035em] text-[#0E1B3D] sm:text-5xl">
        Building with structure, then refining the details.
      </h2>

      <div class="mt-7 space-y-4 text-sm leading-relaxed text-[#24365C] sm:text-base">
        <p>
          I’m <strong class="font-semibold text-[#0E1B3D]">{personal.name}</strong>, an Information Technology graduate from Universitas YARSI. My work combines frontend implementation with practical understanding of business systems.
        </p>

        <p>
          I have built responsive interfaces with React and TypeScript, contributed to <a href="/projects/pentadosen/" class="font-medium text-[#123A86] underline decoration-[#123A86]/40 underline-offset-4 hover:text-[#0E1B3D]">PentaDosen</a>, and supported Odoo ERP analysis and User Acceptance Testing at C-Tech ERP Indonesia.
        </p>
      </div>

      <div class="mt-8 max-w-lg border-t border-[#B9D4F5] pt-5">
        <p class="text-xs font-medium uppercase tracking-[0.14em] text-[#2F4166]">Current focus</p>
        <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm text-[#24365C]">
          <span>Frontend development</span>
          <span>ERP workflows</span>
          <span>UI structure</span>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7">
      <AboutVisualShowcase client:visible calendarMarkup={githubCalendarHtml} />
    </div>
  </div>
</section>

<style is:global>
  .github-calendar {
    color: #2F4166;
  }

  .github-calendar table {
    width: max-content;
    min-width: 0;
    table-layout: auto;
    border-collapse: separate;
    border-spacing: 5px;
  }

  .github-calendar > div {
    width: max-content;
    max-width: 100%;
    margin-inline: auto;
  }

  .github-calendar td[data-level] {
    box-sizing: border-box;
    width: 15px !important;
    min-width: 15px;
    max-width: 15px;
    height: 15px !important;
    min-height: 15px;
    max-height: 15px;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 3px;
    vertical-align: middle;
  }

  .github-calendar td[data-level='0'] { background: #dcebff; }
  .github-calendar td[data-level='1'] { background: #b3d9ff; }
  .github-calendar td[data-level='2'] { background: #80b3ff; }
  .github-calendar td[data-level='3'] { background: #3d7be0; }
  .github-calendar td[data-level='4'] { background: #1f5fd6; }

  .github-calendar .ContributionCalendar-label,
  .github-calendar .ContributionCalendar-legend {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
  }

  .github-calendar .ContributionCalendar-legend {
    display: none;
  }

  @media (max-width: 640px) {
    .github-calendar > div {
      margin-inline: 0;
    }

    .github-calendar table {
      border-spacing: 4px;
    }

    .github-calendar td[data-level] {
      width: 12px !important;
      min-width: 12px;
      max-width: 12px;
      height: 12px !important;
      min-height: 12px;
      max-height: 12px;
    }
  }
</style>
