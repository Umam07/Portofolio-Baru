---
import { portfolioData } from '../data/portfolioData';

const { skills } = portfolioData;
---

<section id="skills" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <!-- Section Header -->
  <div class="pb-8 border-b border-[#e6dfd8] dark:border-[#2e2b26]">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#efe9de] dark:bg-[#1c1b18] text-[#141413] dark:text-[#faf9f5] text-xs font-mono font-medium border border-[#e6dfd8] dark:border-[#2e2b26] mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-[#cc785c]"></span>
      <span>TECHNICAL MATRIX</span>
    </div>
    <h2 class="font-display text-3xl sm:text-4xl text-[#141413] dark:text-[#faf9f5] tracking-tight">
      Technical Skills & Stack
    </h2>
    <p class="mt-2 text-sm sm:text-base text-[#6c6a64] dark:text-[#a09d96] max-w-[54ch]">
      Technologies and tools I use to design, develop, and document functional digital products.
    </p>
  </div>

  <!-- Bento Grid -->
  <div class="mt-10 grid grid-cols-1 md:grid-cols-12 gap-6">
    
    <!-- Bento Tile 1: Frontend Development (Cream Card, col-span-7) -->
    <div class="bento-card md:col-span-7 p-6 sm:p-8 rounded-xl bg-[#efe9de] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2e2b26] flex flex-col justify-between hover:border-[#cc785c] dark:hover:border-[#cc785c] transition-colors">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-[#e6dfd8] dark:border-[#2e2b26]">
          <span class="text-xs font-mono font-medium text-[#cc785c]">CORE SPECIALIZATION</span>
          <span class="text-xs font-mono text-[#8e8b82] dark:text-[#7a7770]">FRONTEND ARCHITECTURE</span>
        </div>

        <h3 class="mt-4 font-display text-2xl text-[#141413] dark:text-[#faf9f5] tracking-tight">
          Frontend Engineering & Web Development
        </h3>
        <p class="mt-2 text-sm text-[#3d3d3a] dark:text-[#a09d96] leading-relaxed">
          Building responsive, accessible single-page applications and web interfaces using React, Vite, TypeScript, and modern semantic HTML5 and Tailwind CSS.
        </p>
      </div>

      <div class="mt-6 pt-4 border-t border-[#e6dfd8] dark:border-[#2e2b26] flex flex-wrap gap-1.5">
        {skills.frontend.map((item) => (
          <span class="px-2.5 py-0.5 rounded-md bg-[#faf9f5] dark:bg-[#252320] text-xs font-mono text-[#3d3d3a] dark:text-[#d4cfc7] border border-[#e6dfd8] dark:border-[#2e2b26]">
            {item}
          </span>
        ))}
      </div>
    </div>

    <!-- Bento Tile 2: UI/UX & Design Systems (Dark Card, col-span-5) -->
    <div class="bento-card md:col-span-5 p-6 sm:p-8 rounded-xl bg-[#181715] text-[#faf9f5] border border-[#252320] flex flex-col justify-between hover:border-[#cc785c] transition-colors">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-[#252320]">
          <span class="text-xs font-mono font-medium text-[#5db8a6]">INTERFACE CRAFT</span>
          <span class="text-xs font-mono text-[#a09d96]">FIGMA</span>
        </div>

        <h3 class="mt-4 font-display text-2xl text-[#faf9f5] tracking-tight">
          UI/UX & Design Implementation
        </h3>
        <p class="mt-2 text-sm text-[#a09d96] leading-relaxed">
          Translating wireframes, user journeys, and component tokens into clean, intuitive, and responsive layouts with high attention to spacing and hierarchy.
        </p>
      </div>

      <div class="mt-6 pt-4 border-t border-[#252320] flex flex-wrap gap-1.5">
        {skills.design.map((item) => (
          <span class="px-2.5 py-0.5 rounded-md bg-[#252320] text-xs font-mono text-[#e6dfd8] border border-[#3d3d3a]">
            {item}
          </span>
        ))}
      </div>
    </div>

    <!-- Bento Tile 3: Backend & Database (Dark Card, col-span-5) -->
    <div class="bento-card md:col-span-5 p-6 sm:p-8 rounded-xl bg-[#181715] text-[#faf9f5] border border-[#252320] flex flex-col justify-between hover:border-[#cc785c] transition-colors">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-[#252320]">
          <span class="text-xs font-mono font-medium text-[#e8a55a]">SERVER & DATA</span>
          <span class="text-xs font-mono text-[#a09d96]">REST APIS</span>
        </div>

        <h3 class="mt-4 font-display text-2xl text-[#faf9f5] tracking-tight">
          Backend & Databases
        </h3>
        <p class="mt-2 text-sm text-[#a09d96] leading-relaxed">
          Integrating RESTful endpoints, managing structured datasets in MySQL and TiDB, and connecting backend services with Laravel and Node.js.
        </p>
      </div>

      <div class="mt-6 pt-4 border-t border-[#252320] flex flex-wrap gap-1.5">
        {[...skills.backend, ...skills.database].map((item) => (
          <span class="px-2.5 py-0.5 rounded-md bg-[#252320] text-xs font-mono text-[#e6dfd8] border border-[#3d3d3a]">
            {item}
          </span>
        ))}
      </div>
    </div>

    <!-- Bento Tile 4: Tools, ERP Workflows & Documentation (Cream Card, col-span-7) -->
    <div class="bento-card md:col-span-7 p-6 sm:p-8 rounded-xl bg-[#efe9de] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2e2b26] flex flex-col justify-between hover:border-[#cc785c] dark:hover:border-[#cc785c] transition-colors">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-[#e6dfd8] dark:border-[#2e2b26]">
          <span class="text-xs font-mono font-medium text-[#5db872]">WORKFLOWS & TESTING</span>
          <span class="text-xs font-mono text-[#8e8b82] dark:text-[#7a7770]">ERP & GIT</span>
        </div>

        <h3 class="mt-4 font-display text-2xl text-[#141413] dark:text-[#faf9f5] tracking-tight">
          Tools, System Workflows & Documentation
        </h3>
        <p class="mt-2 text-sm text-[#3d3d3a] dark:text-[#a09d96] leading-relaxed">
          Version control via Git/GitHub, hands-on enterprise Odoo ERP workflow analysis, functional blueprint preparation, and comprehensive User Acceptance Testing (UAT).
        </p>
      </div>

      <div class="mt-6 pt-4 border-t border-[#e6dfd8] dark:border-[#2e2b26] flex flex-wrap gap-1.5">
        {skills.tools.map((item) => (
          <span class="px-2.5 py-0.5 rounded-md bg-[#faf9f5] dark:bg-[#252320] text-xs font-mono text-[#3d3d3a] dark:text-[#d4cfc7] border border-[#e6dfd8] dark:border-[#2e2b26]">
            {item}
          </span>
        ))}
      </div>
    </div>

  </div>
</section>
