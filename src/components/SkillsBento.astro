---
import { portfolioData } from '../data/portfolioData';

const { skills } = portfolioData;
---

<section id="skills" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <!-- Section Header -->
  <div class="pb-8 border-b border-[#e6dfd8]">
    <h2 class="font-display text-3xl sm:text-4xl text-[#141413] tracking-tight">
      Capabilities & Engineering Philosophy
    </h2>
    <p class="mt-2 text-sm sm:text-base text-[#6c6a64] max-w-[54ch]">
      Bridging high-fidelity Figma design tokens with production-grade frontend architecture.
    </p>
  </div>

  <!-- Bento Grid -->
  <div class="mt-10 grid grid-cols-1 md:grid-cols-12 gap-6">
    
    <!-- Bento Tile 1: UI/UX & Design Tokens (Cream Card, col-span-7) -->
    <div class="bento-card md:col-span-7 p-6 sm:p-8 rounded-xl bg-[#efe9de] border border-[#e6dfd8] flex flex-col justify-between hover:border-[#cc785c] transition-colors">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-[#e6dfd8]">
          <span class="text-xs font-mono font-medium text-[#cc785c]">FIGMA TOKEN PIPELINE</span>
          <span class="text-xs font-mono text-[#8e8b82]">ZERO DRIFT</span>
        </div>

        <h3 class="mt-4 font-display text-2xl text-[#141413] tracking-tight">
          Design Systems & Token Architecture
        </h3>
        <p class="mt-2 text-sm text-[#3d3d3a] leading-relaxed">
          Crafting tokenized component libraries in Figma with auto-layout variables that export cleanly to Tailwind CSS and production React/Astro codebases.
        </p>

        <!-- Interactive Color Tokens Preview Strip -->
        <div class="mt-4 p-3 rounded-lg bg-[#faf9f5] border border-[#e6dfd8] flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-4 h-4 rounded-full bg-[#cc785c] border border-black/10" title="Coral Primary"></span>
            <span class="w-4 h-4 rounded-full bg-[#181715] border border-black/10" title="Dark Navy"></span>
            <span class="w-4 h-4 rounded-full bg-[#faf9f5] border border-black/10" title="Cream Canvas"></span>
            <span class="w-4 h-4 rounded-full bg-[#5db8a6] border border-black/10" title="Accent Teal"></span>
          </div>
          <span class="text-[11px] font-mono text-[#6c6a64]">Figma Variables · Auto-Synced</span>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-[#e6dfd8] flex flex-wrap gap-1.5">
        {skills.design.map((item) => (
          <span class="px-2.5 py-0.5 rounded-md bg-[#faf9f5] text-xs font-mono text-[#3d3d3a] border border-[#e6dfd8]">
            {item}
          </span>
        ))}
      </div>
    </div>

    <!-- Bento Tile 2: Dark Navy Surface for Code & Frontend (col-span-5) -->
    <div class="bento-card md:col-span-5 p-6 sm:p-8 rounded-xl bg-[#181715] text-[#faf9f5] border border-[#252320] flex flex-col justify-between hover:border-[#cc785c] transition-colors">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-[#252320]">
          <span class="text-xs font-mono font-medium text-[#5db8a6]">WEB ARCHITECTURE</span>
          <span class="text-xs font-mono text-[#a09d96]">ISLANDS</span>
        </div>

        <h3 class="mt-4 font-display text-2xl text-[#faf9f5] tracking-tight">
          Modern Frontend Engineering
        </h3>
        <p class="mt-2 text-sm text-[#a09d96] leading-relaxed">
          Building fast, accessible, zero-bloat web applications using Astro islands, React, TypeScript, and modern semantic HTML5.
        </p>
      </div>

      <div class="mt-6 pt-4 border-t border-[#252320] flex flex-wrap gap-1.5">
        {skills.frontend.map((item) => (
          <span class="px-2.5 py-0.5 rounded-md bg-[#252320] text-xs font-mono text-[#e6dfd8] border border-[#3d3d3a]">
            {item}
          </span>
        ))}
      </div>
    </div>

    <!-- Bento Tile 3: Dark Navy Surface for Motion (col-span-5) -->
    <div class="bento-card md:col-span-5 p-6 sm:p-8 rounded-xl bg-[#181715] text-[#faf9f5] border border-[#252320] flex flex-col justify-between hover:border-[#cc785c] transition-colors">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-[#252320]">
          <span class="text-xs font-mono font-medium text-[#e8a55a]">INTERACTION ENGINE</span>
          <span class="text-xs font-mono text-[#a09d96]">60 FPS</span>
        </div>

        <h3 class="mt-4 font-display text-2xl text-[#faf9f5] tracking-tight">
          Kinetic Scrolling & Micro-Motion
        </h3>
        <p class="mt-2 text-sm text-[#a09d96] leading-relaxed">
          Fluid momentum scrolling with Lenis paired with synchronized GSAP ScrollTrigger micro-animations for an organic, responsive feel.
        </p>
      </div>

      <div class="mt-6 pt-4 border-t border-[#252320] flex flex-col gap-1.5 font-mono text-xs text-[#a09d96]">
        <div class="flex items-center justify-between">
          <span>Scroll Dynamics:</span>
          <span class="text-[#faf9f5]">Lenis Smooth Inertia</span>
        </div>
        <div class="flex items-center justify-between">
          <span>Animation Layer:</span>
          <span class="text-[#cc785c]">GSAP ScrollTrigger</span>
        </div>
      </div>
    </div>

    <!-- Bento Tile 4: Cream Card for Standards & Quality (col-span-7) -->
    <div class="bento-card md:col-span-7 p-6 sm:p-8 rounded-xl bg-[#efe9de] border border-[#e6dfd8] flex flex-col justify-between hover:border-[#cc785c] transition-colors">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-[#e6dfd8]">
          <span class="text-xs font-mono font-medium text-[#5db872]">ACCESSIBILITY & CWV</span>
          <span class="text-xs font-mono text-[#8e8b82]">100/100</span>
        </div>

        <h3 class="mt-4 font-display text-2xl text-[#141413] tracking-tight">
          Performance, Accessibility & SEO
        </h3>
        <p class="mt-2 text-sm text-[#3d3d3a] leading-relaxed">
          Zero tolerance for inaccessible markup or sluggish TTFB. Ensuring 100/100 Core Web Vitals, WCAG AA compliance, and structured JSON-LD data.
        </p>
      </div>

      <div class="mt-6 pt-4 border-t border-[#e6dfd8] flex flex-wrap gap-1.5">
        {skills.workflow.map((item) => (
          <span class="px-2.5 py-0.5 rounded-md bg-[#faf9f5] text-xs font-mono text-[#3d3d3a] border border-[#e6dfd8]">
            {item}
          </span>
        ))}
      </div>
    </div>

  </div>
</section>
