---
import { portfolioData } from '../data/portfolioData';
import { SkillsInteractiveStudio } from './ui/SkillsInteractiveStudio';

const { skills } = portfolioData;
---

<section id="skills" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-[#B9D4F5]">
    <div>
      <div class="mb-2">
        <span class="text-xs font-mono font-medium text-[#123A86] uppercase tracking-wider">
          Technical Architecture & Competencies
        </span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl text-[#0E1B3D] tracking-tight font-semibold">
        Technical Matrix & Tooling
      </h2>
      <p class="mt-2 text-sm sm:text-base text-[#24365C] max-w-[58ch] leading-relaxed">
        Bridging Figma design systems and production web applications with type-safe frontend engineering, API integration, and enterprise ERP workflow experience.
      </p>
    </div>

    <!-- Quick Domain Metric Strip -->
    <div class="flex items-center gap-2 font-mono text-xs text-[#2F4166]">
      <span class="px-3 py-1.5 rounded-lg bg-[#F2F7FF] border border-[#B9D4F5] text-[#24365C]">
        4 Core Domains
      </span>
      <span class="px-3 py-1.5 rounded-lg bg-[#DCEBFF] border border-[#B9D4F5] text-[#123A86] font-medium">
        TypeScript & React
      </span>
    </div>
  </div>

  <!-- Asymmetric Bento Grid -->
  <div class="mt-10 grid grid-cols-1 lg:grid-cols-12 gap-6">
    
    <!-- ========================================================================= -->
    <!-- TILE 1: FLAGSHIP HERO (Col-span-12 lg:col-span-7)                          -->
    <!-- Frontend Engineering, Component Architecture & Interactive Code Sandbox   -->
    <!-- ========================================================================= -->
    <div class="bento-card lg:col-span-7 p-6 sm:p-8 rounded-2xl bg-white border-[#B9D4F5] flex flex-col justify-between hover:border-[#1F5FD6]/50 transition-all shadow-xs group">
      <div>
        <!-- Card Sub-header -->
        <div class="flex items-center justify-between pb-3 border-b border-[#B9D4F5]">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#1F5FD6]"></span>
            <span class="text-xs font-mono font-medium text-[#123A86]">CORE SPECIALIZATION</span>
          </div>
          <span class="text-xs font-mono text-[#2F4166]">REACT · TS · TAILWIND</span>
        </div>

        <!-- Title & Concept -->
        <h3 class="mt-4 font-display text-2xl sm:text-3xl text-[#0E1B3D] tracking-tight font-semibold">
          Frontend Engineering & Component Architecture
        </h3>
        <p class="mt-2 text-sm text-[#24365C] leading-relaxed max-w-[56ch]">
          Developing modular, responsive, and accessible user interfaces. Converting design tokens and wireframes into clean, type-safe React and TypeScript components with strict state boundaries.
        </p>

        <!-- Interactive Code & Token Inspector -->
        <div class="mt-5">
          <SkillsInteractiveStudio client:visible />
        </div>
      </div>

      <!-- Core Technologies Badges -->
      <div class="mt-6 pt-4 border-t border-[#B9D4F5]">
        <span class="text-xs font-mono text-[#2F4166] uppercase tracking-wider block mb-2.5">
          Core Frontend Stack
        </span>
        <div class="flex flex-wrap gap-1.5">
          {skills.core.map((item) => (
            <span class="px-2.5 py-1 rounded-md bg-[#F2F7FF] text-xs font-mono text-[#24365C] border border-[#B9D4F5] hover:border-[#1F5FD6] transition-colors">
              {item}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TILE 2: DESIGN SYSTEMS & UI/UX CRAFT (Col-span-12 lg:col-span-5)           -->
    <!-- Figma Prototyping, Design Tokens, Spatial & Micro-interaction Engineering -->
    <!-- ========================================================================= -->
    <div class="bento-card lg:col-span-5 p-6 sm:p-8 rounded-2xl bg-white border-[#B9D4F5] flex flex-col justify-between hover:border-[#1F5FD6]/50 transition-all shadow-xs group">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-[#B9D4F5]">
          <span class="text-xs font-mono font-medium text-[#123A86]">DESIGN SYSTEMS</span>
          <span class="text-xs font-mono text-[#2F4166]">FIGMA → CODE</span>
        </div>

        <h3 class="mt-4 font-display text-2xl text-[#0E1B3D] tracking-tight font-semibold">
          UI/UX & Design Tokens
        </h3>
        <p class="mt-2 text-sm text-[#24365C] leading-relaxed">
          Crafting consistent visual languages in Figma with semantic color variables, auto-layout hierarchies, and WCAG AA accessibility standards.
        </p>

        <!-- Visual Design Token Card -->
        <div class="mt-5 p-4 rounded-xl bg-[#F2F7FF] border border-[#B9D4F5] space-y-3 font-mono text-xs">
          
          <!-- Color Tokens Palette -->
          <div>
            <span class="text-xs text-[#2F4166] uppercase tracking-wider block mb-2">Sky Tokens</span>
            <div class="grid grid-cols-4 gap-2">
              <div class="p-2 rounded-lg bg-white border border-[#B9D4F5] flex flex-col items-center text-center">
                <span class="w-3.5 h-3.5 rounded-full bg-[#EAF3FF] border border-[#B9D4F5] mb-1"></span>
                <span class="text-xs text-[#24365C] font-medium">Canvas</span>
              </div>
              <div class="p-2 rounded-lg bg-white border border-[#B9D4F5] flex flex-col items-center text-center">
                <span class="w-3.5 h-3.5 rounded-full bg-[#1F5FD6] mb-1"></span>
                <span class="text-xs text-[#123A86] font-medium">Primary</span>
              </div>
              <div class="p-2 rounded-lg bg-white border border-[#B9D4F5] flex flex-col items-center text-center">
                <span class="w-3.5 h-3.5 rounded-full bg-[#80B3FF] border border-[#B9D4F5] mb-1"></span>
                <span class="text-xs text-[#24365C] font-medium">Sky</span>
              </div>
              <div class="p-2 rounded-lg bg-white border border-[#B9D4F5] flex flex-col items-center text-center">
                <span class="w-3.5 h-3.5 rounded-full bg-[#B3D9FF] border border-[#B9D4F5] mb-1"></span>
                <span class="text-xs text-[#24365C] font-medium">Mist</span>
              </div>
            </div>
          </div>

          <!-- Typography & Spacing Rhythm -->
          <div class="pt-2 border-t border-[#B9D4F5] space-y-1.5 text-xs">
            <div class="flex items-center justify-between text-[#24365C]">
              <span>Typography:</span>
              <span class="text-[#0E1B3D] font-medium">Plus Jakarta Sans + Inter</span>
            </div>
            <div class="flex items-center justify-between text-[#24365C]">
              <span>Contrast Ratio:</span>
              <span class="text-[#123A86] font-semibold">WCAG AA Compliant</span>
            </div>
            <div class="flex items-center justify-between text-[#24365C]">
              <span>Micro-Motion:</span>
              <span class="text-[#123A86]">cubic-bezier(0.16, 1, 0.3, 1)</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Design-to-Code Workflow Strip -->
      <div class="mt-6 pt-4 border-t border-[#B9D4F5]">
        <div class="flex items-center justify-between text-xs font-mono text-[#2F4166]">
          <span>Wireframe</span>
          <span>→</span>
          <span>Figma Prototype</span>
          <span>→</span>
          <span class="text-[#123A86] font-semibold">React TSX</span>
        </div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TILE 3: BACKEND API & DATA CONTRACTS (Col-span-12 md:col-span-4)           -->
    <!-- Production REST API & Database Integration                                -->
    <!-- ========================================================================= -->
    <div class="bento-card lg:col-span-4 p-6 sm:p-7 rounded-2xl bg-white border-[#B9D4F5] flex flex-col justify-between hover:border-[#1F5FD6]/50 transition-all shadow-xs group">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-[#B9D4F5]">
          <span class="text-xs font-mono font-medium text-[#123A86]">SERVER & APIS</span>
          <span class="text-xs font-mono text-[#2F4166]">REST & SQL</span>
        </div>

        <h3 class="mt-4 font-display text-2xl text-[#0E1B3D] tracking-tight font-semibold">
          Backend & Databases
        </h3>
        <p class="mt-2 text-xs sm:text-sm text-[#24365C] leading-relaxed">
          Building RESTful endpoints with Node.js, Express, and Laravel, with structured relational schemas in MySQL & TiDB.
        </p>

        <!-- Code Terminal Simulation -->
        <div class="mt-4 p-3 rounded-lg bg-[#F2F7FF] text-[#0E1B3D] border border-[#B9D4F5] font-mono text-xs space-y-1.5">
          <div class="flex items-center justify-between text-[#2F4166] pb-1 border-b border-[#B9D4F5]">
            <span>GET /api/v1/research</span>
            <span class="text-[#123A86]">200 OK</span>
          </div>
          <p class="text-[#24365C] text-xs">
            <span class="text-[#123A86]">Database:</span> MySQL / TiDB Cluster<br/>
            <span class="text-[#123A86]">Latency:</span> 14ms (Indexed queries)
          </p>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-[#B9D4F5] flex flex-wrap gap-1.5">
        {[...skills.backend, ...skills.database].map((item) => (
          <span class="px-2.5 py-0.5 rounded text-xs font-mono bg-[#F2F7FF] text-[#24365C] border border-[#B9D4F5]">
            {item}
          </span>
        ))}
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TILE 4: ENTERPRISE ERP & QA PIPELINE (Col-span-12 md:col-span-4)          -->
    <!-- Business Process, UAT Testing & Manual Books                              -->
    <!-- ========================================================================= -->
    <div class="bento-card lg:col-span-4 p-6 sm:p-7 rounded-2xl bg-white border-[#B9D4F5] flex flex-col justify-between hover:border-[#1F5FD6]/50 transition-all shadow-xs group">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-[#B9D4F5]">
          <span class="text-xs font-mono font-medium text-[#123A86]">ENTERPRISE DOMAIN</span>
          <span class="text-xs font-mono text-[#2F4166]">ERP & QA</span>
        </div>

        <h3 class="mt-4 font-display text-2xl text-[#0E1B3D] tracking-tight font-semibold">
          ERP Workflows & UAT
        </h3>
        <p class="mt-2 text-xs sm:text-sm text-[#24365C] leading-relaxed">
          Translating complex enterprise processes into functional blueprints, standard operating procedures, and rigorous UAT test cases.
        </p>

        <!-- 3-Stage Verification Pipeline -->
        <div class="mt-4 space-y-1.5 font-mono text-xs">
          <div class="p-2 rounded-lg bg-[#F2F7FF] border border-[#B9D4F5] flex items-center justify-between">
            <span class="text-[#24365C]">1. Process Analysis</span>
            <span class="text-[#123A86] font-medium">✓ Verified</span>
          </div>
          <div class="p-2 rounded-lg bg-[#F2F7FF] border border-[#B9D4F5] flex items-center justify-between">
            <span class="text-[#24365C]">2. Functional Blueprint</span>
            <span class="text-[#123A86] font-medium">✓ Approved</span>
          </div>
          <div class="p-2 rounded-lg bg-[#F2F7FF] border border-[#B9D4F5] flex items-center justify-between">
            <span class="text-[#24365C]">3. UAT Execution</span>
            <span class="text-[#123A86] font-medium">✓ Validated</span>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-[#B9D4F5] flex flex-wrap gap-1.5">
        <span class="px-2 py-0.5 rounded text-xs font-mono bg-[#F2F7FF] text-[#24365C] border border-[#B9D4F5]">Odoo ERP</span>
        <span class="px-2 py-0.5 rounded text-xs font-mono bg-[#F2F7FF] text-[#24365C] border border-[#B9D4F5]">UAT Testing</span>
        <span class="px-2 py-0.5 rounded text-xs font-mono bg-[#F2F7FF] text-[#24365C] border border-[#B9D4F5]">Manual Books</span>
        <span class="px-2 py-0.5 rounded text-xs font-mono bg-[#F2F7FF] text-[#24365C] border border-[#B9D4F5]">Master Data</span>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TILE 5: DEVELOPER TOOLING & MOBILE DELIVERY (Col-span-12 md:col-span-4)   -->
    <!-- Git, Vite, Astro, Flutter Mobile Engineering                              -->
    <!-- ========================================================================= -->
    <div class="bento-card lg:col-span-4 p-6 sm:p-7 rounded-2xl bg-white border-[#B9D4F5] flex flex-col justify-between hover:border-[#1F5FD6]/50 transition-all shadow-xs group">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-[#B9D4F5]">
          <span class="text-xs font-mono font-medium text-[#123A86]">TOOLING & ECOSYSTEM</span>
          <span class="text-xs font-mono text-[#2F4166]">DEV & MOBILE</span>
        </div>

        <h3 class="mt-4 font-display text-2xl text-[#0E1B3D] tracking-tight font-semibold">
          Tooling & Cross-Platform
        </h3>
        <p class="mt-2 text-xs sm:text-sm text-[#24365C] leading-relaxed">
          Modern developer workflow for fast bundle build pipelines, static generation with Astro, and Flutter mobile apps.
        </p>

        <!-- Dev Ecosystem Status Panel -->
        <div class="mt-4 p-3 rounded-lg bg-[#F2F7FF] text-[#0E1B3D] border border-[#B9D4F5] font-mono text-xs space-y-2">
          <div class="flex items-center justify-between text-[#2F4166]">
            <span>Git / GitHub</span>
            <span class="text-[#0E1B3D] font-medium">Branch & PR flow</span>
          </div>
          <div class="flex items-center justify-between text-[#2F4166]">
            <span>Build Engine</span>
            <span class="text-[#123A86] font-medium">Vite & Astro 5</span>
          </div>
          <div class="flex items-center justify-between text-[#2F4166]">
            <span>Mobile Stack</span>
            <span class="text-[#123A86] font-medium">Flutter & Dart</span>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-[#B9D4F5] flex flex-wrap gap-1.5">
        {skills.tools.concat(['Astro', 'Flutter & Dart']).map((item) => (
          <span class="px-2.5 py-0.5 rounded text-xs font-mono bg-[#F2F7FF] text-[#24365C] border border-[#B9D4F5]">
            {item}
          </span>
        ))}
      </div>
    </div>

  </div>
</section>
