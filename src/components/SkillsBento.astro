---
import { portfolioData } from '../data/portfolioData';
import { SkillsInteractiveStudio } from './ui/SkillsInteractiveStudio';

const { skills } = portfolioData;
---

<section id="skills" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-zinc-200 dark:border-white/10">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-500 animate-pulse"></span>
        <span class="text-xs font-mono font-medium text-sky-600 dark:text-sky-400 uppercase tracking-wider">
          Technical Architecture & Competencies
        </span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl text-zinc-950 dark:text-zinc-100 tracking-tight font-semibold">
        Technical Matrix & Tooling
      </h2>
      <p class="mt-2 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-[58ch] leading-relaxed">
        Bridging Figma design systems and production web applications with type-safe frontend engineering, API integration, and enterprise ERP workflow experience.
      </p>
    </div>

    <!-- Quick Domain Metric Strip -->
    <div class="flex items-center gap-2 font-mono text-xs text-zinc-500 dark:text-zinc-400">
      <span class="px-3 py-1.5 rounded-lg bg-zinc-50 dark:bg-[#121316] border border-zinc-200 dark:border-white/10 text-zinc-800 dark:text-zinc-200">
        4 Core Domains
      </span>
      <span class="px-3 py-1.5 rounded-lg bg-sky-50 dark:bg-sky-950/40 border border-sky-200 dark:border-sky-800/50 text-sky-700 dark:text-sky-300 font-medium">
        TypeScript & React
      </span>
    </div>
  </div>

  <!-- Asymmetric Bento Grid -->
  <div class="mt-10 grid grid-cols-1 lg:grid-cols-12 gap-6">
    
    <!-- ========================================================================= -->
    <!-- TILE 1: FLAGSHIP HERO (Col-span-12 lg:col-span-7)                          -->
    <!-- Frontend Engineering, Component Architecture & Interactive Code Sandbox   -->
    <!-- ========================================================================= -->
    <div class="bento-card lg:col-span-7 p-6 sm:p-8 rounded-2xl bg-white dark:bg-[#121316] border border-zinc-200 dark:border-white/10 flex flex-col justify-between hover:border-sky-500/50 dark:hover:border-sky-400/50 transition-all shadow-xs group">
      <div>
        <!-- Card Sub-header -->
        <div class="flex items-center justify-between pb-3 border-b border-zinc-200 dark:border-white/10">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-sky-500 animate-pulse"></span>
            <span class="text-xs font-mono font-medium text-sky-600 dark:text-sky-400">CORE SPECIALIZATION</span>
          </div>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">REACT · TS · TAILWIND</span>
        </div>

        <!-- Title & Concept -->
        <h3 class="mt-4 font-display text-2xl sm:text-3xl text-zinc-950 dark:text-zinc-100 tracking-tight font-semibold">
          Frontend Engineering & Component Architecture
        </h3>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-[56ch]">
          Developing modular, responsive, and accessible user interfaces. Converting design tokens and wireframes into clean, type-safe React and TypeScript components with strict state boundaries.
        </p>

        <!-- Interactive Code & Token Inspector -->
        <div class="mt-5">
          <SkillsInteractiveStudio client:visible />
        </div>
      </div>

      <!-- Core Technologies Badges -->
      <div class="mt-6 pt-4 border-t border-zinc-200 dark:border-white/10">
        <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase tracking-wider block mb-2.5">
          Core Frontend Stack
        </span>
        <div class="flex flex-wrap gap-1.5">
          {skills.core.map((item) => (
            <span class="px-2.5 py-1 rounded-md bg-zinc-50 dark:bg-white/5 text-xs font-mono text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-white/10 hover:border-sky-500 dark:hover:border-sky-400 transition-colors">
              {item}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TILE 2: DESIGN SYSTEMS & UI/UX CRAFT (Col-span-12 lg:col-span-5)           -->
    <!-- Figma Prototyping, Design Tokens, Spatial & Micro-interaction Engineering -->
    <!-- ========================================================================= -->
    <div class="bento-card lg:col-span-5 p-6 sm:p-8 rounded-2xl bg-white dark:bg-[#121316] border border-zinc-200 dark:border-white/10 flex flex-col justify-between hover:border-sky-500/50 dark:hover:border-sky-400/50 transition-all shadow-xs group">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-zinc-200 dark:border-white/10">
          <span class="text-xs font-mono font-medium text-emerald-600 dark:text-emerald-400">DESIGN SYSTEMS</span>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">FIGMA → CODE</span>
        </div>

        <h3 class="mt-4 font-display text-2xl text-zinc-950 dark:text-zinc-100 tracking-tight font-semibold">
          UI/UX & Design Tokens
        </h3>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Crafting consistent visual languages in Figma with semantic color variables, auto-layout hierarchies, and WCAG AA accessibility standards.
        </p>

        <!-- Visual Design Token Card -->
        <div class="mt-5 p-4 rounded-xl bg-zinc-50 dark:bg-[#0d0e12] border border-zinc-200 dark:border-white/10 space-y-3 font-mono text-xs">
          
          <!-- Color Tokens Palette -->
          <div>
            <span class="text-xs text-zinc-500 dark:text-zinc-400 uppercase tracking-wider block mb-2">Dual Design Tokens</span>
            <div class="grid grid-cols-4 gap-2">
              <div class="p-2 rounded-lg bg-white dark:bg-white/5 border border-zinc-200 dark:border-white/10 flex flex-col items-center text-center">
                <span class="w-3.5 h-3.5 rounded-full bg-white border border-zinc-300 dark:border-white/20 mb-1"></span>
                <span class="text-xs text-zinc-800 dark:text-zinc-200 font-medium">Canvas</span>
              </div>
              <div class="p-2 rounded-lg bg-white dark:bg-white/5 border border-zinc-200 dark:border-white/10 flex flex-col items-center text-center">
                <span class="w-3.5 h-3.5 rounded-full bg-[#0284c7] mb-1"></span>
                <span class="text-xs text-[#0284c7] dark:text-[#38bdf8] font-medium">Accent</span>
              </div>
              <div class="p-2 rounded-lg bg-white dark:bg-white/5 border border-zinc-200 dark:border-white/10 flex flex-col items-center text-center">
                <span class="w-3.5 h-3.5 rounded-full bg-[#080808] border border-white/20 mb-1"></span>
                <span class="text-xs text-zinc-800 dark:text-zinc-200 font-medium">Obsidian</span>
              </div>
              <div class="p-2 rounded-lg bg-white dark:bg-white/5 border border-zinc-200 dark:border-white/10 flex flex-col items-center text-center">
                <span class="w-3.5 h-3.5 rounded-full bg-emerald-500 mb-1"></span>
                <span class="text-xs text-emerald-600 dark:text-emerald-400 font-medium">Success</span>
              </div>
            </div>
          </div>

          <!-- Typography & Spacing Rhythm -->
          <div class="pt-2 border-t border-zinc-200 dark:border-white/10 space-y-1.5 text-xs">
            <div class="flex items-center justify-between text-zinc-600 dark:text-zinc-400">
              <span>Typography:</span>
              <span class="text-zinc-900 dark:text-zinc-200 font-medium">Plus Jakarta Sans + Inter</span>
            </div>
            <div class="flex items-center justify-between text-zinc-600 dark:text-zinc-400">
              <span>Contrast Ratio:</span>
              <span class="text-emerald-600 dark:text-emerald-400 font-semibold">WCAG AA Compliant</span>
            </div>
            <div class="flex items-center justify-between text-zinc-600 dark:text-zinc-400">
              <span>Micro-Motion:</span>
              <span class="text-sky-600 dark:text-sky-400">cubic-bezier(0.16, 1, 0.3, 1)</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Design-to-Code Workflow Strip -->
      <div class="mt-6 pt-4 border-t border-zinc-200 dark:border-white/10">
        <div class="flex items-center justify-between text-xs font-mono text-zinc-500 dark:text-zinc-400">
          <span>Wireframe</span>
          <span>→</span>
          <span>Figma Prototype</span>
          <span>→</span>
          <span class="text-sky-600 dark:text-sky-400 font-semibold">React TSX</span>
        </div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TILE 3: BACKEND API & DATA CONTRACTS (Col-span-12 md:col-span-4)           -->
    <!-- Production REST API & Database Integration                                -->
    <!-- ========================================================================= -->
    <div class="bento-card lg:col-span-4 p-6 sm:p-7 rounded-2xl bg-white dark:bg-[#121316] border border-zinc-200 dark:border-white/10 flex flex-col justify-between hover:border-sky-500/50 dark:hover:border-sky-400/50 transition-all shadow-xs group">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-zinc-200 dark:border-white/10">
          <span class="text-xs font-mono font-medium text-emerald-600 dark:text-emerald-400">SERVER & APIS</span>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">REST & SQL</span>
        </div>

        <h3 class="mt-4 font-display text-2xl text-zinc-950 dark:text-zinc-100 tracking-tight font-semibold">
          Backend & Databases
        </h3>
        <p class="mt-2 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Building RESTful endpoints with Node.js, Express, and Laravel, with structured relational schemas in MySQL & TiDB.
        </p>

        <!-- Code Terminal Simulation -->
        <div class="mt-4 p-3 rounded-lg bg-zinc-900 text-zinc-100 border border-zinc-800 font-mono text-xs space-y-1.5">
          <div class="flex items-center justify-between text-zinc-400 pb-1 border-b border-zinc-800">
            <span>GET /api/v1/research</span>
            <span class="text-emerald-400">200 OK</span>
          </div>
          <p class="text-zinc-300 text-xs">
            <span class="text-sky-400">Database:</span> MySQL / TiDB Cluster<br/>
            <span class="text-emerald-400">Latency:</span> 14ms (Indexed queries)
          </p>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-zinc-200 dark:border-white/10 flex flex-wrap gap-1.5">
        {[...skills.backend, ...skills.database].map((item) => (
          <span class="px-2.5 py-0.5 rounded text-xs font-mono bg-zinc-50 dark:bg-white/5 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-white/10">
            {item}
          </span>
        ))}
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TILE 4: ENTERPRISE ERP & QA PIPELINE (Col-span-12 md:col-span-4)          -->
    <!-- Business Process, UAT Testing & Manual Books                              -->
    <!-- ========================================================================= -->
    <div class="bento-card lg:col-span-4 p-6 sm:p-7 rounded-2xl bg-white dark:bg-[#121316] border border-zinc-200 dark:border-white/10 flex flex-col justify-between hover:border-sky-500/50 dark:hover:border-sky-400/50 transition-all shadow-xs group">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-zinc-200 dark:border-white/10">
          <span class="text-xs font-mono font-medium text-amber-600 dark:text-amber-400">ENTERPRISE DOMAIN</span>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">ERP & QA</span>
        </div>

        <h3 class="mt-4 font-display text-2xl text-zinc-950 dark:text-zinc-100 tracking-tight font-semibold">
          ERP Workflows & UAT
        </h3>
        <p class="mt-2 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Translating complex enterprise processes into functional blueprints, standard operating procedures, and rigorous UAT test cases.
        </p>

        <!-- 3-Stage Verification Pipeline -->
        <div class="mt-4 space-y-1.5 font-mono text-xs">
          <div class="p-2 rounded-lg bg-zinc-50 dark:bg-white/5 border border-zinc-200 dark:border-white/10 flex items-center justify-between">
            <span class="text-zinc-700 dark:text-zinc-300">1. Process Analysis</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-medium">✓ Verified</span>
          </div>
          <div class="p-2 rounded-lg bg-zinc-50 dark:bg-white/5 border border-zinc-200 dark:border-white/10 flex items-center justify-between">
            <span class="text-zinc-700 dark:text-zinc-300">2. Functional Blueprint</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-medium">✓ Approved</span>
          </div>
          <div class="p-2 rounded-lg bg-zinc-50 dark:bg-white/5 border border-zinc-200 dark:border-white/10 flex items-center justify-between">
            <span class="text-zinc-700 dark:text-zinc-300">3. UAT Execution</span>
            <span class="text-sky-600 dark:text-sky-400 font-medium">✓ Validated</span>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-zinc-200 dark:border-white/10 flex flex-wrap gap-1.5">
        <span class="px-2 py-0.5 rounded text-xs font-mono bg-zinc-50 dark:bg-white/5 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-white/10">Odoo ERP</span>
        <span class="px-2 py-0.5 rounded text-xs font-mono bg-zinc-50 dark:bg-white/5 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-white/10">UAT Testing</span>
        <span class="px-2 py-0.5 rounded text-xs font-mono bg-zinc-50 dark:bg-white/5 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-white/10">Manual Books</span>
        <span class="px-2 py-0.5 rounded text-xs font-mono bg-zinc-50 dark:bg-white/5 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-white/10">Master Data</span>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TILE 5: DEVELOPER TOOLING & MOBILE DELIVERY (Col-span-12 md:col-span-4)   -->
    <!-- Git, Vite, Astro, Flutter Mobile Engineering                              -->
    <!-- ========================================================================= -->
    <div class="bento-card lg:col-span-4 p-6 sm:p-7 rounded-2xl bg-white dark:bg-[#121316] border border-zinc-200 dark:border-white/10 flex flex-col justify-between hover:border-sky-500/50 dark:hover:border-sky-400/50 transition-all shadow-xs group">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-zinc-200 dark:border-white/10">
          <span class="text-xs font-mono font-medium text-sky-600 dark:text-sky-400">TOOLING & ECOSYSTEM</span>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">DEV & MOBILE</span>
        </div>

        <h3 class="mt-4 font-display text-2xl text-zinc-950 dark:text-zinc-100 tracking-tight font-semibold">
          Tooling & Cross-Platform
        </h3>
        <p class="mt-2 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Modern developer workflow for fast bundle build pipelines, static generation with Astro, and Flutter mobile apps.
        </p>

        <!-- Dev Ecosystem Status Panel -->
        <div class="mt-4 p-3 rounded-lg bg-zinc-900 text-zinc-100 border border-zinc-800 font-mono text-xs space-y-2">
          <div class="flex items-center justify-between text-zinc-400">
            <span>Git / GitHub</span>
            <span class="text-zinc-200 font-medium">Branch & PR flow</span>
          </div>
          <div class="flex items-center justify-between text-zinc-400">
            <span>Build Engine</span>
            <span class="text-emerald-400 font-medium">Vite & Astro 5</span>
          </div>
          <div class="flex items-center justify-between text-zinc-400">
            <span>Mobile Stack</span>
            <span class="text-sky-400 font-medium">Flutter & Dart</span>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-zinc-200 dark:border-white/10 flex flex-wrap gap-1.5">
        {skills.tools.concat(['Astro', 'Flutter & Dart']).map((item) => (
          <span class="px-2.5 py-0.5 rounded text-xs font-mono bg-zinc-50 dark:bg-white/5 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-white/10">
            {item}
          </span>
        ))}
      </div>
    </div>

  </div>
</section>
