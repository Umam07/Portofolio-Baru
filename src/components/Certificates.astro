---
import { portfolioData } from '../data/portfolioData';

const { certificates } = portfolioData;
---

<section id="certificates" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28 lg:px-8">
  <div class="mb-9 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="mb-3 font-mono text-xs font-medium uppercase tracking-[0.18em] text-[#123A86]">
        Credentials
      </p>
      <h2 class="font-display text-3xl font-semibold leading-tight tracking-[-0.03em] text-[#0E1B3D] sm:text-4xl">
        Certificates &amp; training.
      </h2>
    </div>
    <p class="max-w-xs text-sm leading-relaxed text-[#2F4166]">
      Verified courses and hands-on training supporting my transition into cybersecurity.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
    {certificates.map((cert, index) => (
      <article class="group flex flex-col overflow-hidden rounded-2xl border border-[#B9D4F5] bg-white shadow-[0_4px_20px_rgba(31,95,214,0.08)] transition-all duration-300 hover:-translate-y-0.5 hover:border-[#1F5FD6]/60 hover:shadow-[0_16px_40px_rgba(31,95,214,0.14)]">
        <button
          type="button"
          data-cert-open={cert.id}
          aria-label={`View details for ${cert.title}`}
          class="relative aspect-[16/10] w-full cursor-pointer overflow-hidden border-b border-[#B9D4F5] bg-[#F2F7FF] text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#1F5FD6]"
        >
          <img
            src={cert.image}
            alt={`${cert.title} certificate from ${cert.issuer}`}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-contain p-2 transition-transform duration-500 ease-out group-hover:scale-[1.02]"
          />
          <span class="absolute left-3 top-3 rounded-full border border-[#B9D4F5] bg-white/90 px-2.5 py-1 font-mono text-[11px] font-medium text-[#123A86] backdrop-blur-sm">
            {cert.type}
          </span>
        </button>

        <div class="flex flex-1 flex-col justify-between p-6">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-[#2F4166]">
              <span class="font-medium text-[#123A86]">
                {String(index + 1).padStart(2, '0')} · {cert.issuer}
              </span>
              <span>{cert.issued}</span>
            </div>

            <h3 class="mt-3 font-display text-xl font-semibold leading-snug tracking-[-0.02em] text-[#0E1B3D]">
              {cert.title}
            </h3>

            <p class="mt-2 text-sm leading-relaxed text-[#24365C]">
              {cert.summary}
            </p>

            <div class="mt-4 flex flex-wrap gap-1.5">
              {cert.testedSkills.map((skill) => (
                <span class="rounded-full border border-[#B9D4F5] bg-[#F2F7FF] px-2.5 py-0.5 text-[11px] font-medium text-[#123A86]">
                  {skill}
                </span>
              ))}
            </div>
          </div>

          <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-[#B9D4F5] pt-4">
            <button
              type="button"
              data-cert-open={cert.id}
              class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-[#B9D4F5] bg-white px-3.5 py-2 text-xs font-semibold text-[#0E1B3D] transition-colors hover:border-[#1F5FD6] hover:bg-[#F2F7FF] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6]"
            >
              <span>View details</span>
              <svg class="h-3.5 w-3.5 text-[#123A86]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7Z" />
              </svg>
            </button>

            {cert.credentialId && cert.verifyUrl && (
              <a
                href={cert.verifyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-full bg-[#1F5FD6] px-3.5 py-2 text-xs font-semibold text-white transition-colors hover:bg-[#123A86] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6]"
              >
                <span>Verify credential</span>
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17 17 7m0 0H8m9 0v9" />
                </svg>
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>

  {certificates.map((cert) => (
    <dialog
      id={`cert-dialog-${cert.id}`}
      aria-labelledby={`cert-dialog-title-${cert.id}`}
      class="cert-dialog m-auto w-[calc(100%-2rem)] max-w-2xl rounded-3xl border border-[#B9D4F5] bg-white p-0 text-[#0E1B3D] shadow-[0_24px_70px_rgba(14,27,61,0.24)] backdrop:bg-[#0E1B3D]/45 backdrop:backdrop-blur-sm"
    >
      <div class="flex items-center justify-between gap-4 border-b border-[#B9D4F5] px-6 py-4">
        <span class="inline-flex items-center gap-2 font-mono text-xs font-medium uppercase tracking-[0.14em] text-[#123A86]">
          <span class="h-1.5 w-1.5 rounded-full bg-[#1F5FD6]" aria-hidden="true"></span>
          {cert.type}
        </span>
        <button
          type="button"
          data-cert-close
          aria-label="Close certificate details"
          class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-[#B9D4F5] text-[#24365C] transition-colors hover:border-[#1F5FD6] hover:text-[#0E1B3D] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6]"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="p-6">
        <div class="overflow-hidden rounded-2xl border border-[#B9D4F5] bg-[#F2F7FF]">
          <img
            src={cert.image}
            alt={`${cert.title} certificate from ${cert.issuer}`}
            class="max-h-[60vh] w-full object-contain p-2"
          />
        </div>

        <h3 id={`cert-dialog-title-${cert.id}`} class="mt-5 font-display text-2xl font-semibold tracking-[-0.02em] text-[#0E1B3D]">
          {cert.title}
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-[#24365C]">
          {cert.summary}
        </p>

        <dl class="mt-5 grid grid-cols-1 gap-3 rounded-2xl border border-[#B9D4F5] bg-[#F2F7FF]/70 p-4 sm:grid-cols-2">
          <div>
            <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[#2F4166]">Penerbit / Issuer</dt>
            <dd class="mt-1 text-sm font-semibold text-[#0E1B3D]">{cert.issuer}</dd>
          </div>
          <div>
            <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[#2F4166]">Tipe Sertifikat</dt>
            <dd class="mt-1 text-sm font-semibold text-[#0E1B3D]">{cert.type}</dd>
          </div>
          <div>
            <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[#2F4166]">Masa Berlaku / Issued</dt>
            <dd class="mt-1 text-sm font-semibold text-[#0E1B3D]">{cert.issued}</dd>
          </div>
          {cert.credentialId && (
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-[#2F4166]">Credential ID</dt>
              <dd class="mt-1 font-mono text-xs font-semibold text-[#123A86]">
                {cert.credentialId}
              </dd>
            </div>
          )}
        </dl>

        <div class="mt-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-[#2F4166]">Tested Skills</p>
          <div class="mt-2.5 flex flex-wrap gap-2">
            {cert.testedSkills.map((skill) => (
              <span class="rounded-full border border-[#B9D4F5] bg-white px-3 py-1 text-xs font-medium text-[#123A86]">
                {skill}
              </span>
            ))}
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-end gap-3 border-t border-[#B9D4F5] pt-4">
          <button
            type="button"
            data-cert-close
            class="cursor-pointer rounded-full border border-[#B9D4F5] bg-white px-4 py-2 text-xs font-semibold text-[#24365C] transition-colors hover:border-[#1F5FD6] hover:text-[#0E1B3D] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6]"
          >
            Close
          </button>

          {cert.credentialId && cert.verifyUrl && (
            <a
              href={cert.verifyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-full bg-[#1F5FD6] px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-[#123A86] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6]"
            >
              <span>Verify credential</span>
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17 17 7m0 0H8m9 0v9" />
              </svg>
            </a>
          )}
        </div>
      </div>
    </dialog>
  ))}
</section>

<script>
  function initCertificateDialogs() {
    const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-cert-open]');
    openButtons.forEach((btn) => {
      if ((btn as HTMLButtonElement & { __certBound?: boolean }).__certBound) return;
      (btn as HTMLButtonElement & { __certBound?: boolean }).__certBound = true;
      btn.addEventListener('click', () => {
        const certId = btn.getAttribute('data-cert-open');
        if (!certId) return;
        const dialog = document.getElementById(`cert-dialog-${certId}`) as HTMLDialogElement | null;
        dialog?.showModal();
      });
    });

    const dialogs = document.querySelectorAll<HTMLDialogElement>('.cert-dialog');
    dialogs.forEach((dialog) => {
      if ((dialog as HTMLDialogElement & { __certBound?: boolean }).__certBound) return;
      (dialog as HTMLDialogElement & { __certBound?: boolean }).__certBound = true;

      dialog.querySelectorAll('[data-cert-close]').forEach((closeBtn) => {
        closeBtn.addEventListener('click', () => dialog.close());
      });

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) {
          dialog.close();
        }
      });
    });
  }

  initCertificateDialogs();
  document.addEventListener('astro:page-load', initCertificateDialogs);
</script>
