---
import { portfolioData } from '../data/portfolioData';

const { testimonials } = portfolioData;
---

<section id="testimonials" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <!-- Section Header -->
  <div class="pb-8 border-b border-[#e6dfd8]">
    <h2 class="font-display text-3xl sm:text-4xl text-[#141413] tracking-tight">
      What Collaborators Say
    </h2>
    <p class="mt-2 text-sm sm:text-base text-[#6c6a64] max-w-[50ch]">
      Perspectives from engineering leads, product directors, and founders.
    </p>
  </div>

  <!-- Testimonials Grid -->
  <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
    {testimonials.map((item) => (
      <div class="testimonial-card p-6 sm:p-7 rounded-xl bg-[#efe9de] border border-[#e6dfd8] flex flex-col justify-between hover:border-[#cc785c] transition-colors">
        <div>
          <!-- Serif Quote Sign -->
          <span class="font-display text-3xl text-[#cc785c] leading-none select-none">“</span>
          <p class="mt-2 text-sm text-[#252523] leading-relaxed">
            {item.quote}
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-[#e6dfd8] flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-[#faf9f5] border border-[#e6dfd8] flex items-center justify-center text-xs font-bold text-[#141413] font-mono">
            {item.author.split(' ').map((n) => n[0]).join('')}
          </div>
          <div>
            <h3 class="text-sm font-semibold text-[#141413] font-sans">{item.author}</h3>
            <p class="text-xs text-[#6c6a64]">{item.role}, <span class="text-[#3d3d3a]">{item.company}</span></p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
