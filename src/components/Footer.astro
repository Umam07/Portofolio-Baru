---
import { portfolioData } from '../data/portfolioData';

const currentYear = new Date().getFullYear();
---

<footer class="py-8 px-4 sm:px-6 lg:px-8 bg-white dark:bg-[#080808] text-zinc-500 dark:text-zinc-400 border-t border-zinc-200 dark:border-white/10 transition-colors">
  <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
    
    <!-- Left: Minimalist Copyright -->
    <div>
      <span class="text-xs font-mono text-zinc-600 dark:text-zinc-400">
        © {currentYear} {portfolioData.personal.name}
      </span>
    </div>

    <!-- Right: Resume & Back to Top Link -->
    <div class="flex items-center gap-4 text-xs font-mono">
      <a
        href={portfolioData.personal.resumeUrl}
        download="Resume_Muhammad_Syafiul_Umam.pdf"
        class="text-zinc-500 dark:text-zinc-400 hover:text-sky-600 dark:hover:text-sky-400 transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-sky-500 rounded px-1"
      >
        Resume (PDF)
      </a>

      <span class="text-zinc-300 dark:text-zinc-700" aria-hidden="true">·</span>

      <a
        href="#hero"
        class="inline-flex items-center gap-1.5 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-sky-500 rounded px-1"
      >
        <span>Back to top</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
        </svg>
      </a>
    </div>

  </div>
</footer>
