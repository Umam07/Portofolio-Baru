---
import { portfolioData } from '../data/portfolioData';

const currentYear = new Date().getFullYear();
---

<footer class="py-10 md:py-12 px-4 sm:px-6 lg:px-8 bg-[#181715] text-[#8e8b82] border-t border-[#252320]">
  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
    
    <!-- Left: Logo Mark & Clean Minimalist Copyright -->
    <div class="flex items-center gap-2.5">
      <svg
        viewBox="0 0 141 141"
        class="w-4 h-4 text-[#cc785c]"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path d="M 79.1753 140.756 L 15.1742 140.756 L 79.1753 76.7549 L 79.1753 140.756 Z M 140.756 114.089 L 109.966 140.756 L 109.966 30.7904 L 0 30.7904 L 26.3918 0 L 140.756 0 L 140.756 114.089 Z M 0 112.386 L 0 61.5808 L 50.8052 61.5808 L 0 112.386 Z" />
      </svg>
      <span class="text-xs font-mono text-[#a09d96]">
        © {currentYear} {portfolioData.personal.name}
      </span>
    </div>

    <!-- Right Cluster: Jakarta Clock & Back to Top -->
    <div class="flex items-center gap-6 text-xs font-mono">
      <!-- Live Jakarta Time Indicator -->
      <div class="flex items-center gap-2 text-[#8e8b82]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#5db872]"></span>
        <span id="local-time-clock" class="text-[#a09d96]">--:-- WIB</span>
      </div>

      <!-- Divider -->
      <span class="text-[#3d3d3a]">/</span>

      <!-- Back to Top Link -->
      <a
        href="#hero"
        class="inline-flex items-center gap-1 text-[#8e8b82] hover:text-[#faf9f5] transition-colors"
      >
        <span>Top</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
        </svg>
      </a>
    </div>

  </div>
</footer>

<script>
  const updateClock = () => {
    const clockEl = document.getElementById('local-time-clock');
    if (!clockEl) return;
    const now = new Date();
    const options: Intl.DateTimeFormatOptions = {
      timeZone: 'Asia/Jakarta',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    };
    clockEl.textContent = `${now.toLocaleTimeString('en-GB', options)} WIB`;
  };

  updateClock();
  setInterval(updateClock, 1000);
</script>
