---
import { portfolioData } from '../data/portfolioData';

const { projects } = portfolioData;
const featuredProject = projects[0];
const otherProjects = projects.slice(1);
---

<section id="projects" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28 lg:px-8">
  <div class="flex flex-col gap-6 border-b border-[#B9D4F5] pb-8 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="mb-3 font-mono text-xs font-medium uppercase tracking-[0.18em] text-[#123A86]">
        Selected work
      </p>
      <h2 class="font-display text-4xl font-semibold tracking-tight text-[#0E1B3D] sm:text-5xl">
        Projects
      </h2>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-[#24365C] sm:text-base">
        A concise archive of shipped interfaces, system workflows, and utilities.
      </p>
    </div>
    <span class="inline-flex w-fit items-center gap-2 rounded-full border border-[#B9D4F5] bg-white/70 px-4 py-2 font-mono text-xs text-[#2F4166]">
      {projects.length} projects
    </span>
  </div>

  <div class="mt-10 border-b border-[#B9D4F5]">
    <!-- Featured cinematic entry (shared-element morph into the case study) -->
    <div class="project-item pb-10" data-category={featuredProject.category}>
      <article class="project-card group">
        <a
          href={featuredProject.caseStudyUrl}
          data-astro-preload
          class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6] rounded-3xl"
          aria-label={`View case study: ${featuredProject.title}`}
        >
          <span class="relative block aspect-[16/10] overflow-hidden rounded-3xl border border-[#B9D4F5] bg-[#F2F7FF] transition-all duration-300 group-hover:border-[#1F5FD6]/50 group-hover:shadow-[0_24px_70px_rgba(31,95,214,0.20)] sm:aspect-[21/9]">
            <img
              src={featuredProject.image}
              srcset={`${featuredProject.image.replace(/\.webp$/, '-480.webp')} 480w, ${featuredProject.image} 1280w`}
              sizes="(min-width: 1024px) 1100px, 100vw"
              alt={`Preview of ${featuredProject.title}`}
              loading="lazy"
              transition:name={`project-image-${featuredProject.id}`}
              class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            />
            <span class="absolute inset-0 bg-gradient-to-t from-[#0E1B3D]/15 via-transparent to-transparent" aria-hidden="true"></span>
          </span>

          <span class="grid gap-6 py-8 lg:grid-cols-[1fr_auto] lg:items-end">
            <span>
              <span class="mb-2 block font-mono text-xs uppercase tracking-[0.16em] text-[#123A86]">
                01 · Featured · {featuredProject.category}
              </span>
              <h3 class="block font-display text-3xl font-semibold tracking-tight text-[#0E1B3D] transition-colors group-hover:text-[#123A86] sm:text-4xl">
                {featuredProject.title.split(' — ')[0]}
              </h3>
              <span class="mt-3 block max-w-2xl text-sm leading-relaxed text-[#24365C] sm:text-base">
                {featuredProject.summary}
              </span>
              <span class="mt-4 flex flex-wrap gap-1.5">
                {featuredProject.tags.slice(0, 5).map((tag) => (
                  <span class="rounded-md border border-[#B9D4F5] bg-white/70 px-2.5 py-1 font-mono text-xs text-[#24365C]">
                    {tag}
                  </span>
                ))}
              </span>
            </span>
            <span class="flex items-center gap-4 lg:flex-col lg:items-end">
              <span class="font-mono text-xs uppercase tracking-[0.14em] text-[#2F4166]">
                {featuredProject.year}
              </span>
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-[#1F5FD6] text-white transition-colors group-hover:bg-[#123A86]" aria-hidden="true">
                <svg class="h-5 w-5 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17 17 7m0 0H8m9 0v9"></path>
                </svg>
              </span>
            </span>
          </span>
        </a>
      </article>
    </div>

    <!-- Index rows -->
    {otherProjects.map((project, idx) => {
      const number = String(idx + 2).padStart(2, '0');
      const actionHref = project.caseStudyUrl || project.links.live || project.links.github;
      const isProfileLink = project.links.github === 'https://github.com/Umam07';
      const actionLabel = project.caseStudyUrl
        ? 'Read case study'
        : project.links.live
          ? 'Open live site'
          : isProfileLink
            ? 'View GitHub profile'
            : 'View on GitHub';
      return (
        <div class="project-item border-t border-[#B9D4F5]" data-category={project.category}>
          <article class="project-card group">
            <a
              href={actionHref}
              target={project.caseStudyUrl ? undefined : '_blank'}
              rel={project.caseStudyUrl ? undefined : 'noopener noreferrer'}
              class="grid grid-cols-[auto_1fr_auto] items-center gap-4 py-7 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#1F5FD6] sm:gap-6 md:grid-cols-[56px_128px_1fr_auto]"
              aria-label={`${actionLabel}: ${project.title}`}
            >
              <span class="font-mono text-xs font-medium text-[#2F4166] transition-colors group-hover:text-[#123A86]">
                {number}
              </span>
              <span class="hidden overflow-hidden rounded-xl border border-[#B9D4F5] bg-[#F2F7FF] md:block">
                <img
                  src={project.image}
                  srcset={`${project.image.replace(/\.webp$/, '-480.webp')} 480w, ${project.image} 1280w`}
                  sizes="128px"
                  alt=""
                  loading="lazy"
                  transition:name={project.caseStudyUrl ? `project-image-${project.id}` : undefined}
                  class="aspect-[4/3] w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.06]"
                />
              </span>
              <span class="min-w-0">
                <h3 class="block truncate font-display text-2xl font-semibold tracking-tight text-[#0E1B3D] transition-transform duration-300 group-hover:translate-x-1 sm:text-3xl">
                  {project.title.split(' — ')[0]}
                </h3>
                <span class="mt-1 block font-mono text-xs uppercase tracking-[0.12em] text-[#2F4166]">
                  {project.year} · {project.category}
                </span>
                <span class="mt-2 max-w-2xl text-sm leading-relaxed text-[#24365C] line-clamp-2 sm:block">
                  {project.summary}
                </span>
              </span>
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-[#B9D4F5] text-[#123A86] transition-all group-hover:border-[#1F5FD6] group-hover:bg-[#1F5FD6] group-hover:text-white" aria-hidden="true">
                <svg class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17 17 7m0 0H8m9 0v9"></path>
                </svg>
              </span>
            </a>
          </article>
        </div>
      );
    })}
  </div>
</section>
