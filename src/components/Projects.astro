---
import { portfolioData } from '../data/portfolioData';
import ProjectCard from './ProjectCard.astro';

const { projects } = portfolioData;
const categories = ['All', 'Web Application', 'System Workflows', 'Mobile Application', 'Scripting & Automation'];

const featuredProject = projects[0]; // PentaDosen
const otherProjects = projects.slice(1);

// Helper to count items per category
const getCategoryCount = (cat: string) => {
  if (cat === 'All') return projects.length;
  return projects.filter((p) => p.category === cat).length;
};
---

<section id="projects" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-zinc-200 dark:border-white/10">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[#0284c7] dark:bg-[#38bdf8]"></span>
        <span class="text-xs font-mono font-medium text-[#0284c7] dark:text-[#38bdf8] uppercase tracking-wider">
          Selected Works & Case Studies
        </span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl text-zinc-950 dark:text-white font-bold tracking-tight">
        Featured Projects & Case Studies
      </h2>
      <p class="mt-2 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-[56ch] leading-relaxed">
        Selected works spanning university academic platforms, enterprise ERP systems, mobile applications, and automation utilities.
      </p>
    </div>

    <!-- Live Filter & Count Strip -->
    <div class="flex items-center gap-2 font-mono text-xs text-zinc-500 dark:text-zinc-400">
      <span class="px-3 py-1.5 rounded-md bg-zinc-100 dark:bg-[#121316] border border-zinc-200 dark:border-white/10 text-zinc-900 dark:text-white font-medium">
        {projects.length} Works Total
      </span>
      <span class="px-3 py-1.5 rounded-md bg-zinc-100 dark:bg-[#121316] border border-zinc-200 dark:border-white/10 text-[#0284c7] dark:text-[#38bdf8] font-medium">
        1 Featured Study
      </span>
    </div>
  </div>

  <!-- Filter Toolbar -->
  <div class="mt-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <!-- Category Tabs Segmented Control -->
    <div
      role="tablist"
      aria-label="Filter projects by category"
      class="inline-flex flex-wrap p-1.5 rounded-xl bg-zinc-100 dark:bg-[#121316] border border-zinc-200 dark:border-white/10 shadow-xs gap-1"
      id="project-filters"
    >
      {categories.map((cat, idx) => {
        const count = getCategoryCount(cat);
        const isActive = idx === 0;
        return (
          <button
            type="button"
            role="tab"
            aria-selected={isActive ? 'true' : 'false'}
            data-category={cat}
            class={`filter-btn group relative px-3.5 py-1.5 rounded-lg text-xs font-mono transition-all duration-200 cursor-pointer flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0284c7] dark:focus-visible:ring-[#38bdf8] ${
              isActive
                ? 'bg-white dark:bg-[#1e222b] text-zinc-950 dark:text-white shadow-xs font-semibold border border-zinc-200 dark:border-white/10'
                : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white hover:bg-white/60 dark:hover:bg-[#1a1d24]/60'
            }`}
          >
            <span>{cat}</span>
            <span
              class={`filter-badge px-1.5 py-0.5 rounded text-xs font-mono transition-colors ${
                isActive
                  ? 'bg-zinc-100 dark:bg-[#14161b] text-[#0284c7] dark:text-[#38bdf8] font-bold'
                  : 'bg-zinc-200/70 dark:bg-[#1e222b] text-zinc-500 dark:text-zinc-400 group-hover:text-zinc-950 dark:group-hover:text-white'
              }`}
            >
              {count}
            </span>
          </button>
        );
      })}
    </div>

    <!-- Active Indicator Text -->
    <div class="hidden lg:flex items-center gap-2 text-xs font-mono text-zinc-500 dark:text-zinc-400">
      <span>Showing:</span>
      <span id="active-category-indicator" class="text-[#0284c7] dark:text-[#38bdf8] font-semibold">All Projects (4)</span>
    </div>
  </div>

  <!-- Projects Container -->
  <div id="projects-grid" class="mt-8 space-y-8 min-h-[400px]">
    
    <!-- 01. Flagship Featured Project Card (PentaDosen - Wide Horizontal Showcase) -->
    {featuredProject && (
      <div class="project-item transition-all duration-300" data-category={featuredProject.category}>
        <article class="project-card group p-6 sm:p-8 lg:p-10 rounded-2xl bg-white dark:bg-[#121316] border border-zinc-200 dark:border-white/10 hover:border-[#0284c7] dark:hover:border-[#38bdf8] hover:shadow-xl dark:hover:shadow-[0_10px_30px_rgba(0,0,0,0.6)] transition-all duration-300 overflow-hidden">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            
            <!-- Left: Large Visual Preview with Browser Mock Chrome (col-span-7) -->
            <div class="lg:col-span-7 flex flex-col">
              <div class="relative w-full aspect-video rounded-xl overflow-hidden border border-zinc-200 dark:border-white/10 bg-[#0e1013] shadow-md group-hover:border-[#0284c7]/40 dark:group-hover:border-[#38bdf8]/40 transition-colors">
                
                <!-- Browser Mock Header Bar -->
                <div class="absolute top-0 inset-x-0 h-7 bg-[#15171c]/95 backdrop-blur-md border-b border-white/10 px-3 flex items-center justify-between z-20">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-[#ef4444]/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-[#eab308]/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-[#22c55e]/80"></span>
                  </div>
                  <span class="text-xs font-mono text-white/60 tracking-wider">pentadosen.yarsi.ac.id</span>
                  <div class="w-8"></div>
                </div>

                <a
                  href={featuredProject.caseStudyUrl}
                  class="block w-full h-full pt-7 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0284c7] dark:focus-visible:ring-[#38bdf8]"
                  aria-label={`Read case study for ${featuredProject.title}`}
                >
                  <img
                    src={featuredProject.image}
                    alt={`Preview of ${featuredProject.title}`}
                    loading="lazy"
                    class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                  />
                </a>

                <!-- Floating Featured Badge -->
                <div class="absolute bottom-3 left-3 px-3 py-1 rounded-md bg-[#0e1013]/85 backdrop-blur-md text-white text-xs font-mono border border-white/15 flex items-center gap-1.5 shadow-md">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
                  <span>Featured Case Study</span>
                </div>
              </div>
            </div>

            <!-- Right: Content & Metadata (col-span-5) -->
            <div class="lg:col-span-5 flex flex-col justify-between h-full space-y-4">
              <div>
                <!-- Category, Timeline & Status Strip -->
                <div class="flex items-center justify-between pb-3 mb-3 border-b border-zinc-100 dark:border-white/5">
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#0284c7] dark:bg-[#38bdf8]"></span>
                    <span class="text-xs font-mono font-medium text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">{featuredProject.category}</span>
                  </div>
                  <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">{featuredProject.year}</span>
                </div>

                <!-- Headline (Plus Jakarta Sans) -->
                <h3 class="font-display text-2xl sm:text-3xl text-zinc-950 dark:text-white font-bold tracking-tight group-hover:text-[#0284c7] dark:group-hover:text-[#38bdf8] transition-colors leading-tight mt-1">
                  <a href={featuredProject.caseStudyUrl} class="hover:underline focus:outline-none focus-visible:ring-1 focus-visible:ring-[#0284c7] dark:focus-visible:ring-[#38bdf8]">
                    {featuredProject.title}
                  </a>
                </h3>

                <!-- Subtitle -->
                <p class="mt-2.5 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                  {featuredProject.subtitle}
                </p>

                <!-- Role Badge -->
                <div class="mt-3.5 inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-zinc-50 dark:bg-[#181a20] border border-zinc-200 dark:border-white/10 text-xs text-zinc-700 dark:text-zinc-300">
                  <span class="text-zinc-500 dark:text-zinc-400 font-mono text-xs">Role:</span>
                  <span class="font-medium text-zinc-950 dark:text-white">{featuredProject.role}</span>
                </div>

                <!-- Context Impact Box -->
                <div class="mt-3.5 p-3.5 rounded-xl bg-zinc-50 dark:bg-[#181a20] border border-zinc-200 dark:border-white/10 text-xs text-zinc-700 dark:text-zinc-300 leading-relaxed">
                  <span class="font-semibold text-[#0284c7] dark:text-[#38bdf8] mr-1 font-mono text-xs uppercase tracking-wider">Context & Outcome:</span>
                  {featuredProject.impact}
                </div>

                <!-- Key Metrics Grid -->
                <div class="mt-4 grid grid-cols-3 gap-2 pt-3.5 border-t border-zinc-100 dark:border-white/5">
                  {featuredProject.metrics.map((metric) => (
                    <div class="flex flex-col">
                      <span class="font-display text-sm sm:text-base text-zinc-950 dark:text-white leading-tight font-semibold">{metric.value}</span>
                      <span class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5 font-mono">{metric.label}</span>
                    </div>
                  ))}
                </div>

                <!-- Tech Stack Tags -->
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {featuredProject.tags.map((tag) => (
                    <span class="px-2 py-0.5 rounded text-xs font-mono bg-zinc-100 dark:bg-[#181a20] text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-white/10 hover:border-[#0284c7]/60 dark:hover:border-[#38bdf8]/60 transition-colors">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Action Links & Indicator -->
              <div class="pt-5 border-t border-zinc-100 dark:border-white/5 flex flex-col gap-3">
                <!-- Row 1: Primary Action (Read Case Study Standalone) -->
                <div>
                  <a
                    href={featuredProject.caseStudyUrl}
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-[#0284c7] hover:bg-[#0369a1] dark:bg-[#38bdf8] dark:hover:bg-[#7dd3fc] active:scale-95 text-white dark:text-[#080808] text-xs sm:text-sm font-semibold transition-all shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0284c7] dark:focus-visible:ring-[#38bdf8]"
                  >
                    <span>Read Case Study</span>
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                  </a>
                </div>

                <!-- Row 2: Secondary Actions (Visit Live Website & GitHub) -->
                <div class="flex flex-wrap items-center justify-between gap-3 pt-0.5">
                  <div class="flex items-center gap-2 sm:gap-2.5">
                    {featuredProject.links.live && (
                      <a
                        href={featuredProject.links.live}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white dark:bg-[#181a20] hover:bg-zinc-50 dark:hover:bg-[#22252c] text-zinc-900 dark:text-white border border-zinc-200 dark:border-white/10 text-xs font-medium transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0284c7] dark:focus-visible:ring-[#38bdf8]"
                      >
                        <svg class="w-3.5 h-3.5 text-[#0284c7] dark:text-[#38bdf8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                        </svg>
                        <span>Visit Live Website</span>
                      </a>
                    )}

                    {featuredProject.links.github && (
                      <a
                        href={featuredProject.links.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="View source code on GitHub"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white dark:bg-[#181a20] hover:bg-zinc-50 dark:hover:bg-[#22252c] text-zinc-900 dark:text-white border border-zinc-200 dark:border-white/10 text-xs font-medium transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0284c7] dark:focus-visible:ring-[#38bdf8]"
                      >
                        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                        </svg>
                        <span>GitHub</span>
                      </a>
                    )}
                  </div>

                  <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">01 · Flagship Showcase</span>
                </div>
              </div>

            </div>

          </div>
        </article>
      </div>
    )}

    <!-- 02, 03, 04. Supporting Projects Grid (Responsive 3 Columns on Large Displays) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="supporting-projects-grid">
      {otherProjects.map((project, idx) => (
        <div class="project-item h-full transition-all duration-300" data-category={project.category}>
          <ProjectCard project={project} index={idx + 1} />
        </div>
      ))}
    </div>

    <!-- Empty State if no project matches filter -->
    <div id="no-projects-msg" class="hidden text-center py-16 px-4 rounded-2xl bg-zinc-50/50 dark:bg-[#121316]/50 border border-dashed border-zinc-200 dark:border-white/10">
      <p class="font-display text-xl text-zinc-950 dark:text-white font-semibold">No projects found in this category.</p>
      <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">Try selecting another filter category above.</p>
      <button
        type="button"
        id="reset-filter-btn"
        class="mt-4 px-3.5 py-1.5 rounded-md bg-[#0284c7] dark:bg-[#38bdf8] text-white dark:text-[#080808] text-xs font-mono font-semibold hover:opacity-90 transition-opacity"
      >
        Reset Filter to All
      </button>
    </div>

  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectItems = document.querySelectorAll<HTMLElement>('.project-item');
  const activeIndicator = document.getElementById('active-category-indicator');
  const noProjectsMsg = document.getElementById('no-projects-msg');
  const resetBtn = document.getElementById('reset-filter-btn');

  function setCategory(selectedCategory: string) {
    let visibleCount = 0;

    // Update button visual states
    filterButtons.forEach((btn) => {
      const isSelected = btn.getAttribute('data-category') === selectedCategory;
      const badge = btn.querySelector('.filter-badge');

      btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');

      if (isSelected) {
        btn.classList.add('bg-white', 'dark:bg-[#1e222b]', 'text-zinc-950', 'dark:text-white', 'shadow-xs', 'font-semibold', 'border', 'border-zinc-200', 'dark:border-white/10');
        btn.classList.remove('text-zinc-600', 'dark:text-zinc-400');
        if (badge) {
          badge.classList.add('bg-zinc-100', 'dark:bg-[#14161b]', 'text-[#0284c7]', 'dark:text-[#38bdf8]', 'font-bold');
          badge.classList.remove('bg-zinc-200/70', 'dark:bg-[#1e222b]', 'text-zinc-500', 'dark:text-zinc-400');
        }
      } else {
        btn.classList.remove('bg-white', 'dark:bg-[#1e222b]', 'text-zinc-950', 'dark:text-white', 'shadow-xs', 'font-semibold', 'border', 'border-zinc-200', 'dark:border-white/10');
        btn.classList.add('text-zinc-600', 'dark:text-zinc-400');
        if (badge) {
          badge.classList.remove('bg-zinc-100', 'dark:bg-[#14161b]', 'text-[#0284c7]', 'dark:text-[#38bdf8]', 'font-bold');
          badge.classList.add('bg-zinc-200/70', 'dark:bg-[#1e222b]', 'text-zinc-500', 'dark:text-zinc-400');
        }
      }
    });

    // Smooth filter items with opacity & transform
    projectItems.forEach((item) => {
      const itemCategory = item.getAttribute('data-category');
      const shouldShow = selectedCategory === 'All' || itemCategory === selectedCategory;

      if (shouldShow) {
        visibleCount++;
        item.style.display = '';
        requestAnimationFrame(() => {
          item.style.opacity = '1';
          item.style.transform = 'translateY(0) scale(1)';
        });
      } else {
        item.style.opacity = '0';
        item.style.transform = 'translateY(8px) scale(0.98)';
        setTimeout(() => {
          if (item.style.opacity === '0') {
            item.style.display = 'none';
          }
        }, 200);
      }
    });

    // Update active text indicator
    if (activeIndicator) {
      activeIndicator.textContent = `${selectedCategory} (${visibleCount})`;
    }

    // Toggle empty state message
    if (noProjectsMsg) {
      if (visibleCount === 0) {
        noProjectsMsg.classList.remove('hidden');
      } else {
        noProjectsMsg.classList.add('hidden');
      }
    }
  }

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const category = btn.getAttribute('data-category') || 'All';
      setCategory(category);
    });
  });

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      setCategory('All');
    });
  }
</script>
