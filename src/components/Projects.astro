---
import { portfolioData } from '../data/portfolioData';
import ProjectCard from './ProjectCard.astro';

const { projects } = portfolioData;
const categories = ['All', 'Web Application', 'System Workflows', 'Mobile Application', 'Scripting & Automation'];

const featuredProject = projects[0]; // PentaDosen
const otherProjects = projects.slice(1);
---

<section id="projects" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-[#e6dfd8] dark:border-[#2e2b26]">
    <div>
      <h2 class="font-display text-3xl sm:text-4xl text-[#141413] dark:text-[#faf9f5] tracking-tight">
        Featured Projects & Case Studies
      </h2>
      <p class="mt-2 text-sm sm:text-base text-[#6c6a64] dark:text-[#a09d96] max-w-[54ch]">
        Selected works spanning university academic platforms, enterprise ERP systems, mobile applications, and automation utilities.
      </p>
    </div>

    <!-- Category Tabs Filter -->
    <div class="flex flex-wrap gap-1.5 p-1 rounded-lg bg-[#efe9de] dark:bg-[#181715] border border-[#e6dfd8] dark:border-[#2e2b26]" id="project-filters">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-category={cat}
          class={`filter-btn px-3 py-1.5 rounded-md text-xs font-mono font-medium transition-all cursor-pointer ${
            idx === 0
              ? 'bg-[#faf9f5] dark:bg-[#252320] text-[#141413] dark:text-[#faf9f5] shadow-xs font-semibold'
              : 'text-[#6c6a64] dark:text-[#a09d96] hover:text-[#141413] dark:hover:text-[#faf9f5]'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>
  </div>

  <!-- Projects Container -->
  <div id="projects-grid" class="mt-10 space-y-8">
    
    <!-- 01. Flagship Featured Project Card (PentaDosen - Wide Horizontal Showcase) -->
    {featuredProject && (
      <div class="project-item" data-category={featuredProject.category}>
        <article class="project-card group p-6 sm:p-8 lg:p-10 rounded-2xl bg-[#efe9de] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2e2b26] hover:border-[#cc785c] dark:hover:border-[#cc785c] transition-all shadow-xs overflow-hidden">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
            
            <!-- Left: Large Visual Preview (col-span-7) -->
            <div class="lg:col-span-7">
              <div class="relative w-full aspect-video rounded-xl overflow-hidden border border-[#e6dfd8] dark:border-[#2e2b26] bg-[#181715] shadow-md">
                <a href={featuredProject.caseStudyUrl} class="block w-full h-full">
                  <img
                    src={featuredProject.image}
                    alt={`Preview of ${featuredProject.title}`}
                    loading="lazy"
                    class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
                  />
                </a>
                <div class="absolute top-3 left-3 px-2.5 py-1 rounded bg-[#181715]/80 backdrop-blur-md text-white text-[11px] font-mono border border-white/10">
                  Featured Case Study
                </div>
              </div>
            </div>

            <!-- Right: Editorial Content & Metadata (col-span-5) -->
            <div class="lg:col-span-5 flex flex-col justify-between h-full space-y-4">
              <div>
                <!-- Category & Year Header -->
                <div class="flex items-center justify-between pb-3 mb-3 border-b border-[#e6dfd8] dark:border-[#2e2b26]">
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#cc785c]"></span>
                    <span class="text-xs font-mono font-medium text-[#6c6a64] dark:text-[#a09d96] uppercase tracking-wider">{featuredProject.category}</span>
                  </div>
                  <span class="text-xs font-mono text-[#8e8b82] dark:text-[#7a7770]">{featuredProject.year}</span>
                </div>

                <!-- Headline -->
                <h3 class="font-display text-2xl sm:text-3xl text-[#141413] dark:text-[#faf9f5] tracking-tight group-hover:text-[#cc785c] dark:group-hover:text-[#cc785c] transition-colors leading-tight mt-1">
                  <a href={featuredProject.caseStudyUrl} class="hover:underline">
                    {featuredProject.title}
                  </a>
                </h3>

                <p class="mt-2 text-xs sm:text-sm text-[#3d3d3a] dark:text-[#a09d96] leading-relaxed">
                  {featuredProject.subtitle}
                </p>

                <!-- Role Badge -->
                <div class="mt-3 inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-[#faf9f5] dark:bg-[#252320] border border-[#e6dfd8] dark:border-[#2e2b26] text-xs text-[#3d3d3a] dark:text-[#d4cfc7]">
                  <span class="text-[#8e8b82] dark:text-[#7a7770] font-mono">Role:</span>
                  <span class="font-medium text-[#141413] dark:text-[#faf9f5]">{featuredProject.role}</span>
                </div>

                <!-- Context Impact Box -->
                <div class="mt-3 p-3 rounded-lg bg-[#faf9f5] dark:bg-[#252320] border border-[#e6dfd8] dark:border-[#2e2b26] text-xs text-[#252523] dark:text-[#d4cfc7] leading-relaxed">
                  <span class="font-semibold text-[#cc785c] mr-1">Context:</span>
                  {featuredProject.impact}
                </div>

                <!-- Key Metrics -->
                <div class="mt-3.5 grid grid-cols-3 gap-2 pt-3 border-t border-[#e6dfd8] dark:border-[#2e2b26]">
                  {featuredProject.metrics.map((metric) => (
                    <div class="flex flex-col">
                      <span class="font-display text-sm sm:text-base text-[#141413] dark:text-[#faf9f5] leading-tight">{metric.value}</span>
                      <span class="text-[10px] text-[#6c6a64] dark:text-[#8e8b82] mt-0.5">{metric.label}</span>
                    </div>
                  ))}
                </div>

                <!-- Tags -->
                <div class="mt-3.5 flex flex-wrap gap-1.5">
                  {featuredProject.tags.map((tag) => (
                    <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-[#e8e0d2] dark:bg-[#252320] text-[#3d3d3a] dark:text-[#d4cfc7] border border-[#e6dfd8]/80 dark:border-[#2e2b26]">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Action Links -->
              <div class="pt-4 border-t border-[#e6dfd8] dark:border-[#2e2b26] flex items-center justify-between gap-3">
                <a
                  href={featuredProject.caseStudyUrl}
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-[#cc785c] hover:bg-[#a9583e] text-white text-xs sm:text-sm font-medium transition-all shadow-xs"
                >
                  <span>Read Case Study</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                  </svg>
                </a>
                <span class="text-xs font-mono text-[#8e8b82] dark:text-[#7a7770]">01 // FEATURED</span>
              </div>

            </div>

          </div>
        </article>
      </div>
    )}

    <!-- 02, 03, 04. Supporting Projects Grid (Responsive 3 Columns on Large Displays) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {otherProjects.map((project, idx) => (
        <div class="project-item h-full" data-category={project.category}>
          <ProjectCard project={project} index={idx + 1} />
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll('.filter-btn');
  const projectItems = document.querySelectorAll('.project-item');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selectedCategory = btn.getAttribute('data-category');

      filterButtons.forEach((b) => {
        b.classList.remove('bg-[#faf9f5]', 'dark:bg-[#252320]', 'text-[#141413]', 'dark:text-[#faf9f5]', 'shadow-xs', 'font-semibold');
        b.classList.add('text-[#6c6a64]', 'dark:text-[#a09d96]');
      });
      btn.classList.remove('text-[#6c6a64]', 'dark:text-[#a09d96]');
      btn.classList.add('bg-[#faf9f5]', 'dark:bg-[#252320]', 'text-[#141413]', 'dark:text-[#faf9f5]', 'shadow-xs', 'font-semibold');

      projectItems.forEach((item) => {
        const itemCategory = item.getAttribute('data-category');
        const htmlItem = item as HTMLElement;

        if (selectedCategory === 'All' || itemCategory === selectedCategory) {
          htmlItem.style.display = 'block';
          htmlItem.style.opacity = '1';
        } else {
          htmlItem.style.display = 'none';
        }
      });
    });
  });
</script>
