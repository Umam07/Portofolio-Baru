---
import { portfolioData } from '../data/portfolioData';

const { experience } = portfolioData;
---

<section id="experience" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <!-- Section Header -->
  <div class="pb-8 border-b border-[#e6dfd8] dark:border-[#2e2b26]">
    <h2 class="font-display text-3xl sm:text-4xl text-[#141413] dark:text-[#faf9f5] tracking-tight">
      Experience & Career Track
    </h2>
    <p class="mt-2 text-sm sm:text-base text-[#6c6a64] dark:text-[#a09d96] max-w-[50ch]">
      Product squads, design systems, and frontend engineering roles I have contributed to.
    </p>
  </div>

  <!-- Timeline Cards List -->
  <div class="mt-10 space-y-6">
    {experience.map((item) => (
      <div class="experience-card group p-6 sm:p-8 rounded-xl bg-[#efe9de] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2e2b26] transition-all duration-200 hover:border-[#cc785c] dark:hover:border-[#cc785c]">
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 pb-4 border-b border-[#e6dfd8] dark:border-[#2e2b26]">
          <div>
            <div class="flex items-center gap-3">
              <h3 class="font-display text-2xl sm:text-3xl text-[#141413] dark:text-[#faf9f5] group-hover:text-[#cc785c] dark:group-hover:text-[#cc785c] transition-colors">
                {item.role}
              </h3>
              <span class="px-2 py-0.5 rounded-full text-[11px] font-mono bg-[#faf9f5] dark:bg-[#252320] text-[#3d3d3a] dark:text-[#d4cfc7] border border-[#e6dfd8] dark:border-[#2e2b26]">
                {item.type}
              </span>
            </div>
            
            <p class="mt-1 text-sm font-medium text-[#3d3d3a] dark:text-[#d4cfc7]">
              {item.company} <span class="text-[#8e8b82] dark:text-[#7a7770] font-normal">· {item.location}</span>
            </p>
          </div>

          <span class="inline-block px-3 py-1 rounded bg-[#faf9f5] dark:bg-[#252320] border border-[#e6dfd8] dark:border-[#2e2b26] text-xs font-mono text-[#6c6a64] dark:text-[#a09d96]">
            {item.period}
          </span>
        </div>

        <p class="mt-4 text-sm text-[#252523] dark:text-[#d4cfc7] leading-relaxed">
          {item.description}
        </p>

        <!-- Highlights -->
        <ul class="mt-4 space-y-2">
          {item.highlights.map((highlight) => (
            <li class="flex items-start gap-2.5 text-xs sm:text-sm text-[#3d3d3a] dark:text-[#a09d96] leading-relaxed">
              <span class="text-[#cc785c] mt-0.5 text-xs">✦</span>
              <span>{highlight}</span>
            </li>
          ))}
        </ul>

        <!-- Skills pills -->
        <div class="mt-6 pt-4 border-t border-[#e6dfd8] dark:border-[#2e2b26] flex flex-wrap gap-1.5">
          {item.skills.map((skill) => (
            <span class="px-2.5 py-0.5 rounded text-[11px] font-mono bg-[#faf9f5] dark:bg-[#252320] text-[#6c6a64] dark:text-[#a09d96] border border-[#e6dfd8] dark:border-[#2e2b26]">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
