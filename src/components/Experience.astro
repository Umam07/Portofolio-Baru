---
import { portfolioData } from '../data/portfolioData';

const { experience } = portfolioData;

const splitHighlight = (highlight: string) => {
  const separator = highlight.indexOf(':');
  return separator === -1
    ? { title: highlight, detail: '' }
    : {
        title: highlight.slice(0, separator),
        detail: highlight.slice(separator + 1).trim(),
      };
};
---

<section id="experience" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28 lg:px-8">
  <div class="mb-9 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="mb-3 font-mono text-xs font-medium uppercase tracking-[0.18em] text-[#123A86]">
        Experience
      </p>
      <h2 class="font-display text-3xl font-semibold leading-tight tracking-[-0.03em] text-[#0E1B3D] sm:text-4xl">
        Work shaped by real workflows.
      </h2>
    </div>
    <p class="max-w-xs text-sm leading-relaxed text-[#2F4166]">
      A concise view of the systems, testing, and documentation I worked on.
    </p>
  </div>

  <div class="relative border-y border-[#B9D4F5]">
    {experience.map((item, index) => (
      <article class="grid gap-8 py-8 lg:grid-cols-[220px_1fr] lg:gap-12 lg:py-10">
        <div class="flex gap-4 lg:block">
          <span class="font-mono text-xs font-medium text-[#123A86]">0{index + 1}</span>
          <div class="mt-0 lg:mt-5">
            <p class="font-mono text-xs leading-relaxed text-[#2F4166]">
              {item.period.replace(' — ', ' - ')}
            </p>
            <p class="mt-2 text-xs text-[#2F4166]">{item.type} · {item.location}</p>
          </div>
        </div>

        <div class="min-w-0">
          <div class="flex flex-col gap-2 border-b border-[#B9D4F5] pb-5 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
            <div>
              <h3 class="font-display text-2xl font-semibold leading-tight tracking-[-0.025em] text-[#0E1B3D]">
                {item.role}
              </h3>
              <p class="mt-1 text-sm font-medium text-[#123A86]">{item.company}</p>
            </div>
            <p class="max-w-md text-sm leading-relaxed text-[#24365C]">{item.description}</p>
          </div>

          <div class="mt-5 grid gap-x-8 gap-y-4 sm:grid-cols-2">
            {item.highlights.map((highlight, highlightIndex) => {
              const content = splitHighlight(highlight);
              return (
                <div class="grid grid-cols-[24px_1fr] gap-3">
                  <span class="pt-0.5 font-mono text-xs text-[#2F4166]">{String(highlightIndex + 1).padStart(2, '0')}</span>
                  <div>
                    <h4 class="text-sm font-medium leading-snug text-[#0E1B3D]">{content.title}</h4>
                    {content.detail && <p class="mt-1 text-xs leading-relaxed text-[#24365C]">{content.detail}</p>}
                  </div>
                </div>
              );
            })}
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-[#B9D4F5] pt-4">
            <span class="font-mono text-xs uppercase tracking-[0.14em] text-[#2F4166]">Tools & methods</span>
            <div class="flex flex-wrap gap-x-3 gap-y-1.5 text-xs text-[#24365C]">
              {item.skills.map((skill) => <span>{skill}</span>)}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
