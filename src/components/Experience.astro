---
import { portfolioData } from '../data/portfolioData';

const { experience } = portfolioData;

const splitHighlight = (highlight: string) => {
  const separator = highlight.indexOf(':');
  return separator === -1
    ? { title: highlight, detail: '' }
    : {
        title: highlight.slice(0, separator),
        detail: highlight.slice(separator + 1).trim(),
      };
};
---

<section id="experience" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28 lg:px-8">
  <div class="mb-10 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="mb-3 font-mono text-xs font-medium uppercase tracking-[0.18em] text-[#123A86]">
        Experience
      </p>
      <h2 class="font-display text-3xl font-semibold leading-tight tracking-[-0.03em] text-[#0E1B3D] sm:text-4xl">
        Work shaped by real workflows.
      </h2>
    </div>
    <p class="max-w-xs text-sm leading-relaxed text-[#2F4166]">
      Chronological timeline of teaching, system analysis, and enterprise testing roles.
    </p>
  </div>

  <ol class="relative space-y-8 border-l-2 border-[#B9D4F5] pl-6 sm:pl-9">
    {experience.map((item, index) => (
      <li class="relative">
        <span
          aria-hidden="true"
          class={`absolute -left-[33px] top-7 flex h-4 w-4 items-center justify-center rounded-full border-2 bg-white sm:-left-[45px] ${
            index === 0 ? 'border-[#1F5FD6] ring-4 ring-[#1F5FD6]/15' : 'border-[#B9D4F5]'
          }`}
        >
          <span class={`h-1.5 w-1.5 rounded-full ${index === 0 ? 'bg-[#1F5FD6]' : 'bg-[#123A86]/60'}`}></span>
        </span>

        <article class="rounded-2xl border border-[#B9D4F5] bg-white p-6 shadow-[0_4px_20px_rgba(31,95,214,0.06)] transition-shadow duration-300 hover:shadow-[0_12px_32px_rgba(31,95,214,0.12)] sm:p-7">
          <div class="flex flex-col gap-3 border-b border-[#B9D4F5] pb-5 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-[#2F4166]">
                <span class="font-semibold text-[#123A86]">{String(index + 1).padStart(2, '0')}</span>
                <span aria-hidden="true">·</span>
                <span>{item.type}</span>
                <span aria-hidden="true">·</span>
                <span>{item.location}</span>
              </div>
              <h3 class="mt-2 font-display text-xl font-semibold leading-tight tracking-[-0.02em] text-[#0E1B3D] sm:text-2xl">
                {item.role}
              </h3>
              <p class="mt-1 text-sm font-medium text-[#123A86]">{item.company}</p>
            </div>

            <span class="inline-flex w-fit shrink-0 items-center rounded-full border border-[#B9D4F5] bg-[#F2F7FF] px-3 py-1 font-mono text-xs font-medium text-[#123A86]">
              {item.period.replace(' — ', ' – ')}
            </span>
          </div>

          <p class="mt-4 text-sm leading-relaxed text-[#24365C]">
            {item.description}
          </p>

          <ul class="mt-5 space-y-3">
            {item.highlights.map((highlight) => {
              const content = splitHighlight(highlight);
              return (
                <li class="flex items-start gap-3 text-sm leading-relaxed">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#1F5FD6]" aria-hidden="true"></span>
                  <div>
                    <span class="font-semibold text-[#0E1B3D]">{content.title}</span>
                    {content.detail && (
                      <span class="text-[#24365C]"> — {content.detail}</span>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>

          <div class="mt-6 flex flex-wrap items-center gap-2 border-t border-[#B9D4F5] pt-4">
            <span class="mr-1 font-mono text-[11px] uppercase tracking-[0.14em] text-[#2F4166]">
              Tools &amp; methods
            </span>
            {item.skills.map((skill) => (
              <span class="rounded-full border border-[#B9D4F5] bg-[#F2F7FF] px-2.5 py-0.5 text-xs font-medium text-[#123A86]">
                {skill}
              </span>
            ))}
          </div>
        </article>
      </li>
    ))}
  </ol>
</section>
