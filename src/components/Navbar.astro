---
import { portfolioData } from '../data/portfolioData';

const navLinks = [
  { label: 'About', href: '#about' },
  { label: 'Works', href: '#projects' },
  { label: 'Skills', href: '#skills' },
  { label: 'Experience', href: '#experience' },
];
---

<!-- Fixed Floating Header Wrapper -->
<header
  id="main-navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-out flex justify-center px-4 sm:px-6 lg:px-8 pointer-events-none"
>
  <div
    id="nav-inner"
    class="w-full max-w-6xl mx-auto h-16 bg-[#faf9f5]/90 dark:bg-[#121110]/90 backdrop-blur-md border-b border-[#e6dfd8] dark:border-[#2e2b26] px-4 sm:px-6 lg:px-8 flex items-center justify-between transition-all duration-300 ease-out pointer-events-auto"
  >
    
    <!-- Brand Logo Mark Only -->
    <a href="#" aria-label="Home" class="group flex items-center text-[#141413] dark:text-[#faf9f5] hover:opacity-85 transition-opacity">
      <svg
        viewBox="0 0 141 141"
        class="w-7 h-7 sm:w-8 sm:h-8 transition-all duration-300 group-hover:scale-110 text-[#141413] dark:text-[#faf9f5]"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path d="M 79.1753 140.756 L 15.1742 140.756 L 79.1753 76.7549 L 79.1753 140.756 Z M 140.756 114.089 L 109.966 140.756 L 109.966 30.7904 L 0 30.7904 L 26.3918 0 L 140.756 0 L 140.756 114.089 Z M 0 112.386 L 0 61.5808 L 50.8052 61.5808 L 0 112.386 Z" />
      </svg>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-6">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-[#3d3d3a] dark:text-[#a09d96] hover:text-[#141413] dark:hover:text-[#faf9f5] transition-colors"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right Cluster: Theme Switcher, Contact CTA & Mobile Menu -->
    <div class="flex items-center gap-2.5 sm:gap-3">
      
      <!-- Theme Switcher Button (Light / Dark) -->
      <button
        id="theme-toggle-btn"
        type="button"
        aria-label="Toggle light and dark theme"
        title="Toggle Theme"
        class="flex items-center justify-center w-8 h-8 rounded-md border border-[#e6dfd8] dark:border-[#2e2b26] text-[#3d3d3a] dark:text-[#faf9f5] bg-[#faf9f5] dark:bg-[#181715] hover:border-[#cc785c] dark:hover:border-[#cc785c] transition-all cursor-pointer shadow-xs active:scale-95"
      >
        <!-- Sun Icon (Visible in Dark Mode) -->
        <svg id="theme-sun-icon" class="w-4 h-4 hidden dark:block text-[#cc785c]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <!-- Moon Icon (Visible in Light Mode) -->
        <svg id="theme-moon-icon" class="w-4 h-4 block dark:hidden text-[#3d3d3a]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>

      <!-- Primary Contact Button -->
      <a
        href="#contact"
        class="inline-flex items-center justify-center px-3.5 sm:px-4 py-2 rounded-md bg-[#cc785c] hover:bg-[#a9583e] active:scale-95 text-white font-medium text-xs sm:text-sm tracking-tight transition-all shadow-xs"
      >
        Contact
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        aria-label="Toggle navigation menu"
        class="md:hidden flex items-center justify-center w-8 h-8 rounded-md border border-[#e6dfd8] dark:border-[#2e2b26] text-[#141413] dark:text-[#faf9f5] bg-[#faf9f5] dark:bg-[#181715]"
      >
        <svg id="menu-icon-open" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="menu-icon-close" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div
  id="mobile-drawer"
  class="fixed inset-0 top-16 z-40 bg-[#faf9f5] dark:bg-[#121110] opacity-0 pointer-events-none transition-all duration-200 md:hidden flex flex-col justify-start px-6 pt-8 border-t border-[#e6dfd8] dark:border-[#2e2b26]"
>
  <nav class="flex flex-col gap-5">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-nav-item text-lg font-medium text-[#141413] dark:text-[#faf9f5] py-2 border-b border-[#e6dfd8]/60 dark:border-[#2e2b26]"
      >
        {link.label}
      </a>
    ))}
    <div class="pt-4 flex flex-col gap-2">
      <span class="text-xs text-[#8e8b82] font-mono">{portfolioData.personal.status}</span>
      <a
        href={`mailto:${portfolioData.personal.email}`}
        class="text-sm font-medium text-[#cc785c] underline font-mono text-xs"
      >
        {portfolioData.personal.email}
      </a>
    </div>
  </nav>
</div>

<script>
  const header = document.getElementById('main-navbar');
  const navInner = document.getElementById('nav-inner');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const navItems = document.querySelectorAll('.mobile-nav-item');
  const themeToggleBtn = document.getElementById('theme-toggle-btn');

  // Theme Toggle Handler
  themeToggleBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Floating on scroll transition
  const handleScroll = () => {
    const scrollY = window.scrollY || window.pageYOffset;
    if (scrollY > 30) {
      header?.classList.add('pt-3', 'sm:pt-4');
      navInner?.classList.remove('max-w-6xl', 'border-b', 'rounded-none', 'h-16', 'px-4', 'lg:px-8');
      navInner?.classList.add('max-w-4xl', 'border', 'rounded-full', 'shadow-md', 'h-14', 'px-5', 'sm:px-6', 'bg-[#faf9f5]/85', 'dark:bg-[#181715]/85');
    } else {
      header?.classList.remove('pt-3', 'sm:pt-4');
      navInner?.classList.remove('max-w-4xl', 'border', 'rounded-full', 'shadow-md', 'h-14', 'px-5', 'sm:px-6', 'bg-[#faf9f5]/85', 'dark:bg-[#181715]/85');
      navInner?.classList.add('max-w-6xl', 'border-b', 'rounded-none', 'h-16', 'px-4', 'lg:px-8');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // Mobile Drawer toggle
  let isOpen = false;

  const toggleMenu = () => {
    isOpen = !isOpen;
    if (isOpen) {
      drawer?.classList.remove('opacity-0', 'pointer-events-none');
      drawer?.classList.add('opacity-100', 'pointer-events-auto');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    } else {
      drawer?.classList.add('opacity-0', 'pointer-events-none');
      drawer?.classList.remove('opacity-100', 'pointer-events-auto');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    }
  };

  menuBtn?.addEventListener('click', toggleMenu);
  navItems.forEach((item) => item.addEventListener('click', toggleMenu));
</script>
