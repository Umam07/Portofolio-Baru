---
import { portfolioData } from '../data/portfolioData';

const navLinks = [
  { label: 'About', href: '#about' },
  { label: 'Projects', href: '#projects' },
  { label: 'Experience', href: '#experience' },
  { label: 'Contact', href: '#contact' },
];
---

<!-- Fixed Floating Header Wrapper -->
<header
  id="main-navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-out flex justify-center px-4 sm:px-6 lg:px-8 pt-3 sm:pt-4 pointer-events-none"
>
  <div
    id="nav-inner"
    class="w-full max-w-4xl mx-auto h-14 bg-white/70 backdrop-blur-xl border border-[#B9D4F5]/70 rounded-full px-5 sm:px-6 flex items-center justify-between transition-all duration-300 ease-out pointer-events-auto shadow-[0_8px_30px_rgba(31,95,214,0.12)]"
  >
    
    <!-- Brand Logo Mark + Wordmark -->
    <a href="/" aria-label="Muhammad Syafi'ul Umam — Home" class="group flex h-11 w-11 items-center justify-center text-[#0E1B3D] hover:opacity-85 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6] rounded-full">
      <svg
        viewBox="0 0 141 141"
        class="w-7 h-7 sm:w-8 sm:h-8 transition-all duration-300 group-hover:scale-110 text-[#0E1B3D]"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path d="M 79.1753 140.756 L 15.1742 140.756 L 79.1753 76.7549 L 79.1753 140.756 Z M 140.756 114.089 L 109.966 140.756 L 109.966 30.7904 L 0 30.7904 L 26.3918 0 L 140.756 0 L 140.756 114.089 Z M 0 112.386 L 0 61.5808 L 50.8052 61.5808 L 0 112.386 Z" />
      </svg>
    </a>

    <!-- Desktop Navigation Links -->
    <nav aria-label="Main Navigation" class="hidden md:flex items-center gap-6">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-nav-href={link.href}
          class="desktop-nav-link text-sm font-medium text-[#24365C] hover:text-[#0E1B3D] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6] rounded-full px-2.5 py-1"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right Cluster: Mobile Menu (Resume lives in the hero + contact sections) -->
    <div class="flex items-center gap-2 sm:gap-2.5">
      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        class="md:hidden flex items-center justify-center w-11 h-11 rounded-full border border-[#B9D4F5] text-[#0E1B3D] bg-white shadow-[0_4px_16px_rgba(31,95,214,0.12)] transition-colors hover:border-[#123A86] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6]"
      >
        <svg id="menu-icon-open" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="menu-icon-close" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- Mobile Navigation Drawer: dropdown panel under the pill + scrim -->
<div
  id="mobile-drawer"
  class="pointer-events-none fixed inset-0 z-40 md:hidden"
>
  <div id="mobile-scrim" class="absolute inset-0 bg-[#0E1B3D]/25 backdrop-blur-[2px]"></div>

  <div
    id="mobile-panel"
    class="absolute inset-x-4 top-[68px] origin-top rounded-3xl border border-[#B9D4F5]/80 bg-white/95 p-3 shadow-[0_24px_60px_rgba(14,27,61,0.18)] backdrop-blur-xl sm:inset-x-6 sm:top-[72px]"
  >
    <nav aria-label="Mobile Navigation" class="flex flex-col gap-1">
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          data-nav-href={link.href}
          style={`--d: ${120 + i * 55}ms`}
          class="mobile-nav-item drawer-item group flex items-center gap-4 rounded-2xl px-4 py-3 transition-colors hover:bg-[#F2F7FF] focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#1F5FD6]"
        >
          <span class="font-mono text-xs font-medium text-[#2F4166]">0{i + 1}</span>
          <span class="drawer-label flex-1 font-display text-xl font-semibold tracking-tight text-[#0E1B3D] transition-colors">
            {link.label}
          </span>
          <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#B9D4F5] text-[#123A86] transition-all group-hover:border-[#123A86] group-hover:bg-[#123A86] group-hover:text-white" aria-hidden="true">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17 17 7m0 0H8m9 0v9"></path>
            </svg>
          </span>
        </a>
      ))}
    </nav>

    <div class="drawer-item mt-2 rounded-2xl border border-[#B9D4F5] bg-[#F2F7FF] p-4" style="--d: 350ms">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-[#2F4166]">
        Email
      </p>
      <a
        href={`mailto:${portfolioData.personal.email}`}
        class="mt-1 block min-h-11 truncate py-3 font-mono text-xs font-medium text-[#123A86]"
      >
        {portfolioData.personal.email}
      </a>
    </div>
  </div>
</div>

<style>
  #mobile-scrim {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  #mobile-panel {
    opacity: 0;
    translate: 0 -12px;
    scale: 0.98;
    pointer-events: none;
    transition:
      opacity 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      translate 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      scale 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #mobile-drawer .drawer-item {
    opacity: 0;
    translate: 12px 0;
    transition:
      opacity 0.3s ease,
      translate 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #mobile-drawer.drawer-open #mobile-scrim {
    opacity: 1;
    pointer-events: auto;
  }
  #mobile-drawer.drawer-open #mobile-panel {
    opacity: 1;
    translate: 0 0;
    scale: 1;
    pointer-events: auto;
  }
  #mobile-drawer.drawer-open .drawer-item {
    opacity: 1;
    translate: 0 0;
    transition-delay: var(--d, 0ms);
  }
  .mobile-nav-item.nav-active {
    background: #f2f7ff;
  }
  .mobile-nav-item.nav-active .drawer-label {
    color: #123A86;
  }
</style>

<script>
  // Idempotent: the header DOM is swapped on every View Transition,
  // so re-bind on each page-load and drop the previous scroll handler.
  function initNavbar() {
    const navInner = document.getElementById('nav-inner');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-drawer');
    const scrim = document.getElementById('mobile-scrim');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    const navItems = document.querySelectorAll('.mobile-nav-item');
    const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('.desktop-nav-link');
    const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-item[data-nav-href]');
    if (!navInner) return;

    // Floating pill depth feedback on scroll & Scrollspy
    const handleScroll = () => {
      const scrollY = window.scrollY || window.pageYOffset;
      if (scrollY > 30) {
        navInner?.classList.add('bg-white/85', 'shadow-[0_12px_40px_rgba(31,95,214,0.18)]');
        navInner?.classList.remove('bg-white/70', 'shadow-[0_8px_30px_rgba(31,95,214,0.12)]');
      } else {
        navInner?.classList.add('bg-white/70', 'shadow-[0_8px_30px_rgba(31,95,214,0.12)]');
        navInner?.classList.remove('bg-white/85', 'shadow-[0_12px_40px_rgba(31,95,214,0.18)]');
      }

      // Scrollspy section detection
      const sections = document.querySelectorAll<HTMLElement>('section[id]');
      const scrollPosition = scrollY + 180;
      let activeId = '';

      sections.forEach((section) => {
        const top = section.offsetTop;
        const height = section.offsetHeight;
        if (scrollPosition >= top && scrollPosition < top + height) {
          activeId = `#${section.id}`;
        }
      });

      if (window.innerHeight + scrollY >= document.documentElement.scrollHeight - 50) {
        activeId = '#contact';
      }

      desktopLinks.forEach((link) => {
        const href = link.getAttribute('data-nav-href');
        if (href === activeId) {
          link.classList.add('bg-[#DCEBFF]', 'text-[#123A86]', 'font-semibold');
          link.classList.remove('text-[#24365C]');
        } else {
          link.classList.remove('bg-[#DCEBFF]', 'text-[#123A86]', 'font-semibold');
          link.classList.add('text-[#24365C]');
        }
      });

      mobileLinks.forEach((link) => {
        const href = link.getAttribute('data-nav-href');
        link.classList.toggle('nav-active', href === activeId && activeId !== '');
      });
    };

    const w = window as unknown as { __navScrollHandler?: () => void };
    if (w.__navScrollHandler) {
      window.removeEventListener('scroll', w.__navScrollHandler);
    }
    w.__navScrollHandler = handleScroll;
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // Mobile Drawer toggle (dropdown panel + scrim, staggered via .drawer-open)
    let isOpen = drawer?.classList.contains('drawer-open') ?? false;

    const setMenu = (open: boolean) => {
      isOpen = open;
      drawer?.classList.toggle('drawer-open', open);
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      menuBtn?.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    };

    const toggleMenu = () => setMenu(!isOpen);
    const closeMenu = () => {
      if (isOpen) setMenu(false);
    };

    if (menuBtn && !(menuBtn as HTMLButtonElement & { __navBound?: boolean }).__navBound) {
      (menuBtn as HTMLButtonElement & { __navBound?: boolean }).__navBound = true;
      menuBtn.addEventListener('click', toggleMenu);
    }
    if (scrim && !(scrim as HTMLElement & { __navBound?: boolean }).__navBound) {
      (scrim as HTMLElement & { __navBound?: boolean }).__navBound = true;
      scrim.addEventListener('click', closeMenu);
    }
    navItems.forEach((item) => {
      if ((item as HTMLElement & { __navBound?: boolean }).__navBound) return;
      (item as HTMLElement & { __navBound?: boolean }).__navBound = true;
      item.addEventListener('click', closeMenu);
    });

    // Escape closes the menu; always close before a View Transition swap.
    // Registered once per session — closeMenu is refreshed to the latest DOM.
    const globals = window as unknown as {
      __closeMobileMenu?: () => void;
      __navKeyHandler?: (e: KeyboardEvent) => void;
      __navSwapHandler?: () => void;
    };
    globals.__closeMobileMenu = closeMenu;
    if (!globals.__navKeyHandler) {
      globals.__navKeyHandler = (e: KeyboardEvent) => {
        if (e.key === 'Escape') globals.__closeMobileMenu?.();
      };
      document.addEventListener('keydown', globals.__navKeyHandler);
    }
    if (!globals.__navSwapHandler) {
      globals.__navSwapHandler = () => globals.__closeMobileMenu?.();
      document.addEventListener('astro:before-swap', globals.__navSwapHandler);
    }
  }

  initNavbar();
  document.addEventListener('astro:page-load', initNavbar);
</script>
