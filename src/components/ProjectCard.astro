---
import type { Project } from '../data/portfolioData';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;

// Category colors for visual accentuation
const categoryThemes: Record<string, { dot: string; badge: string; text: string }> = {
  'Web Application': { dot: 'bg-[#cc785c]', badge: 'bg-[#cc785c]/10 text-[#cc785c]', text: 'text-[#cc785c]' },
  'System Workflows': { dot: 'bg-[#e8a55a]', badge: 'bg-[#e8a55a]/10 text-[#e8a55a]', text: 'text-[#e8a55a]' },
  'Mobile Application': { dot: 'bg-[#5db8a6]', badge: 'bg-[#5db8a6]/10 text-[#5db8a6]', text: 'text-[#5db8a6]' },
  'Scripting & Automation': { dot: 'bg-[#7c88cd]', badge: 'bg-[#7c88cd]/10 text-[#7c88cd]', text: 'text-[#7c88cd]' },
};

const currentTheme = categoryThemes[project.category] || { dot: 'bg-[#cc785c]', badge: 'bg-[#cc785c]/10 text-[#cc785c]', text: 'text-[#cc785c]' };
---

<article class="project-card group flex flex-col justify-between h-full p-6 sm:p-7 rounded-2xl bg-[#efe9de] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2e2b26] transition-all duration-300 hover:border-[#cc785c] dark:hover:border-[#cc785c] hover:shadow-lg dark:hover:shadow-black/30 overflow-hidden">
  
  <div>
    <!-- Visual Preview Image Frame with Inner Bezel -->
    {project.image && (
      <div class="relative w-full aspect-video rounded-xl overflow-hidden border border-[#e6dfd8] dark:border-[#2e2b26] bg-[#181715] mb-5 group-hover:border-[#cc785c]/40 transition-colors shadow-xs">
        {project.caseStudyUrl ? (
          <a href={project.caseStudyUrl} class="block w-full h-full cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#cc785c]">
            <img
              src={project.image}
              alt={`Visual showcase of ${project.title}`}
              loading="lazy"
              class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
            />
          </a>
        ) : (
          <img
            src={project.image}
            alt={`Visual showcase of ${project.title}`}
            loading="lazy"
            class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
          />
        )}
        
        <!-- Category Badge Overlay on Image -->
        <div class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-[#181715]/80 backdrop-blur-md border border-white/10 text-white text-[10.5px] font-mono flex items-center gap-1.5 shadow-xs">
          <span class={`w-1.5 h-1.5 rounded-full ${currentTheme.dot}`}></span>
          <span>{project.category}</span>
        </div>

        <div class="absolute inset-0 ring-1 ring-inset ring-black/5 dark:ring-white/5 rounded-xl pointer-events-none"></div>
      </div>
    )}

    <!-- Category & Timeline Meta Strip -->
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-[#e6dfd8] dark:border-[#2e2b26]">
      <div class="flex items-center gap-2">
        <span class={`w-1.5 h-1.5 rounded-full ${currentTheme.dot}`}></span>
        <span class="text-xs font-mono font-medium text-[#6c6a64] dark:text-[#a09d96] uppercase tracking-wider">{project.category}</span>
      </div>
      <span class="text-xs font-mono text-[#8e8b82] dark:text-[#7a7770]">{project.year}</span>
    </div>

    <!-- Editorial Serif Title -->
    <h3 class="font-display text-2xl text-[#141413] dark:text-[#faf9f5] tracking-tight group-hover:text-[#cc785c] dark:group-hover:text-[#cc785c] transition-colors leading-snug">
      {project.caseStudyUrl ? (
        <a href={project.caseStudyUrl} class="hover:underline focus:outline-none focus-visible:ring-1 focus-visible:ring-[#cc785c]">
          {project.title}
        </a>
      ) : (
        project.title
      )}
    </h3>
    
    <!-- Subtitle -->
    <p class="mt-2.5 text-xs sm:text-sm text-[#3d3d3a] dark:text-[#a09d96] leading-relaxed">
      {project.subtitle}
    </p>

    <!-- Engineering Role Pill -->
    <div class="mt-3.5 inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-[#faf9f5] dark:bg-[#252320] border border-[#e6dfd8] dark:border-[#2e2b26] text-xs text-[#3d3d3a] dark:text-[#d4cfc7]">
      <span class="text-[#8e8b82] dark:text-[#7a7770] font-mono text-[11px]">Role:</span>
      <span class="font-medium text-[#141413] dark:text-[#faf9f5]">{project.role}</span>
    </div>

    <!-- Context & Outcome Box -->
    <div class="mt-3.5 p-3 rounded-xl bg-[#faf9f5] dark:bg-[#252320] border border-[#e6dfd8] dark:border-[#2e2b26] text-xs text-[#252523] dark:text-[#d4cfc7] leading-relaxed">
      <span class="font-semibold text-[#cc785c] mr-1 font-mono text-[11px] uppercase tracking-wider">Outcome:</span>
      {project.impact}
    </div>

    <!-- 3-Column Key Metrics -->
    {project.metrics && project.metrics.length > 0 && (
      <div class="mt-4 grid grid-cols-3 gap-2 pt-3 border-t border-[#e6dfd8] dark:border-[#2e2b26]">
        {project.metrics.map((metric) => (
          <div class="flex flex-col">
            <span class="font-display text-sm sm:text-base text-[#141413] dark:text-[#faf9f5] leading-tight font-medium truncate">{metric.value}</span>
            <span class="text-[10px] text-[#6c6a64] dark:text-[#8e8b82] mt-0.5 font-mono truncate">{metric.label}</span>
          </div>
        ))}
      </div>
    )}

    <!-- Tech Stack Monospace Badges -->
    <div class="mt-4 flex flex-wrap gap-1.5">
      {project.tags.map((tag) => (
        <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-[#e8e0d2] dark:bg-[#252320] text-[#3d3d3a] dark:text-[#d4cfc7] border border-[#e6dfd8]/80 dark:border-[#2e2b26] hover:border-[#cc785c]/60 transition-colors">
          {tag}
        </span>
      ))}
    </div>
  </div>

  <!-- Bottom Action Links & Index Marker -->
  <div class="mt-6 pt-4 border-t border-[#e6dfd8] dark:border-[#2e2b26] flex items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2">
      {project.caseStudyUrl ? (
        <a
          href={project.caseStudyUrl}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-[#cc785c] hover:bg-[#a9583e] text-white text-xs font-medium transition-all shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-[#cc785c]"
        >
          <span>Read Case Study</span>
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      ) : project.links.live ? (
        <a
          href={project.links.live}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-[#cc785c] hover:bg-[#a9583e] text-white text-xs font-medium transition-all shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-[#cc785c]"
        >
          <span>Live Demo</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>
      ) : null}

      {project.links.github && (
        <a
          href={project.links.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View ${project.title} on GitHub`}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-[#faf9f5] dark:bg-[#252320] hover:bg-[#f5f0e8] dark:hover:bg-[#2e2b26] text-[#141413] dark:text-[#faf9f5] border border-[#e6dfd8] dark:border-[#2e2b26] text-xs font-medium transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#cc785c]"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>GitHub</span>
        </a>
      )}

      {project.links.figma && (
        <a
          href={project.links.figma}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View ${project.title} on Figma`}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-[#faf9f5] dark:bg-[#252320] hover:bg-[#f5f0e8] dark:hover:bg-[#2e2b26] text-[#141413] dark:text-[#faf9f5] border border-[#e6dfd8] dark:border-[#2e2b26] text-xs font-medium transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[#cc785c]"
        >
          <span>Figma</span>
        </a>
      )}
    </div>

    <span class="text-xs font-mono text-[#8e8b82] dark:text-[#7a7770]">0{index + 1}</span>
  </div>
</article>
