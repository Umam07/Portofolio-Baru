---
import type { Project } from '../data/portfolioData';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const actionHref = project.caseStudyUrl || project.links.live || project.links.github;
const actionLabel = project.caseStudyUrl ? 'Read case study' : project.links.live ? 'Open live site' : 'View on GitHub';
const number = String(index + 1).padStart(2, '0');
---

<article class="project-card group relative flex h-full flex-col overflow-hidden rounded-3xl border border-[#B9D4F5] bg-white transition-all duration-300 hover:-translate-y-1 hover:border-[#1F5FD6]/50 hover:shadow-[0_18px_45px_rgba(31,95,214,0.16)]">
  <a
    href={actionHref}
    target={project.caseStudyUrl ? undefined : '_blank'}
    rel={project.caseStudyUrl ? undefined : 'noopener noreferrer'}
    class="flex h-full flex-col focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#1F5FD6]"
    aria-label={`${actionLabel}: ${project.title}`}
  >
    <span class="relative block aspect-[16/10] overflow-hidden bg-[#F2F7FF]">
      <img
        src={project.image}
        alt={`Preview of ${project.title}`}
        loading="lazy"
        transition:name={project.caseStudyUrl ? `project-image-${project.id}` : undefined}
        class="h-full w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.05]"
      />
      <span class="absolute left-4 top-4 rounded-full bg-white/85 px-2.5 py-1 font-mono text-xs uppercase tracking-[0.12em] text-[#0E1B3D] backdrop-blur-sm">
        {number}
      </span>
    </span>

    <span class="flex flex-1 flex-col p-6">
      <span class="font-mono text-xs uppercase tracking-[0.12em] text-[#2F4166]">
        {project.year} · {project.category}
      </span>
      <span class="mt-2 block font-display text-xl font-semibold tracking-tight text-[#0E1B3D]">
        {project.title.split(' — ')[0]}
      </span>
      <span class="mt-2 block text-sm leading-relaxed text-[#24365C] line-clamp-2">
        {project.summary}
      </span>
      <span class="mt-4 flex flex-wrap gap-1.5">
        {project.tags.slice(0, 3).map((tag) => (
          <span class="rounded-md border border-[#B9D4F5] bg-[#F2F7FF] px-2 py-0.5 font-mono text-xs text-[#24365C]">
            {tag}
          </span>
        ))}
      </span>
      <span class="mt-auto flex items-center justify-between pt-5">
        <span class="text-sm font-semibold text-[#123A86]">
          {actionLabel}
        </span>
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-[#B9D4F5] text-[#123A86] transition-all group-hover:border-[#1F5FD6] group-hover:bg-[#1F5FD6] group-hover:text-white" aria-hidden="true">
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17 17 7m0 0H8m9 0v9"></path>
          </svg>
        </span>
      </span>
    </span>
  </a>
</article>
