---
import { portfolioData } from '../data/portfolioData';

const { personal } = portfolioData;
const rotatingWords = ['clarity.', 'precision.', 'ease.'];
---

<section id="hero" class="relative flex min-h-[100dvh] flex-col justify-center overflow-hidden pb-10 pt-28 sm:pt-32">
  <div class="relative mx-auto grid w-full max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.02fr_0.98fr] lg:gap-10 lg:px-8">

    <!-- Copy column -->
    <div class="flex flex-col items-start">
      <h1 class="hero-reveal max-w-xl font-display text-[2.75rem] font-semibold leading-[1.0] tracking-[-0.045em] text-[#0E1B3D] sm:text-6xl lg:text-[4.2rem]">
        I build interfaces with
        <span class="rotator text-[#123A86]">
          <span class="rotator-stack" aria-hidden="true">
            {rotatingWords.map((word, i) => (
              <span class="rotator-word" style={`animation-delay: ${i * 4}s`}>{word}</span>
            ))}
          </span>
          <span class="sr-only">clarity.</span>
        </span>
      </h1>

      <p class="hero-reveal mt-6 max-w-[42ch] text-base leading-relaxed text-[#24365C] sm:text-lg">
        I&rsquo;m {personal.preferredName} &mdash; frontend developer &amp; UI/UX designer crafting dependable, human-centered web apps.
      </p>

      <div class="hero-reveal mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#projects"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-[#1F5FD6] px-5 py-3 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:bg-[#123A86] active:translate-y-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6]"
        >
          <span>View selected work</span>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14m-6-6 6 6-6 6"></path>
          </svg>
        </a>

        <a
          href={personal.resumeUrl}
          download="Muhammad Syafi'ul Umam_CV.pdf"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-[#B9D4F5] bg-white px-5 py-3 text-sm font-medium text-[#0E1B3D] transition-colors hover:border-[#1F5FD6] hover:bg-[#F2F7FF] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6]"
        >
          <span>Download resume</span>
          <svg class="h-4 w-4 text-[#123A86]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"></path>
          </svg>
        </a>
      </div>

    </div>

    <!-- Visual column: quiet gallery portrait -->
    <div class="hero-reveal relative mx-auto w-full max-w-xs sm:max-w-sm lg:max-w-[380px]">
      <!-- Offset hairline frame -->
      <div aria-hidden="true" class="absolute -inset-3 rounded-[2.4rem] border border-[#1F5FD6]/20"></div>

      <!-- White mat print -->
      <figure class="relative rounded-[2rem] border border-[#B9D4F5] bg-white p-3 shadow-[0_24px_60px_rgba(31,95,214,0.18)]">
        <img
          src="/images/hero/umam-portrait.webp"
          alt="Portrait of Muhammad Syafi'ul Umam"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-[440px] w-full rounded-[1.4rem] bg-[#F2F7FF] object-cover object-top sm:h-[500px] lg:h-[540px]"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  /* Kinetic word rotator: words stacked in one grid cell and crossfaded.
     No fixed-height window, so nothing can ever clip or bleed —
     descenders render in full and the cell sizes to the tallest word.
     Transform + opacity only; CSS-driven so it survives View Transitions. */
  .rotator {
    display: inline-block;
    vertical-align: bottom;
  }
  .rotator-stack {
    display: inline-grid;
  }
  .rotator-word {
    grid-area: 1 / 1;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(0.35em);
    animation: hero-word 12s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes hero-word {
    0% { opacity: 0; transform: translateY(0.35em); }
    4%, 29% { opacity: 1; transform: translateY(0); }
    33%, 100% { opacity: 0; transform: translateY(-0.35em); }
  }
  @media (prefers-reduced-motion: reduce) {
    .rotator-word {
      animation: none !important;
      opacity: 0;
      transform: none;
    }
    .rotator-word:first-child {
      opacity: 1;
    }
  }
</style>
