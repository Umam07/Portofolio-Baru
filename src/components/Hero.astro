---
import { portfolioData } from '../data/portfolioData';
import { HeroInteractiveStudio } from './ui/HeroInteractiveStudio';

const { personal } = portfolioData;
---

<section id="hero" class="pt-24 pb-16 md:pt-32 md:pb-24 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
    
    <!-- Left Column: Editorial Headline & Actions (col-span-12 lg:col-span-6) -->
    <div class="lg:col-span-6 flex flex-col items-start">
      
      <!-- Availability Pill -->
      <div class="hero-reveal mb-5 inline-flex items-center gap-2.5 px-3 py-1 rounded-full bg-zinc-100 dark:bg-[#121316] text-zinc-900 dark:text-zinc-200 text-xs font-mono font-medium border border-zinc-200 dark:border-white/10 shadow-2xs">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10b981] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[#10b981]"></span>
        </span>
        <span>Fresh Graduate · Open for Opportunities</span>
      </div>

      <!-- Display Headline with User's Name -->
      <h1 class="hero-reveal font-display text-4xl sm:text-5xl text-zinc-950 dark:text-white font-bold leading-[1.15] tracking-tight pb-1">
        Hi, I'm <span class="text-[#0284c7] dark:text-[#38bdf8]">Muhammad Syafi'ul Umam</span>.
      </h1>

      <!-- Concise Portfolio Welcoming Copy -->
      <p class="hero-reveal mt-5 text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-[48ch]">
        Welcome to my personal portfolio. I am a fresh graduate with a strong focus on <strong class="text-zinc-950 dark:text-white font-semibold">Software Development</strong>, <strong class="text-zinc-950 dark:text-white font-semibold">UI/UX Design</strong>, and <strong class="text-zinc-950 dark:text-white font-semibold">Cyber Security</strong>. Here, I document my journey in technology, share hands-on milestones, and showcase the digital products I've engineered along the way.
      </p>

      <!-- Action Buttons -->
      <div class="hero-reveal mt-8 flex flex-wrap items-center gap-3.5">
        <a
          href="#projects"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-md bg-[#0284c7] hover:bg-[#0369a1] dark:bg-[#38bdf8] dark:hover:bg-[#7dd3fc] text-white dark:text-[#080808] font-semibold text-sm transition-all shadow-xs dark:shadow-[0_0_20px_rgba(56,189,248,0.25)] active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0284c7] dark:focus-visible:ring-[#38bdf8]"
        >
          Explore Works
        </a>

        <a
          href={personal.resumeUrl}
          download="Resume_Muhammad_Syafiul_Umam.pdf"
          aria-label="Download Resume (PDF)"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-md bg-white dark:bg-[#121316] hover:bg-zinc-50 dark:hover:bg-[#1a1c22] text-zinc-900 dark:text-white border border-zinc-200 dark:border-white/10 text-sm font-medium transition-all shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0284c7] dark:focus-visible:ring-[#38bdf8]"
        >
          <svg class="w-4 h-4 text-[#0284c7] dark:text-[#38bdf8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
          <span>Download Resume</span>
        </a>

        <a
          href="#contact"
          class="group inline-flex items-center gap-1.5 px-3 py-2 text-zinc-600 dark:text-zinc-400 hover:text-[#0284c7] dark:hover:text-[#38bdf8] text-sm font-medium transition-colors"
        >
          <span>Get in touch</span>
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Right Column: Interactive Design Engineering Studio (col-span-12 lg:col-span-6) -->
    <div class="hero-reveal lg:col-span-6 w-full flex items-center justify-center relative">
      <HeroInteractiveStudio client:load />
    </div>

  </div>
</section>
