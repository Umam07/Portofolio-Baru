---
import { portfolioData } from '../data/portfolioData';

const { personal } = portfolioData;
---

<section id="hero" class="pt-24 pb-16 md:pt-32 md:pb-24 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
    
    <!-- Left Column: Editorial Headline & Actions (col-span-7) -->
    <div class="lg:col-span-7 flex flex-col items-start">
      
      <!-- Category Badge Pill -->
      <div class="hero-reveal mb-5 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#efe9de] text-[#141413] text-xs font-medium border border-[#e6dfd8]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#cc785c]"></span>
        <span>{personal.role}</span>
      </div>

      <!-- Serif Display Headline (Copernicus / Newsreader style, weight 400, negative tracking) -->
      <h1 class="hero-reveal font-display text-4xl sm:text-5xl lg:text-[56px] text-[#141413] leading-[1.12] tracking-tight pb-1">
        Engineering thoughtful digital interfaces with editorial craft.
      </h1>

      <!-- Body Copy (StyreneB / Inter, muted ink) -->
      <p class="hero-reveal mt-5 text-base sm:text-lg text-[#3d3d3a] leading-relaxed max-w-[48ch]">
        {personal.subtext}
      </p>

      <!-- Action Buttons (Coral primary + Cream secondary hairline) -->
      <div class="hero-reveal mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#projects"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-md bg-[#cc785c] hover:bg-[#a9583e] active:scale-95 text-white font-medium text-sm transition-all shadow-xs"
        >
          Explore Selected Works
        </a>

        <a
          href="#contact"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-md bg-[#faf9f5] hover:bg-[#f5f0e8] text-[#141413] border border-[#e6dfd8] text-sm font-medium transition-all"
        >
          Get in Touch
        </a>
      </div>

      <!-- Metric Stats Banner -->
      <div class="hero-reveal mt-12 pt-8 border-t border-[#e6dfd8] w-full grid grid-cols-2 sm:grid-cols-4 gap-4">
        {personal.stats.map((stat) => (
          <div class="flex flex-col">
            <span class="font-display text-2xl sm:text-3xl text-[#141413]">{stat.value}</span>
            <span class="text-xs text-[#6c6a64] mt-0.5">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Right Column: Claude-style Interactive Code Window Card (col-span-5) -->
    <div class="hero-reveal lg:col-span-5 w-full">
      <div class="rounded-xl bg-[#181715] text-[#faf9f5] p-5 sm:p-6 border border-[#252320] shadow-xl relative overflow-hidden">
        <!-- Terminal Header with Tabs -->
        <div class="flex items-center justify-between pb-3 mb-4 border-b border-[#252320]">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#3d3d3a]"></span>
            <span class="w-3 h-3 rounded-full bg-[#3d3d3a]"></span>
            <span class="w-3 h-3 rounded-full bg-[#3d3d3a]"></span>
          </div>
          
          <div class="flex items-center gap-1 bg-[#1f1e1b] p-1 rounded-md border border-[#252320]" id="hero-code-tabs">
            <button
              type="button"
              data-tab="config"
              class="hero-tab-btn px-2.5 py-0.5 rounded text-[11px] font-mono transition-colors bg-[#252320] text-[#cc785c] font-medium"
            >
              tokens.config.ts
            </button>
            <button
              type="button"
              data-tab="tokens"
              class="hero-tab-btn px-2.5 py-0.5 rounded text-[11px] font-mono transition-colors text-[#a09d96] hover:text-[#faf9f5]"
            >
              theme.json
            </button>
          </div>
        </div>

        <!-- Code Block Content 1: TypeScript Config -->
        <div id="code-content-config" class="hero-code-block">
          <pre class="font-code text-xs sm:text-[13px] leading-relaxed text-[#e6dfd8] overflow-x-auto"><code><span class="text-[#cc785c]">export const</span> <span class="text-[#5db8a6]">designEngineer</span> = &#123;
  <span class="text-[#a09d96]">name:</span> <span class="text-[#e8a55a]">"{personal.name}"</span>,
  <span class="text-[#a09d96]">specialization:</span> [
    <span class="text-[#e8a55a]">"Figma Design Systems"</span>,
    <span class="text-[#e8a55a]">"Modern Frontend & Astro"</span>,
    <span class="text-[#e8a55a]">"GSAP & Kinetic Motion"</span>,
  ],
  <span class="text-[#a09d96]">principles:</span> &#123;
    <span class="text-[#a09d96]">craft:</span> <span class="text-[#5db872]">"Editorial & Accessible"</span>,
    <span class="text-[#a09d96]">performance:</span> <span class="text-[#5db872]">"100/100 CWV"</span>,
    <span class="text-[#a09d96]">tokenDrift:</span> <span class="text-[#cc785c]">0.0</span>,
  &#125;
&#125;;</code></pre>
        </div>

        <!-- Code Block Content 2: JSON Theme Tokens -->
        <div id="code-content-tokens" class="hero-code-block hidden">
          <pre class="font-code text-xs sm:text-[13px] leading-relaxed text-[#e6dfd8] overflow-x-auto"><code>&#123;
  <span class="text-[#5db8a6]">"canvas"</span>: <span class="text-[#e8a55a]">"#faf9f5"</span>,
  <span class="text-[#5db8a6]">"primary"</span>: <span class="text-[#cc785c]">"#cc785c"</span>,
  <span class="text-[#5db8a6]">"surfaceDark"</span>: <span class="text-[#e8a55a]">"#181715"</span>,
  <span class="text-[#5db8a6]">"display"</span>: <span class="text-[#5db872]">"Newsreader, serif"</span>,
  <span class="text-[#5db8a6]">"body"</span>: <span class="text-[#5db872]">"Inter, sans-serif"</span>,
  <span class="text-[#5db8a6]">"motion"</span>: <span class="text-[#e8a55a]">"lenis + gsap"</span>
&#125;</code></pre>
        </div>

        <!-- Status Bottom Bar -->
        <div class="mt-5 pt-4 border-t border-[#252320] flex items-center justify-between text-xs font-mono text-[#a09d96]">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#5db872] animate-pulse"></span>
            <span>TypeScript Ready</span>
          </div>
          <span class="text-[#cc785c]">Synced with Figma API</span>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll('.hero-tab-btn');
  const codeConfig = document.getElementById('code-content-config');
  const codeTokens = document.getElementById('code-content-tokens');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab');

      tabBtns.forEach((b) => {
        b.classList.remove('bg-[#252320]', 'text-[#cc785c]', 'font-medium');
        b.classList.add('text-[#a09d96]');
      });

      btn.classList.remove('text-[#a09d96]');
      btn.classList.add('bg-[#252320]', 'text-[#cc785c]', 'font-medium');

      if (tab === 'config') {
        codeConfig?.classList.remove('hidden');
        codeTokens?.classList.add('hidden');
      } else {
        codeConfig?.classList.add('hidden');
        codeTokens?.classList.remove('hidden');
      }
    });
  });
</script>
