---
import { portfolioData } from '../data/portfolioData';

const { personal } = portfolioData;
---

<section id="hero" class="relative w-full min-h-[100dvh] flex flex-col justify-between pt-24 sm:pt-28 pb-8 overflow-hidden">
  <!-- Subtle Ambient Glow Background -->
  <div class="pointer-events-none absolute -top-32 right-1/4 w-96 h-96 bg-[#0284c7]/10 dark:bg-[#38bdf8]/10 rounded-full blur-3xl opacity-60"></div>
  <div class="pointer-events-none absolute -bottom-20 left-10 w-80 h-80 bg-[#0284c7]/5 dark:bg-[#38bdf8]/5 rounded-full blur-3xl opacity-40"></div>

  <!-- Center Content Grid (Vertically Centered in 100dvh) -->
  <div class="my-auto w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Editorial Headline & Actions (col-span-12 lg:col-span-7) -->
      <div class="lg:col-span-7 flex flex-col items-start">
        <!-- Display Headline with User's Name -->
        <h1 class="hero-reveal font-display text-4xl sm:text-5xl lg:text-[3.25rem] text-zinc-950 dark:text-white font-bold leading-[1.15] tracking-tight pb-1">
          I'm <span class="text-[#0284c7] dark:text-[#38bdf8]">Muhammad Syafi'ul Umam</span>
        </h1>

        <!-- Concise Portfolio Welcoming Copy -->
        <p class="hero-reveal mt-5 text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-[48ch]">
          Welcome to my personal portfolio. This is where I document my journey in tech, share my professional experiences, and showcase the skills and digital products I've built along the way.
        </p>

        <!-- Action Buttons -->
        <div class="hero-reveal mt-8 flex flex-wrap items-center gap-3.5">
          <a
            href="#projects"
            class="inline-flex items-center justify-center px-5 py-2.5 rounded-md bg-[#0284c7] hover:bg-[#0369a1] dark:bg-[#38bdf8] dark:hover:bg-[#7dd3fc] text-white dark:text-[#080808] font-semibold text-sm transition-all shadow-xs dark:shadow-[0_0_20px_rgba(56,189,248,0.25)] active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0284c7] dark:focus-visible:ring-[#38bdf8]"
          >
            Explore Works
          </a>

          <a
            href={personal.resumeUrl}
            download="Resume_Muhammad_Syafiul_Umam.pdf"
            aria-label="Download Resume (PDF)"
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-md bg-white dark:bg-[#121316] hover:bg-zinc-50 dark:hover:bg-[#1a1c22] text-zinc-900 dark:text-white border border-zinc-200 dark:border-white/10 text-sm font-medium transition-all shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0284c7] dark:focus-visible:ring-[#38bdf8]"
          >
            <svg class="w-4 h-4 text-[#0284c7] dark:text-[#38bdf8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>Download Resume</span>
          </a>

          <a
            href="#contact"
            class="group inline-flex items-center gap-1.5 px-3 py-2 text-zinc-600 dark:text-zinc-400 hover:text-[#0284c7] dark:hover:text-[#38bdf8] text-sm font-medium transition-colors"
          >
            <span>Get in touch</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Borderless Editorial Portrait (col-span-12 lg:col-span-5) -->
      <div class="hero-reveal lg:col-span-5 w-full flex items-center justify-center relative">
        <div class="relative flex items-end justify-center w-full max-w-[320px] sm:max-w-[380px] lg:max-w-[420px]">
          
          <!-- Soft Atmospheric Backlight Aura (No hard borders, pure organic illumination) -->
          <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-72 sm:w-96 h-72 sm:h-96 bg-gradient-to-tr from-[#0284c7]/20 via-sky-400/15 to-transparent dark:from-[#38bdf8]/20 dark:via-blue-600/15 dark:to-transparent rounded-full blur-3xl opacity-75"></div>
          
          <!-- Borderless Portrait with Smooth Bottom Dissolve -->
          <img
            src="/images/hero/umam-portrait.webp"
            alt="Muhammad Syafi'ul Umam - Software Developer & UI/UX Designer"
            loading="eager"
            fetchpriority="high"
            class="relative z-10 w-full max-h-[460px] sm:max-h-[500px] lg:max-h-[520px] object-contain object-bottom select-none transition-transform duration-500 hover:scale-[1.015] filter drop-shadow-[0_16px_32px_rgba(0,0,0,0.12)] dark:drop-shadow-[0_20px_40px_rgba(0,0,0,0.55)]"
            style="mask-image: linear-gradient(to bottom, black 76%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 76%, transparent 100%);"
          />
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom Scroll Cue Indicator -->
  <div class="hero-reveal w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-2 flex items-center justify-center text-xs text-zinc-500 dark:text-zinc-400 select-none">
    <a
      href="#about"
      class="group inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500 hover:text-[#0284c7] dark:hover:text-[#38bdf8] transition-colors"
      aria-label="Scroll to About section"
    >
      <span>Scroll down</span>
      <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-y-1 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>
