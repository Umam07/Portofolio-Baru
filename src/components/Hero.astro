---
import { portfolioData } from '../data/portfolioData';
import MascotHero from './MascotHero.astro';

const { personal } = portfolioData;
---

<section id="hero" class="pt-24 pb-16 md:pt-32 md:pb-24 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
    
    <!-- Left Column: Editorial Headline & Actions (col-span-7) -->
    <div class="lg:col-span-7 flex flex-col items-start">
      
      <!-- Category Badge Pill -->
      <div class="hero-reveal mb-5 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#efe9de] dark:bg-[#1c1b18] text-[#141413] dark:text-[#faf9f5] text-xs font-mono font-medium border border-[#e6dfd8] dark:border-[#2e2b26]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#cc785c]"></span>
        <span>{personal.name} · {personal.role}</span>
      </div>

      <!-- Serif Display Headline (Copernicus / Newsreader style, weight 400, negative tracking) -->
      <h1 class="hero-reveal font-display text-4xl sm:text-5xl lg:text-[56px] text-[#141413] dark:text-[#faf9f5] leading-[1.12] tracking-tight pb-1">
        Frontend Developer & UI/UX Designer
      </h1>

      <!-- Body Copy (Humanist sans, muted ink) -->
      <p class="hero-reveal mt-5 text-base sm:text-lg text-[#3d3d3a] dark:text-[#a09d96] leading-relaxed max-w-[48ch]">
        Building responsive, accessible, and structured web interfaces with modern frontend architecture (React, TypeScript, Tailwind CSS) and clean design systems.
      </p>

      <!-- Action Buttons (View Projects, Download Resume, Contact Me) -->
      <div class="hero-reveal mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#projects"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-md bg-[#cc785c] hover:bg-[#a9583e] active:scale-95 text-white font-medium text-sm transition-all shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-[#cc785c]"
        >
          View Projects
        </a>

        <a
          href={personal.resumeUrl}
          download="Resume_Muhammad_Syafiul_Umam.pdf"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-md bg-[#faf9f5] dark:bg-[#1c1b18] hover:bg-[#f5f0e8] dark:hover:bg-[#252320] text-[#141413] dark:text-[#faf9f5] border border-[#e6dfd8] dark:border-[#2e2b26] text-sm font-medium transition-all shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-[#cc785c]"
        >
          <svg class="w-4 h-4 text-[#cc785c]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
          <span>Download Resume</span>
        </a>

        <a
          href="#contact"
          class="inline-flex items-center justify-center px-4 py-2.5 rounded-md hover:bg-[#efe9de] dark:hover:bg-[#1c1b18] text-[#6c6a64] dark:text-[#a09d96] hover:text-[#141413] dark:hover:text-[#faf9f5] text-sm font-medium transition-all"
        >
          Contact Me
        </a>
      </div>

      <!-- Metric Stats Banner (Authentic data, zero fabricated numbers) -->
      <div class="hero-reveal mt-12 pt-8 border-t border-[#e6dfd8] dark:border-[#2e2b26] w-full grid grid-cols-2 sm:grid-cols-4 gap-4">
        {personal.stats.map((stat) => (
          <div class="flex flex-col">
            <span class="font-display text-xl sm:text-2xl text-[#141413] dark:text-[#faf9f5]">{stat.value}</span>
            <span class="text-xs text-[#6c6a64] dark:text-[#8e8b82] mt-0.5">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Right Column: Interactive Eye-Tracking Mascot (col-span-5) -->
    <div class="hero-reveal lg:col-span-5 w-full flex items-center justify-center">
      <MascotHero />
    </div>

  </div>
</section>
