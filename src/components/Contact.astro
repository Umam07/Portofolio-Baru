---
import { portfolioData } from '../data/portfolioData';

const { personal } = portfolioData;
---

<section id="contact" class="py-28 md:py-36 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto text-center relative">
  <div class="relative z-10 flex flex-col items-center">
    
    <!-- Editorial Headline matching the reference aesthetic -->
    <h2 class="font-display text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tight text-zinc-950 dark:text-white leading-[1.15] max-w-2xl">
      <span class="italic font-light text-zinc-400 dark:text-zinc-500">Achieve</span> Business Goals <br class="hidden sm:inline" />
      With Design & Logic
    </h2>

    <!-- Minimal Subtitle -->
    <p class="mt-5 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-md leading-relaxed">
      Open to full-time roles, software engineering projects, and design collaborations.
    </p>

    <!-- Central Contact Pill Button (Solid & Clean) -->
    <div class="mt-8 sm:mt-10">
      <a
        href={`mailto:${personal.email}`}
        class="inline-flex items-center justify-center px-8 py-3 rounded-full border border-zinc-900 dark:border-white/30 bg-zinc-950 hover:bg-zinc-800 text-white dark:bg-transparent dark:hover:bg-white dark:hover:text-zinc-950 dark:text-white text-sm font-medium tracking-tight transition-all duration-200 hover:scale-[1.03] active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 cursor-pointer"
      >
        Contact
      </a>
    </div>

    <!-- Secondary Channel Pills Row (Solid & Minimal) -->
    <div class="mt-10 sm:mt-12 flex flex-wrap items-center justify-center gap-2.5 sm:gap-3">
      
      <!-- LinkedIn Pill -->
      <a
        href="https://linkedin.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900 hover:bg-zinc-200 dark:hover:bg-zinc-800 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500"
      >
        <svg class="w-3.5 h-3.5 text-zinc-500 dark:text-zinc-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
        </svg>
        <span>LinkedIn</span>
      </a>

      <!-- GitHub Pill -->
      <a
        href="https://github.com/Umam07"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900 hover:bg-zinc-200 dark:hover:bg-zinc-800 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500"
      >
        <svg class="w-3.5 h-3.5 text-zinc-500 dark:text-zinc-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GitHub</span>
      </a>

      <!-- Resume Pill -->
      <a
        href={personal.resumeUrl}
        download="Resume_Muhammad_Syafiul_Umam.pdf"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900 hover:bg-zinc-200 dark:hover:bg-zinc-800 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500"
      >
        <svg class="w-3.5 h-3.5 text-zinc-500 dark:text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <span>Resume</span>
      </a>

      <!-- Direct Email Pill with 1-Click Copy & Mailto -->
      <button
        id="email-pill-btn"
        type="button"
        aria-label="Copy email address or open mail app"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900 hover:bg-zinc-200 dark:hover:bg-zinc-800 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white transition-all cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500"
      >
        <svg id="email-pill-icon" class="w-3.5 h-3.5 text-zinc-500 dark:text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
        <span id="email-pill-text">Email</span>
      </button>

    </div>

    <!-- Hidden Accessible Clipboard Source -->
    <span id="email-raw-address" class="sr-only">{personal.email}</span>

  </div>
</section>

<script>
  // 1-Click Copy on Email Pill with feedback
  const emailPillBtn = document.getElementById('email-pill-btn');
  const emailAddress = document.getElementById('email-raw-address')?.textContent?.trim() || '';
  const emailPillText = document.getElementById('email-pill-text');
  const emailPillIcon = document.getElementById('email-pill-icon');

  let resetTimeout: number | undefined;

  emailPillBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(emailAddress);
      if (emailPillText && emailPillIcon) {
        emailPillText.textContent = 'Copied!';
        emailPillIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>';

        if (resetTimeout) window.clearTimeout(resetTimeout);
        resetTimeout = window.setTimeout(() => {
          emailPillText.textContent = 'Email';
          emailPillIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>';
        }, 2500);
      }
    } catch {
      // Fallback to mailto if clipboard API unavailable
      window.location.href = `mailto:${emailAddress}`;
    }
  });
</script>


