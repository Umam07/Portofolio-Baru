---
import { portfolioData } from '../data/portfolioData';

const { personal } = portfolioData;
---

<section id="contact" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  
  <!-- Master CTA & Collaboration Showcase Container -->
  <div class="relative rounded-2xl md:rounded-3xl bg-[#181715] text-[#faf9f5] border border-[#252320] shadow-2xl overflow-hidden">
    
    <!-- Subtle Background Ambient Warm Glow -->
    <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-[#cc785c]/10 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 rounded-full bg-[#cc785c]/15 blur-3xl pointer-events-none"></div>

    <!-- Background Anthropic 4-Spoke Radial Watermark -->
    <div class="absolute right-6 -bottom-10 opacity-[0.03] pointer-events-none select-none">
      <svg class="w-96 h-96 text-white" viewBox="0 0 16 16" fill="currentColor">
        <path d="M7 0h2v6.586l4.657-4.657 1.414 1.414L10.414 8l4.657 4.657-1.414 1.414L9 9.414V16H7V9.414l-4.657 4.657-1.414-1.414L5.586 8 .929 3.343 2.343 1.93 7 6.586V0z"/>
      </svg>
    </div>

    <!-- Top Highlight Coral Banner (Claude Voltage Header) -->
    <div class="bg-[#cc785c] px-6 sm:px-10 py-4 flex flex-wrap items-center justify-between gap-4 border-b border-[#a9583e]">
      <div class="flex items-center gap-2.5 text-white text-xs sm:text-sm font-medium tracking-wide">
        <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
        <span class="font-sans font-semibold uppercase tracking-wider text-[11px] sm:text-xs">Direct Collaboration</span>
        <span class="text-white/60">·</span>
        <span class="text-white/95">{personal.status}</span>
      </div>

      <div class="hidden sm:flex items-center gap-2 text-xs font-mono text-white/90">
        <span>Response Time:</span>
        <span class="text-white font-semibold">&lt;24 hours</span>
      </div>
    </div>

    <!-- Main Grid Content -->
    <div class="p-6 sm:p-10 lg:p-14 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start relative z-10">
      
      <!-- Left Column: Editorial Value Proposition & Instant Channels (col-span-6) -->
      <div class="lg:col-span-6 flex flex-col justify-between h-full">
        <div>
          <!-- Serif Display Headline (Newsreader / Copernicus style 400) -->
          <h2 class="font-display text-3xl sm:text-4xl lg:text-[44px] text-[#faf9f5] leading-[1.12] tracking-tight">
            Let's build something remarkable together.
          </h2>

          <!-- Body Copy -->
          <p class="mt-5 text-sm sm:text-base text-[#a09d96] leading-relaxed max-w-[46ch]">
            Have an ambitious design token architecture, web application, or interaction-heavy interface to build? I bring Figma craft and frontend engineering into one seamless workflow.
          </p>

          <!-- Interactive 1-Click Copy Email Card -->
          <div class="mt-8 p-4 sm:p-5 rounded-xl bg-[#252320] border border-[#3d3d3a] flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-sm">
            <div class="flex flex-col">
              <span class="text-[11px] font-mono text-[#8e8b82] uppercase tracking-wider">Direct Inbox</span>
              <span id="email-text" class="text-sm sm:text-base font-semibold text-[#faf9f5] font-mono mt-0.5 select-all">
                {personal.email}
              </span>
            </div>

            <div class="flex items-center gap-2">
              <button
                id="copy-email-btn"
                type="button"
                aria-label="Copy email address to clipboard"
                class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-md bg-[#cc785c] hover:bg-[#a9583e] active:scale-95 text-white font-medium text-xs tracking-tight transition-all cursor-pointer shadow-xs"
              >
                <svg id="copy-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
                <span id="copy-text">Copy Email</span>
              </button>

              <a
                href={`mailto:${personal.email}`}
                class="inline-flex items-center justify-center p-2 rounded-md bg-[#1f1e1b] hover:bg-[#3d3d3a] text-[#faf9f5] border border-[#3d3d3a] transition-colors"
                title="Open in Mail Client"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- Location & Working Mode Indicator -->
          <div class="mt-6 flex flex-wrap items-center gap-4 text-xs font-mono text-[#a09d96]">
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#5db872]"></span>
              <span>{personal.location}</span>
            </div>
            <span>·</span>
            <span>Remote & Hybrid Available</span>
          </div>
        </div>

        <!-- Social Profiles Network Strip -->
        <div class="mt-10 pt-6 border-t border-[#252320]">
          <span class="text-xs font-mono text-[#8e8b82] uppercase tracking-wider block mb-3">Professional Profiles</span>
          <div class="flex flex-wrap gap-2">
            {personal.socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="px-3 py-1.5 rounded-md bg-[#252320] hover:bg-[#3d3d3a] border border-[#3d3d3a] text-xs font-medium text-[#faf9f5] transition-all hover:border-[#cc785c] active:scale-95"
              >
                {social.name} ↗
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: High-Craft Interactive Project Inquiry Form (col-span-6) -->
      <div class="lg:col-span-6 p-6 sm:p-8 rounded-xl bg-[#1f1e1b] border border-[#252320] shadow-xl relative">
        <div class="flex items-center justify-between pb-4 mb-5 border-b border-[#252320]">
          <div>
            <h3 class="font-display text-2xl text-[#faf9f5] tracking-tight">Initiate Inquiry</h3>
            <p class="text-xs text-[#a09d96] font-mono mt-0.5">Project scopes, proposals & consultations</p>
          </div>
          <span class="text-xs font-mono text-[#cc785c] px-2.5 py-1 rounded bg-[#252320] border border-[#3d3d3a]">
            Fast-Track
          </span>
        </div>

        <form id="contact-form" class="space-y-4">
          <!-- Name Field -->
          <div>
            <label for="name" class="block text-xs font-mono text-[#a09d96] mb-1.5">
              YOUR NAME <span class="text-[#cc785c]">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="e.g. Alex Rivera"
              class="w-full px-3.5 py-2.5 rounded-md bg-[#252320] border border-[#3d3d3a] text-sm text-[#faf9f5] placeholder-[#6c6a64] focus:outline-none focus:border-[#cc785c] focus:ring-1 focus:ring-[#cc785c] transition-colors"
            />
          </div>

          <!-- Email Field -->
          <div>
            <label for="email" class="block text-xs font-mono text-[#a09d96] mb-1.5">
              EMAIL ADDRESS <span class="text-[#cc785c]">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="e.g. alex@company.com"
              class="w-full px-3.5 py-2.5 rounded-md bg-[#252320] border border-[#3d3d3a] text-sm text-[#faf9f5] placeholder-[#6c6a64] focus:outline-none focus:border-[#cc785c] focus:ring-1 focus:ring-[#cc785c] transition-colors"
            />
          </div>

          <!-- Project Focus -->
          <div>
            <label for="project-type" class="block text-xs font-mono text-[#a09d96] mb-1.5">
              PRIMARY FOCUS
            </label>
            <select
              id="project-type"
              name="projectType"
              class="w-full px-3.5 py-2.5 rounded-md bg-[#252320] border border-[#3d3d3a] text-sm text-[#faf9f5] focus:outline-none focus:border-[#cc785c] focus:ring-1 focus:ring-[#cc785c] transition-colors"
            >
              <option value="Design System">Design System & Token Architecture</option>
              <option value="Web Application">Full Web Application (UI/UX + Frontend)</option>
              <option value="Website Redesign">Interactive Website Redesign</option>
              <option value="Consulting">Design Engineer Contract / Role</option>
            </select>
          </div>

          <!-- Message Field -->
          <div>
            <label for="message" class="block text-xs font-mono text-[#a09d96] mb-1.5">
              PROJECT OVERVIEW <span class="text-[#cc785c]">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="4"
              placeholder="Describe goals, scope, timeline, and deliverables..."
              class="w-full px-3.5 py-2.5 rounded-md bg-[#252320] border border-[#3d3d3a] text-sm text-[#faf9f5] placeholder-[#6c6a64] focus:outline-none focus:border-[#cc785c] focus:ring-1 focus:ring-[#cc785c] transition-colors resize-none"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 px-5 rounded-md bg-[#cc785c] hover:bg-[#a9583e] text-white font-medium text-sm active:scale-[0.98] transition-all flex items-center justify-center gap-2 cursor-pointer shadow-md font-sans tracking-tight"
          >
            <span>Send Project Inquiry</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </form>

        <!-- Dynamic Success Toast / Confirmation -->
        <div id="form-feedback" class="hidden mt-4 p-3.5 rounded-md bg-[#252320] border border-[#5db872] text-xs text-[#5db872] text-center font-mono animate-fade-in">
          ✓ Inquiry transmitted successfully. I will review and reply within 24 hours.
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // 1-Click Copy Email Logic
  const copyBtn = document.getElementById('copy-email-btn');
  const emailText = document.getElementById('email-text')?.textContent?.trim() || '';
  const copyText = document.getElementById('copy-text');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(emailText);
      if (copyText) {
        copyText.textContent = 'Copied!';
        setTimeout(() => {
          copyText.textContent = 'Copy Email';
        }, 2500);
      }
    } catch (err) {
      console.error('Failed to copy: ', err);
    }
  });

  // Contact Form Submission Simulation
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const formFeedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-btn');

  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (submitBtn) {
      submitBtn.innerHTML = '<span>Transmitting...</span>';
    }
    
    setTimeout(() => {
      if (formFeedback && submitBtn) {
        formFeedback.classList.remove('hidden');
        contactForm.reset();
        submitBtn.innerHTML = '<span>Message Transmitted!</span>';
        setTimeout(() => {
          submitBtn.innerHTML = `<span>Send Project Inquiry</span><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>`;
        }, 4000);
      }
    }, 600);
  });
</script>
