---
import { portfolioData } from '../data/portfolioData';

const { personal } = portfolioData;
---

<section id="contact" class="py-20 md:py-28 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  
  <!-- Claude Signature Full-Bleed Coral Pre-Footer Callout Band -->
  <div class="mb-10 p-8 sm:p-12 md:p-14 rounded-2xl bg-[#cc785c] text-white flex flex-col md:flex-row md:items-center justify-between gap-8 shadow-sm">
    <div class="max-w-xl">
      <h2 class="font-display text-3xl sm:text-4xl text-white tracking-tight leading-tight">
        Have a project in mind or want to collaborate?
      </h2>
      <p class="mt-3 text-white/90 text-sm sm:text-base leading-relaxed">
        Currently available for contract roles, design token architectures, and high-craft web applications.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <a
        href={`mailto:${personal.email}`}
        class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-[#faf9f5] hover:bg-[#f5f0e8] active:scale-95 text-[#141413] font-medium text-sm transition-all shadow-sm"
      >
        Email Directly
      </a>
      <a
        href="#inquiry-form"
        class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-[#a9583e] hover:bg-[#924b34] active:scale-95 text-white font-medium text-sm transition-all border border-white/20"
      >
        Fill Inquiry Form
      </a>
    </div>
  </div>

  <!-- Contact & Direct Inquiry Section -->
  <div id="inquiry-form" class="p-8 sm:p-12 rounded-2xl bg-[#efe9de] border border-[#e6dfd8]">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      
      <!-- Left Column: Copy & Direct Contact Info (col-span-6) -->
      <div class="lg:col-span-6 flex flex-col justify-between">
        <div>
          <h3 class="font-display text-3xl sm:text-4xl text-[#141413] tracking-tight leading-[1.15]">
            Let's build something remarkable together.
          </h3>

          <p class="mt-4 text-base text-[#3d3d3a] leading-relaxed max-w-[44ch]">
            Looking for a Design Engineer to bridge Figma tokens and frontend architecture, or want to collaborate on a new product? My inbox is open.
          </p>

          <!-- Click-to-Copy Email Box -->
          <div class="mt-8 p-4 rounded-lg bg-[#faf9f5] border border-[#e6dfd8] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex flex-col">
              <span class="text-[11px] font-mono text-[#8e8b82] uppercase">Direct Email</span>
              <span id="email-text" class="text-sm sm:text-base font-semibold text-[#141413] font-mono">{personal.email}</span>
            </div>

            <button
              id="copy-email-btn"
              type="button"
              class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-md bg-[#cc785c] hover:bg-[#a9583e] text-white font-medium text-xs transition-all active:scale-95 cursor-pointer shadow-xs"
            >
              <svg id="copy-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              <span id="copy-text">Copy Email</span>
            </button>
          </div>

          <div class="mt-6 flex flex-wrap gap-4 text-xs font-mono text-[#6c6a64]">
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#5db872] animate-pulse"></span>
              <span>{personal.location}</span>
            </div>
            <span>|</span>
            <span>{personal.status}</span>
          </div>
        </div>

        <!-- Social Media Links -->
        <div class="mt-8 pt-6 border-t border-[#e6dfd8] flex flex-wrap items-center gap-2">
          <span class="text-xs font-mono text-[#8e8b82] mr-2">PROFILES:</span>
          {personal.socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="px-2.5 py-1 rounded bg-[#faf9f5] hover:bg-[#f5f0e8] border border-[#e6dfd8] text-xs font-medium text-[#3d3d3a] hover:text-[#141413] transition-colors"
            >
              {social.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Right Column: Claude Dark Form Card (col-span-6) -->
      <div class="lg:col-span-6 p-6 sm:p-8 rounded-xl bg-[#181715] text-[#faf9f5] border border-[#252320]">
        <h4 class="font-display text-2xl text-[#faf9f5] tracking-tight mb-1">Send an Inquiry</h4>
        <p class="text-xs text-[#a09d96] mb-6 font-mono">Typically responds within 24 hours.</p>

        <form id="contact-form" class="space-y-4">
          <div>
            <label for="name" class="block text-xs font-mono text-[#a09d96] mb-1.5">YOUR NAME *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Alex Rivera"
              class="w-full px-3.5 py-2.5 rounded-md bg-[#252320] border border-[#3d3d3a] text-sm text-[#faf9f5] placeholder-[#6c6a64] focus:outline-none focus:border-[#cc785c] focus:ring-1 focus:ring-[#cc785c] transition-colors"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-mono text-[#a09d96] mb-1.5">EMAIL ADDRESS *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="alex@company.com"
              class="w-full px-3.5 py-2.5 rounded-md bg-[#252320] border border-[#3d3d3a] text-sm text-[#faf9f5] placeholder-[#6c6a64] focus:outline-none focus:border-[#cc785c] focus:ring-1 focus:ring-[#cc785c] transition-colors"
            />
          </div>

          <div>
            <label for="project-type" class="block text-xs font-mono text-[#a09d96] mb-1.5">PROJECT TYPE</label>
            <select
              id="project-type"
              name="projectType"
              class="w-full px-3.5 py-2.5 rounded-md bg-[#252320] border border-[#3d3d3a] text-sm text-[#faf9f5] focus:outline-none focus:border-[#cc785c] focus:ring-1 focus:ring-[#cc785c] transition-colors"
            >
              <option value="Design System">Design System & Token Architecture</option>
              <option value="Web Application">Full Web Application (UI/UX + Code)</option>
              <option value="Website Redesign">Interactive Website Redesign</option>
              <option value="Consulting">Contract / Full-time Role</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-xs font-mono text-[#a09d96] mb-1.5">PROJECT DETAILS *</label>
            <textarea
              id="message"
              name="message"
              required
              rows="4"
              placeholder="Tell me about your project, goals, and timeline..."
              class="w-full px-3.5 py-2.5 rounded-md bg-[#252320] border border-[#3d3d3a] text-sm text-[#faf9f5] placeholder-[#6c6a64] focus:outline-none focus:border-[#cc785c] focus:ring-1 focus:ring-[#cc785c] transition-colors resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-2.5 px-5 rounded-md bg-[#cc785c] hover:bg-[#a9583e] text-white font-medium text-sm active:scale-[0.98] transition-all flex items-center justify-center gap-2 cursor-pointer shadow-xs"
          >
            <span>Send Message</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </form>

        <div id="form-feedback" class="hidden mt-4 p-3 rounded-md bg-[#252320] border border-[#5db872]/50 text-xs text-[#5db872] text-center font-mono">
          ✓ Message sent successfully! I will reply shortly.
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const emailText = document.getElementById('email-text')?.textContent || '';
  const copyText = document.getElementById('copy-text');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(emailText);
      if (copyText) {
        copyText.textContent = 'Copied!';
        setTimeout(() => {
          copyText.textContent = 'Copy Email';
        }, 2500);
      }
    } catch (err) {
      console.error('Failed to copy: ', err);
    }
  });

  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const formFeedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-btn');

  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (submitBtn) {
      submitBtn.innerHTML = '<span>Sending...</span>';
    }
    
    setTimeout(() => {
      if (formFeedback && submitBtn) {
        formFeedback.classList.remove('hidden');
        contactForm.reset();
        submitBtn.innerHTML = '<span>Message Sent!</span>';
        setTimeout(() => {
          submitBtn.innerHTML = `<span>Send Message</span><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>`;
        }, 3000);
      }
    }, 600);
  });
</script>
