---
import { portfolioData } from '../data/portfolioData';

const { personal } = portfolioData;
---

<section id="contact" class="relative mx-auto max-w-5xl px-4 py-24 sm:px-6 md:py-32 lg:px-8">
  <div class="border-y border-[#B9D4F5] py-10 sm:py-14">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-[#123A86]">Contact</p>
        <h2 class="mt-5 max-w-xl font-display text-4xl font-semibold leading-[1.03] tracking-[-0.04em] text-[#0E1B3D] sm:text-5xl md:text-6xl">
          Let’s talk about the work.
        </h2>

        <div class="mt-10 flex flex-col items-start gap-4">
          <a
            href={`mailto:${personal.email}`}
            class="group inline-flex min-h-11 max-w-full items-center gap-3 border-b border-[#B9D4F5] pb-2 text-base font-medium text-[#0E1B3D] transition-colors hover:border-[#1F5FD6] hover:text-[#123A86] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6]"
          >
            <span class="truncate">{personal.email}</span>
            <span class="text-[#123A86] transition-transform group-hover:translate-x-0.5" aria-hidden="true">↗</span>
          </a>
          <button
            id="email-pill-btn"
            type="button"
            aria-label="Copy email address"
            class="inline-flex min-h-11 items-center gap-2 text-sm text-[#2F4166] transition-colors hover:text-[#0E1B3D] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#1F5FD6]"
          >
            <svg id="email-pill-icon" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 8h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2Z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h0"></path>
            </svg>
            <span id="email-pill-text">Copy email address</span>
          </button>
        </div>
        <span id="email-raw-address" class="sr-only">{personal.email}</span>
      </div>

      <div class="lg:border-l lg:border-[#B9D4F5] lg:pl-10">
        <p class="font-mono text-xs uppercase tracking-[0.18em] text-[#2F4166]">Find me online</p>
        <nav class="mt-5 divide-y divide-[#B9D4F5] border-y border-[#B9D4F5]" aria-label="Contact links">
          {personal.socials.filter((social) => ['LinkedIn', 'GitHub'].includes(social.name)).map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex min-h-14 items-center justify-between text-sm text-[#24365C] transition-colors hover:text-[#123A86] focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#1F5FD6]"
            >
              <span>{social.name}</span>
              <span class="text-[#2F4166] transition-transform group-hover:translate-x-0.5" aria-hidden="true">↗</span>
            </a>
          ))}
          <a
            href={personal.resumeUrl}
            download="Muhammad Syafi'ul Umam_CV.pdf"
            class="group flex min-h-14 items-center justify-between text-sm text-[#24365C] transition-colors hover:text-[#123A86] focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#1F5FD6]"
          >
            <span>Download resume</span>
            <span class="text-[#2F4166] transition-transform group-hover:translate-x-0.5" aria-hidden="true">↓</span>
          </a>
        </nav>
      </div>
    </div>
  </div>
</section>

<script>
  const emailPillBtn = document.getElementById('email-pill-btn');
  const emailAddress = document.getElementById('email-raw-address')?.textContent?.trim() || '';
  const emailPillText = document.getElementById('email-pill-text');
  const emailPillIcon = document.getElementById('email-pill-icon');
  let resetTimeout: number | undefined;

  emailPillBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(emailAddress);
      if (!emailPillText || !emailPillIcon) return;

      emailPillText.textContent = 'Copied';
      emailPillIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m5 12 4 4L19 6"></path>';

      if (resetTimeout) window.clearTimeout(resetTimeout);
      resetTimeout = window.setTimeout(() => {
        emailPillText.textContent = 'Copy email';
        emailPillIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 8h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2Z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h0"></path>';
      }, 2500);
    } catch {
      window.location.href = `mailto:${emailAddress}`;
    }
  });
</script>
